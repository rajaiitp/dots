@@ -1,6 +1,86 @@
 use super::*;
 
 impl App {
+    /// Poll the open local commit selector and refresh it from the repository's
+    /// current HEAD when needed. This makes the selector follow branch changes
+    /// or new commits made by another tool without requiring the user to quit
+    /// and reopen tuicr.
+    pub fn poll_commit_selector_refresh(&mut self) -> bool {
+        if self.input_mode != InputMode::CommitSelect || self.target_tab != TargetTab::Local {
+            return false;
+        }
+
+        let now = Instant::now();
+        if now < self.next_commit_selector_refresh_at {
+            return false;
+        }
+        self.next_commit_selector_refresh_at =
+            now + Duration::from_millis(DEFAULT_COMMIT_SELECTOR_REFRESH_MS);
+
+        let highlighter = self.theme.syntax_highlighter();
+        let change_status = match Self::get_change_status_with_ignore(
+            self.vcs.as_ref(),
+            &self.vcs_info.root_path,
+            highlighter,
+            self.path_filter.as_deref(),
+        ) {
+            Ok(status) => status,
+            Err(_) => return false,
+        };
+
+        let commit_limit = self
+            .commit_list
+            .iter()
+            .filter(|commit| !Self::is_special_commit(commit))
+            .count()
+            .max(VISIBLE_COMMIT_COUNT);
+        let commits = match self.vcs.get_recent_commits(0, commit_limit) {
+            Ok(commits) => commits,
+            Err(_) => return false,
+        };
+
+        let mut refreshed = commits.clone();
+        if change_status.staged {
+            refreshed.insert(0, Self::staged_commit_entry());
+        }
+        if change_status.unstaged {
+            refreshed.insert(0, Self::unstaged_commit_entry());
+        }
+
+        let same_commits = self.commit_list.len() == refreshed.len()
+            && self
+                .commit_list
+                .iter()
+                .zip(refreshed.iter())
+                .all(|(left, right)| left.id == right.id);
+        if same_commits {
+            return false;
+        }
+
+        let previous_id = self
+            .commit_list
+            .get(self.commit_list_cursor)
+            .map(|commit| commit.id.clone());
+
+        self.commit_list = refreshed;
+        self.visible_commit_count = self.commit_list.len();
+        self.has_more_commit = commits.len() >= commit_limit;
+        self.commit_selection_range = None;
+
+        self.commit_list_cursor = previous_id
+            .and_then(|id| self.commit_list.iter().position(|commit| commit.id == id))
+            .unwrap_or_else(|| {
+                self.commit_list_cursor
+                    .min(self.commit_list.len().saturating_sub(1))
+            });
+        self.commit_list_scroll_offset = self
+            .commit_list_scroll_offset
+            .min(self.commit_list.len().saturating_sub(1));
+
+        self.set_message("Commit selector refreshed from current HEAD".to_string());
+        true
+    }
+
     pub(in crate::app) fn is_strict_commit_selection(
