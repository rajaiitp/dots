#!/data/data/com.termux/files/usr/bin/sh
# Keep key-only SSH reachable on localhost, Wi-Fi, and VPN interfaces.

set -eu
PREFIX=/data/data/com.termux/files/usr
HOME=/data/data/com.termux/files/home
PATH=$PREFIX/bin:/system/bin:/system/xbin
CONF_DIR=$PREFIX/etc/ssh/sshd_config.d
CONF=$CONF_DIR/10-tablet.conf
AUTHORIZED_KEYS=$HOME/.ssh/authorized_keys
export HOME PATH PREFIX

# Always-reachable mode intentionally holds a partial wake lock. The user chose
# remote reliability over the lower-power behavior of a suspendable sshd.
termux-wake-lock
mkdir -p "$CONF_DIR"

if [ -s "$AUTHORIZED_KEYS" ]; then
  listen_address=0.0.0.0
else
  # Never expose password-capable SSH if the key file was lost.
  listen_address=127.0.0.1
fi

cat > "$CONF.new" <<EOF
AddressFamily inet
ListenAddress $listen_address
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes
UseDNS no
X11Forwarding no
MaxAuthTries 3
LoginGraceTime 30
EOF
mv -f "$CONF.new" "$CONF"
chmod 600 "$CONF"

# Remove the obsolete address-specific file from the previous boot setup.
rm -f "$CONF_DIR/10-local-lan.conf"

"$PREFIX/bin/sshd" -t
pkill -x sshd 2>/dev/null || true
sleep 1

# Foreground mode keeps Termux:Boot's foreground service tied to the daemon.
exec "$PREFIX/bin/sshd" -D -e
