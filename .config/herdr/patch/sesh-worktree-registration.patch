+func (c *CLIClient) WorktreeOpen(ctx context.Context, r WorktreeOpenRequest) (WorktreeOpenResult, error) {
+	args := []string{"worktree", "open", "--cwd", r.CWD, "--path", r.Path, "--label", r.Label}
+	if !r.Focus {
+		args = append(args, "--no-focus")
+	}
+	out, err := c.run(ctx, args...)
+	if err != nil {
+		return WorktreeOpenResult{}, err
+	}
+	raw, _, err := responseJSON(out, "worktree open")
+	if err != nil {
+		return WorktreeOpenResult{}, err
+	}
+	var result struct {
+		Workspace   Workspace `json:"workspace"`
+		RootPane    Pane      `json:"root_pane"`
+		AlreadyOpen bool      `json:"already_open"`
+	}
+	if err := json.Unmarshal(raw, &result); err != nil {
+		return WorktreeOpenResult{}, fmt.Errorf("decode herdr worktree open JSON: %w", err)
+	}
+	if result.Workspace.ID == "" {
+		return WorktreeOpenResult{}, errors.New("herdr worktree open returned no workspace")
+	}
+	return WorktreeOpenResult{
+		Workspace:   result.Workspace,
+		RootPane:    result.RootPane,
+		AlreadyOpen: result.AlreadyOpen,
+	}, nil
+}
