+++ b/src/ui/bottom_bar.rs
@@ -0,0 +1,204 @@
+use ratatui::{
+    Frame,
+    layout::{Alignment, Rect},
+    style::{Modifier, Style},
+    text::{Line, Span},
+    widgets::Paragraph,
+};
+
+use super::sidebar::{AgentPanelEntry, agent_panel_entries_from, render_bottom_bar_workspace};
+use super::status::state_icon;
+use super::text::{display_width_u16, truncate_end};
+use super::widgets::panel_contrast_fg;
+use crate::app::AppState;
+use crate::terminal::TerminalRuntimeRegistry;
+
+const TOP_WORKSPACE_WIDTH: u16 = 40;
+const MENU_WIDTH: u16 = 6;
+const CENTER_GAP: u16 = 1;
+const AGENT_TAB_GAP: u16 = 1;
+
+/// Keep the bottom status bar to a single compact row.
+pub(super) fn bottom_bar_height(
+    _app: &AppState,
+    _terminal_runtimes: &TerminalRuntimeRegistry,
+) -> u16 {
+    1
+}
+
+pub(super) fn top_workspace_rect(area: Rect) -> Rect {
+    if area.width == 0 || area.height == 0 {
+        return Rect::default();
+    }
+
+    let width = TOP_WORKSPACE_WIDTH
+        .min(area.width.saturating_sub(10).max(1))
+        .max(1);
+    Rect::new(
+        area.x + area.width.saturating_sub(width),
+        area.y,
+        width,
+        1.min(area.height),
+    )
+}
+
+/// Reserve the top-right workspace button from the tab strip.
+pub(super) fn tab_bar_content_area(area: Rect, workspace_area: Rect) -> Rect {
+    if workspace_area.width == 0 || area.width <= workspace_area.width + CENTER_GAP {
+        return Rect::new(area.x, area.y, 0, area.height);
+    }
+    Rect::new(
+        area.x,
+        area.y,
+        area.width
+            .saturating_sub(workspace_area.width)
+            .saturating_sub(CENTER_GAP),
+        area.height,
+    )
+}
+
+fn agent_button_label(entry: &AgentPanelEntry) -> String {
+    match entry
+        .primary_tab_label
+        .as_deref()
+        .or(entry.pane_label.as_deref())
+    {
+        Some(tab) if !tab.is_empty() => format!("{} · {tab}", entry.primary_label),
+        _ => entry.primary_label.clone(),
+    }
+}
+
+fn agent_button_widths(entries: &[AgentPanelEntry], available: u16) -> Vec<u16> {
+    if entries.is_empty() || available == 0 {
+        return Vec::new();
+    }
+
+    let mut widths = entries
+        .iter()
+        .map(|entry| display_width_u16(&agent_button_label(entry)).saturating_add(4))
+        .collect::<Vec<_>>();
+    let gaps = AGENT_TAB_GAP.saturating_mul(widths.len().saturating_sub(1) as u16);
+    let total = widths.iter().copied().sum::<u16>().saturating_add(gaps);
+    if total <= available {
+        return widths;
+    }
+
+    let visible = entries.len().min(available as usize);
+    let tab_available =
+        available.saturating_sub(AGENT_TAB_GAP.saturating_mul(visible.saturating_sub(1) as u16));
+    let base = tab_available / visible as u16;
+    let remainder = tab_available % visible as u16;
+    widths.truncate(visible);
+    widths.iter_mut().enumerate().for_each(|(index, width)| {
+        *width = base + if index < remainder as usize { 1 } else { 0 };
+    });
+    widths
+}
+
+/// Lay out compact full-context agent tabs on the left and the global menu on
+/// the far right. The center and workspace slot remain empty in the bottom bar.
+pub(super) fn bottom_bar_layout(
+    app: &AppState,
+    terminal_runtimes: &TerminalRuntimeRegistry,
+    area: Rect,
+) -> (Rect, Rect, Rect, Vec<Rect>) {
+    if area.width == 0 || area.height == 0 {
+        return (
+            Rect::default(),
+            Rect::default(),
+            Rect::default(),
+            Vec::new(),
+        );
+    }
+
+    let menu_width = MENU_WIDTH.min(area.width);
+    let content = Rect::new(
+        area.x,
+        area.y,
+        area.width.saturating_sub(menu_width),
+        area.height,
+    );
+    let menu_area = Rect::new(
+        area.x + area.width.saturating_sub(menu_width),
+        area.y,
+        menu_width,
+        area.height,
+    );
+    let entries = agent_panel_entries_from(app, terminal_runtimes);
+    let widths = agent_button_widths(&entries, content.width);
+    let mut hit_areas = Vec::with_capacity(widths.len());
+    let mut x = content.x;
+    for (index, width) in widths.into_iter().enumerate() {
+        hit_areas.push(Rect::new(x, content.y, width, content.height));
+        if index + 1 < entries.len() {
+            x = x.saturating_add(width.saturating_add(AGENT_TAB_GAP));
+        }
+    }
+
+    (content, Rect::default(), menu_area, hit_areas)
+}
+
+pub(super) fn render_top_workspace(
+    app: &AppState,
+    terminal_runtimes: &TerminalRuntimeRegistry,
+    frame: &mut Frame,
+    area: Rect,
+) {
+    render_bottom_bar_workspace(app, terminal_runtimes, frame, area);
+}
+
+pub(super) fn render_bottom_bar(
+    app: &AppState,
+    terminal_runtimes: &TerminalRuntimeRegistry,
+    frame: &mut Frame,
+    area: Rect,
+) {
+    if area.width == 0 || area.height == 0 {
+        return;
+    }
+
+    let p = &app.palette;
+    let base = Style::default().bg(p.panel_bg);
+    frame.buffer_mut().set_style(area, base);
+
+    let (_, _, menu_area, hit_areas) = bottom_bar_layout(app, terminal_runtimes, area);
+    let entries = agent_panel_entries_from(app, terminal_runtimes);
+    for (entry, button_area) in entries.iter().zip(hit_areas.iter().copied()) {
+        let active = app.is_active_pane(entry.ws_idx, entry.tab_idx, entry.pane_id);
+        let (status_icon, status_style) =
+            state_icon(entry.state, entry.seen, app.status_indicators, p);
+        let tab_style = if active {
+            let base = Style::default().fg(panel_contrast_fg(p)).bg(p.accent);
+            base.add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(p.overlay1).bg(p.surface0)
+        };
+        let status_style = if active {
+            tab_style
+        } else {
+            status_style.bg(p.surface0)
+        };
+        let max_label_width = button_area.width.saturating_sub(4) as usize;
+        let label = truncate_end(&agent_button_label(entry), max_label_width);
+        let line = Line::from(vec![
+            Span::raw(" "),
+            Span::styled(status_icon, status_style),
+            Span::raw(" "),
+            Span::styled(label, tab_style),
+            Span::raw(" "),
+        ]);
+        frame.render_widget(
+            Paragraph::new(line)
+                .style(tab_style)
+                .alignment(Alignment::Center),
+            button_area,
+        );
+    }
+
+    frame.render_widget(
+        Paragraph::new("menu")
+            .style(Style::default().fg(p.overlay0).bg(p.panel_bg))
+            .alignment(Alignment::Right),
+        menu_area,
+    );
+}
