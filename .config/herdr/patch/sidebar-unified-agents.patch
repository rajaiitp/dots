+fn repository_mouse(rect: Rect, kind: MouseEventKind, modifiers: KeyModifiers) -> RawInputEvent {
+    RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind,
+        column: rect.x.saturating_add(1),
+        row: rect.y,
+        modifiers,
+    })
+}
