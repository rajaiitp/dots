+#[test]
+fn repository_double_click_restores_initial_collapse_and_revalidates_membership() {
+    let mut collapsed = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    collapsed.set_snapshot(Box::new(repository_drilldown_snapshot(0, false)));
+    collapsed.set_pane_surface(surface());
+    collapsed.collapsed_groups.insert("repo".into());
+    collapsed.compose(106, 20).expect("collapsed repository");
+    let repository = collapsed.hits.repositories[0].rect;
+    collapsed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(!collapsed.collapsed_groups.contains("repo"));
+    collapsed.compose(106, 20).expect("expanded first click");
+    collapsed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    collapsed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(collapsed.repository_drilldown.is_some());
+    assert!(collapsed.collapsed_groups.contains("repo"));
+
+    let mut changed = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    changed.set_snapshot(Box::new(repository_drilldown_snapshot(0, false)));
+    changed.set_pane_surface(surface());
+    changed
+        .compose(106, 20)
+        .expect("multi-workspace repository");
+    let repository = changed.hits.repositories[0].rect;
+    changed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(changed.collapsed_groups.contains("repo"));
+    changed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    let mut single = repository_drilldown_snapshot(0, false);
+    single.revision = 2;
+    single
+        .workspaces
+        .retain(|workspace| workspace.workspace_id == "ws_1");
+    changed.set_snapshot(Box::new(single));
+    changed.set_pane_surface(PaneSurfaceFrame {
+        projection_revision: 2,
+        ..surface()
+    });
+    changed
+        .compose(106, 20)
+        .expect("single-workspace repository");
+    changed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(changed.repository_drilldown.is_some());
+    assert!(!changed.collapsed_groups.contains("repo"));
+}
