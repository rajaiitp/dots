+        entry: WorkspaceEntry,
+        status: crate::api::schema::AgentStatus,
+        rows: Vec<Vec<crate::ui::ResolvedToken>>,
+        indent: usize,
+        repository_child: bool,
+    },
+    Agent {
+        endpoint_index: usize,
+        row: super::agent_sidebar::AgentRow,
+        parent_last: Option<bool>,
+        last_child: bool,
+        stale: bool,
+        active_workspace: bool,
+    },
+    Tool {
+        endpoint_index: usize,
+        pane_id: String,
+        label: &'static str,
+        focused: bool,
+        parent_last: Option<bool>,
+        last_child: bool,
+        stale: bool,
+        active_workspace: bool,
+    },
+}
+
+impl SidebarTreeRow {
+    pub(super) fn height(&self) -> u16 {
+        match &self.kind {
+            SidebarTreeRowKind::Spacer
+            | SidebarTreeRowKind::Back
+            | SidebarTreeRowKind::Endpoint { .. }
+            | SidebarTreeRowKind::Project { .. } => 1,
+            SidebarTreeRowKind::Workspace { rows, .. } => {
+                rows.len().max(1).min(u16::MAX as usize) as u16
+            }
+            SidebarTreeRowKind::Agent { row, .. } => {
+                row.rows.len().max(1).min(u16::MAX as usize) as u16
+            }
+            SidebarTreeRowKind::Tool { .. } => 1,
+        }
+    }
+}
+
+pub(super) fn rows(
+    endpoints: &[ClientShellEndpoint],
+    active_endpoint_id: &ClientEndpointId,
+    collapsed_endpoints: &HashSet<ClientEndpointId>,
+    collapsed_groups: &HashSet<String>,
+    remote_collapsed_groups: &HashMap<ClientEndpointId, HashSet<String>>,
+    last_project_workspaces: &HashMap<(ClientEndpointId, String), String>,
+    repository_drilldown: Option<&ClientRepositoryDrilldown>,
+    config: &ClientShellConfig,
+    include_endpoints: bool,
+) -> Vec<SidebarTreeRow> {
+    let mut agents_by_workspace = HashMap::<(usize, String), Vec<String>>::new();
+    for aggregate in super::aggregate_navigation::aggregate_agent_rows(
+        endpoints,
+        active_endpoint_id,
+        config.agent_panel_sort,
+    ) {
+        agents_by_workspace
+            .entry((
+                aggregate.endpoint.endpoint_index,
+                aggregate.agent.workspace_id.clone(),
+            ))
+            .or_default()
+            .push(aggregate.agent.pane_id.clone());
+    }
+
+    let empty_collapsed_groups = HashSet::new();
+    let mut result = Vec::new();
+    if repository_drilldown.is_some() {
+        result.push(SidebarTreeRow {
+            kind: SidebarTreeRowKind::Back,
+        });
+    }
+    for (endpoint_index, endpoint) in endpoints.iter().enumerate() {
+        if repository_drilldown
+            .is_some_and(|drilldown| drilldown.endpoint_id != endpoint.endpoint_id)
+        {
+            continue;
+        }
+        if include_endpoints {
+            result.push(SidebarTreeRow {
+                kind: SidebarTreeRowKind::Endpoint { endpoint_index },
+            });
+            if collapsed_endpoints.contains(&endpoint.endpoint_id) {
+                continue;
+            }
+        }
+        let Some(snapshot) = endpoint.snapshot.as_deref() else {
+            continue;
+        };
+        let endpoint_collapsed_groups = if repository_drilldown.is_some() {
+            &empty_collapsed_groups
+        } else if endpoint.endpoint_id.is_local() {
+            collapsed_groups
+        } else {
+            remote_collapsed_groups
+                .get(&endpoint.endpoint_id)
+                .unwrap_or(&empty_collapsed_groups)
+        };
+        let entries = super::render::workspace_entries(snapshot, &empty_collapsed_groups)
+            .into_iter()
+            .filter(|entry| {
+                !endpoint.endpoint_id.is_local()
+                    || snapshot
+                        .workspaces
+                        .get(entry.index)
+                        .is_none_or(|workspace| {
+                            workspace.label != super::actions::TODO_WORKSPACE_LABEL
+                        })
+            })
+            .collect();
+        let (projects, ungrouped_entries) = project_groups(
+            snapshot,
+            entries,
+            endpoint_collapsed_groups,
+            last_project_workspaces,
+            &endpoint.endpoint_id,
+        );
+        let mut has_context = false;
+        for mut project in projects {
+            if repository_drilldown.is_some_and(|drilldown| drilldown.key != project.key) {
+                continue;
+            }
+            if repository_drilldown.is_some() {
+                project.collapsible = false;
+                project.collapsed = false;
+            }
+            append_context_spacer(&mut result, has_context);
+            result.push(SidebarTreeRow {
+                kind: SidebarTreeRowKind::Project {
+                    endpoint_index,
+                    key: project.key,
+                    label: project.label,
+                    worktree: project.worktree,
+                    status: project.status,
+                    collapsible: project.collapsible,
+                    collapsed: project.collapsed,
+                },
+            });
+            append_workspace_rows(
+                &mut result,
+                &mut agents_by_workspace,
+                endpoint_index,
+                endpoint,
+                snapshot,
+                endpoint_collapsed_groups,
+                active_endpoint_id,
+                config,
+                include_endpoints,
+                project.entries,
+                true,
+            );
+            has_context = true;
+        }
+        if repository_drilldown.is_some() {
+            continue;
+        }
+        for entry in ungrouped_entries {
+            append_context_spacer(&mut result, has_context);
+            append_workspace_rows(
+                &mut result,
+                &mut agents_by_workspace,
+                endpoint_index,
+                endpoint,
+                snapshot,
+                endpoint_collapsed_groups,
+                active_endpoint_id,
+                config,
+                include_endpoints,
+                vec![entry],
+                false,
+            );
+            has_context = true;
+        }
+    }
+    result
+}
+
+fn append_context_spacer(result: &mut Vec<SidebarTreeRow>, needed: bool) {
+    if needed {
+        result.push(SidebarTreeRow {
+            kind: SidebarTreeRowKind::Spacer,
+        });
+    }
+}
+
+struct ProjectGroup {
+    key: String,
+    label: String,
+    entries: Vec<WorkspaceEntry>,
+    worktree: bool,
+    status: crate::api::schema::AgentStatus,
+    collapsible: bool,
+    collapsed: bool,
+}
+
+fn project_groups(
+    snapshot: &ClientShellSnapshot,
+    entries: Vec<WorkspaceEntry>,
+    collapsed_groups: &HashSet<String>,
+    last_project_workspaces: &HashMap<(ClientEndpointId, String), String>,
+    endpoint_id: &ClientEndpointId,
+) -> (Vec<ProjectGroup>, Vec<WorkspaceEntry>) {
+    let mut projects = Vec::<ProjectGroup>::new();
+    let mut ungrouped_entries = Vec::new();
+    for entry in entries {
+        let Some(workspace) = snapshot.workspaces.get(entry.index) else {
+            continue;
+        };
+        let (key, label, worktree) = if let Some(worktree) = &workspace.worktree {
+            (worktree.key.clone(), worktree.label.clone(), true)
+        } else if workspace.branch.is_some() {
+            (
+                workspace.workspace_id.clone(),
+                workspace.label.clone(),
+                false,
+            )
+        } else {
+            ungrouped_entries.push(entry);
+            continue;
+        };
+        if let Some(project) = projects.iter_mut().find(|project| project.key == key) {
+            project.entries.push(entry);
+        } else {
+            projects.push(ProjectGroup {
+                key,
+                label,
+                entries: vec![entry],
+                worktree,
+                status: workspace.agent_status,
+                collapsible: false,
+                collapsed: false,
+            });
+        }
+    }
+    for project in &mut projects {
+        if !project.worktree {
+            continue;
+        }
+        let key = project.key.clone();
+        let members = snapshot.workspaces.iter().filter(|workspace| {
+            workspace
+                .worktree
+                .as_ref()
+                .is_some_and(|worktree| worktree.key == key)
+        });
+        project.collapsible = members.clone().count() >= 2
+            && members.clone().any(|workspace| {
+                workspace
+                    .worktree
+                    .as_ref()
+                    .is_some_and(|worktree| !worktree.is_linked_worktree)
+            });
+        project.collapsed = project.collapsible && collapsed_groups.contains(&project.key);
+        if project.collapsed {
+            project.status = members
+                .map(|workspace| workspace.agent_status)
+                .max_by_key(|status| status_priority(*status))
+                .unwrap_or(project.status);
+            let retained_workspace_id = last_project_workspaces
+                .get(&(endpoint_id.clone(), project.key.clone()))
+                .filter(|workspace_id| {
+                    project.entries.iter().any(|entry| {
+                        snapshot
+                            .workspaces
+                            .get(entry.index)
+                            .is_some_and(|workspace| &workspace.workspace_id == *workspace_id)
+                    })
+                })
+                .cloned()
+                .or_else(|| {
+                    project.entries.iter().find_map(|entry| {
+                        snapshot
+                            .workspaces
+                            .get(entry.index)
+                            .filter(|workspace| workspace.focused)
+                            .map(|workspace| workspace.workspace_id.clone())
+                    })
+                })
+                .or_else(|| {
+                    project.entries.first().and_then(|entry| {
+                        snapshot
+                            .workspaces
+                            .get(entry.index)
+                            .map(|workspace| workspace.workspace_id.clone())
+                    })
+                });
+            project.entries.retain(|entry| {
+                snapshot
+                    .workspaces
+                    .get(entry.index)
+                    .is_some_and(|workspace| {
+                        retained_workspace_id.as_ref() == Some(&workspace.workspace_id)
+                    })
+            });
+            if let Some(entry) = project.entries.first_mut() {
+                entry.last_child = true;
+            }
+        }
+    }
+    for project in &mut projects {
+        let entry_count = project.entries.len();
+        for (index, entry) in project.entries.iter_mut().enumerate() {
+            entry.last_child = index + 1 == entry_count;
+        }
+    }
+    (projects, ungrouped_entries)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn append_workspace_rows(
+    result: &mut Vec<SidebarTreeRow>,
+    agents_by_workspace: &mut HashMap<(usize, String), Vec<String>>,
+    endpoint_index: usize,
+    endpoint: &ClientShellEndpoint,
+    snapshot: &ClientShellSnapshot,
+    endpoint_collapsed_groups: &HashSet<String>,
+    active_endpoint_id: &ClientEndpointId,
+    config: &ClientShellConfig,
+    include_endpoints: bool,
+    entries: Vec<WorkspaceEntry>,
+    nested: bool,
+) {
+    for entry in entries {
+        let Some(workspace) = snapshot.workspaces.get(entry.index) else {
+            continue;
+        };
+        let status = super::render::sidebar::displayed_workspace_status(
+            snapshot,
+            workspace,
+            endpoint_collapsed_groups,
+        );
+        let workspace_rows = compact_workspace_rows(workspace, status, nested, &config.spaces);
+        let active_workspace = &endpoint.endpoint_id == active_endpoint_id && workspace.focused;
+        let pane_ids = agents_by_workspace
+            .remove(&(endpoint_index, workspace.workspace_id.clone()))
+            .unwrap_or_default();
+        let mut agent_rows = pane_ids
+            .into_iter()
+            .filter_map(|pane_id| {
+                let mut row = super::agent_sidebar::agent_row(
+                    snapshot,
+                    &pane_id,
+                    config,
+                    include_endpoints.then_some(endpoint.label.as_str()),
+                )?;
+                row.focused &= &endpoint.endpoint_id == active_endpoint_id;
+                Some(row)
+            })
+            .collect::<Vec<_>>();
+        let agent_pane_ids = agent_rows
+            .iter()
+            .map(|row| row.pane_id.as_str())
+            .collect::<HashSet<_>>();
+        let tools = snapshot
+            .panes
+            .iter()
+            .filter(|pane| pane.workspace_id == workspace.workspace_id)
+            .filter(|pane| !agent_pane_ids.contains(pane.pane_id.as_str()))
+            .filter_map(|pane| {
+                let tab = snapshot.tabs.iter().find(|tab| tab.tab_id == pane.tab_id)?;
+                recognized_tool_label(&tab.label).map(|label| {
+                    (
+                        pane.pane_id.clone(),
+                        label,
+                        pane.focused && &endpoint.endpoint_id == active_endpoint_id,
+                    )
+                })
+            })
+            .collect::<Vec<_>>();
+        let child_count = agent_rows.len() + tools.len();
+        let parent_last = nested.then_some(true);
+        result.push(SidebarTreeRow {
+            kind: SidebarTreeRowKind::Workspace {
+                endpoint_index,
+                entry,
+                status,
+                rows: workspace_rows,
+                indent: if nested {
+                    BRANCH_INDENT
+                } else {
+                    WORKSPACE_INDENT
+                },
+                repository_child: nested,
+            },
+        });
+        for (index, row) in agent_rows.drain(..).enumerate() {
+            result.push(SidebarTreeRow {
+                kind: SidebarTreeRowKind::Agent {
+                    endpoint_index,
+                    row,
+                    parent_last,
+                    last_child: index + 1 == child_count,
+                    stale: endpoint.status != ClientEndpointStatus::Online,
+                    active_workspace,
+                },
+            });
+        }
+        let agent_count = child_count - tools.len();
+        for (index, (pane_id, label, focused)) in tools.into_iter().enumerate() {
+            result.push(SidebarTreeRow {
+                kind: SidebarTreeRowKind::Tool {
+                    endpoint_index,
+                    pane_id,
+                    label,
+                    focused,
+                    parent_last,
+                    last_child: agent_count + index + 1 == child_count,
+                    stale: endpoint.status != ClientEndpointStatus::Online,
+                    active_workspace,
+                },
+            });
+        }
+    }
+}
+
+fn recognized_tool_label(label: &str) -> Option<&'static str> {
+    match label.trim().to_ascii_lowercase().as_str() {
+        "nvim" | "neovim" => Some("nvim"),
+        "tuicr" => Some("tuicr"),
+        _ => None,
+    }
+}
+
+fn compact_workspace_rows(
+    workspace: &ClientShellWorkspace,
+    status: crate::api::schema::AgentStatus,
+    nested: bool,
+    config: &SpacesSidebarConfig,
+) -> Vec<Vec<crate::ui::ResolvedToken>> {
+    let label = if nested {
+        workspace
+            .branch
+            .as_deref()
+            .and_then(|branch| branch.strip_prefix("worktree/").or(Some(branch)))
+            .unwrap_or(&workspace.label)
+    } else {
+        &workspace.label
+    };
+    let style = super::render::sidebar::workspace_rows(workspace, status, nested, config)
+        .into_iter()
+        .flatten()
+        .find_map(|token| match token.kind {
+            crate::ui::ResolvedTokenKind::Workspace(_) => Some(token.style),
+            _ => None,
+        })
+        .unwrap_or_default();
+    vec![vec![crate::ui::ResolvedToken {
+        kind: crate::ui::ResolvedTokenKind::Workspace(label.to_owned()),
+        style,
+    }]]
+}
+
+pub(super) fn render_expanded(
+    buffer: &mut Buffer,
+    area: Rect,
+    _active_snapshot: Option<&ClientShellSnapshot>,
+    config: &ClientShellConfig,
+    state: &mut super::render::ShellRenderState<'_>,
+    hits: &mut ShellHitMap,
+    include_endpoints: bool,
+) {
+    let palette = &config.palette;
+    super::render::render_sidebar_background(buffer, area, palette);
+    hits.sidebar_divider = if area.is_empty() {
+        Rect::default()
+    } else {
+        Rect::new(area.right().saturating_sub(1), area.y, 1, area.height)
+    };
+    hits.sidebar_section_divider = Rect::default();
+    let content = Rect::new(area.x, area.y, area.width.saturating_sub(1), area.height);
+    if content.is_empty() {
+        return;
+    }
+    let footer = Rect::new(
+        content.x,
+        content.bottom().saturating_sub(1),
+        content.width,
+        1,
+    );
+    let body = Rect::new(
+        content.x,
+        content.y,
+        content.width,
+        content.height.saturating_sub(1),
+    );
+    hits.workspace_body = body;
+    let route_endpoints = include_endpoints;
+    let include_endpoints = include_endpoints && state.repository_drilldown.is_none();
+
+    let rows = rows(
+        state.endpoints,
+        state.active_endpoint_id,
+        state.collapsed_endpoints,
+        state.collapsed_groups,
+        state.remote_collapsed_groups,
+        state.last_project_workspaces,
+        state.repository_drilldown,
+        config,
+        include_endpoints,
+    );
+    let heights = rows.iter().map(SidebarTreeRow::height).collect::<Vec<_>>();
+    let gaps = vec![0; rows.len()];
+    let reveal_navigation = !body.is_empty() && std::mem::take(state.reveal_navigation_workspace);
+    let reveal_focus = !body.is_empty() && std::mem::take(state.reveal_focused_workspace);
+    let reveal_agent = (!body.is_empty())
+        .then_some(state.pending_agent_reveal.as_ref())
+        .flatten()
+        .and_then(|(endpoint_id, pane_id)| {
+            rows.iter().position(|row| match &row.kind {
+                SidebarTreeRowKind::Agent {
+                    endpoint_index,
+                    row,
+                    ..
+                } => {
+                    state.endpoints[*endpoint_index].endpoint_id == *endpoint_id
+                        && row.pane_id == *pane_id
+                }
+                _ => false,
+            })
+        });
+    let reveal_row = reveal_agent.or_else(|| {
+        (reveal_navigation || reveal_focus)
+            .then(|| {
+                rows.iter().position(|row| match &row.kind {
+                    SidebarTreeRowKind::Workspace {
+                        endpoint_index,
+                        entry,
+                        ..
+                    } => {
+                        let endpoint = &state.endpoints[*endpoint_index];
+                        endpoint
+                            .snapshot
+                            .as_deref()
+                            .and_then(|snapshot| snapshot.workspaces.get(entry.index))
+                            .is_some_and(|workspace| {
+                                if reveal_navigation {
+                                    state.selected_workspace_id.is_some_and(|target| {
+                                        target
+                                            .matches(&endpoint.endpoint_id, &workspace.workspace_id)
+                                    })
+                                } else {
+                                    &endpoint.endpoint_id == state.active_endpoint_id
+                                        && workspace.focused
+                                }
+                            })
+                    }
+                    _ => false,
+                })
+            })
+            .flatten()
+    });
+    if let Some(target) = reveal_row {
+        *state.workspace_scroll = super::scroll::list_scroll_start_to_reveal(
+            &heights,
+            &gaps,
+            body.height,
+            *state.workspace_scroll,
+            target,
+        );
+        if reveal_agent == Some(target) {
+            *state.pending_agent_reveal = None;
+        }
+    }
+    let metrics =
+        super::scroll::list_scroll_metrics(&heights, &gaps, body.height, *state.workspace_scroll);
+    hits.workspace_max_scroll = metrics.max_offset_from_bottom;
+    hits.workspace_scroll_metrics = Some(metrics);
+    *state.workspace_scroll = metrics
+        .max_offset_from_bottom
+        .saturating_sub(metrics.offset_from_bottom);
+    let show_scrollbar = metrics.max_offset_from_bottom > 0 && body.width > 1;
+    let content_width = body.width.saturating_sub(u16::from(show_scrollbar));
+    let mut y = body.y;
+    for (row_index, tree_row) in rows.iter().enumerate().skip(*state.workspace_scroll) {
+        let height = tree_row.height().min(body.height);
+        if y.saturating_add(height) > body.bottom() {
+            break;
+        }
+        let rect = Rect::new(body.x, y, content_width, height);
+        match &tree_row.kind {
+            SidebarTreeRowKind::Spacer => {}
+            SidebarTreeRowKind::Back => {
+                put_text(
+                    buffer,
+                    rect.x,
+                    rect.y,
+                    rect.width,
+                    " ‹ Back",
+                    Style::default()
+                        .fg(palette.accent)
+                        .add_modifier(Modifier::BOLD),
+                );
+                hits.repository_back = rect;
+            }
+            SidebarTreeRowKind::Endpoint { endpoint_index } => {
+                let endpoint = &state.endpoints[*endpoint_index];
+                let collapsed = state.collapsed_endpoints.contains(&endpoint.endpoint_id);
+                let marker = if collapsed { "▸" } else { "▾" };
+                let status_badge = render_endpoint_row(
+                    buffer,
+                    rect,
+                    marker,
+                    endpoint,
+                    collapsed && &endpoint.endpoint_id == state.active_endpoint_id,
+                    state.machine_diagnostics,
+                    palette,
+                );
+                hits.machines.push(MachineHit {
+                    rect,
+                    status_badge,
+                    collapse_toggle: Rect::new(
+                        rect.x.saturating_add(1),
+                        rect.y,
+                        u16::from(rect.width > 1),
+                        1,
+                    ),
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                });
+            }
+            SidebarTreeRowKind::Project {
+                endpoint_index,
+                key,
+                label,
+                worktree,
+                status,
+                collapsible,
+                collapsed,
+            } => {
+                let endpoint = &state.endpoints[*endpoint_index];
+                let control_width = if *collapsible {
+                    if *collapsed {
+                        4
+                    } else {
+                        2
+                    }
+                } else {
+                    0
+                };
+                put_text(
+                    buffer,
+                    rect.x,
+                    rect.y,
+                    rect.width.saturating_sub(control_width),
+                    &format!(" {label}"),
+                    Style::default()
+                        .fg(palette.accent)
+                        .add_modifier(Modifier::BOLD),
+                );
+                if *collapsible {
+                    if *collapsed {
+                        put_text(
+                            buffer,
+                            rect.right().saturating_sub(4),
+                            rect.y,
+                            2,
+                            status_icon(*status, config.status_indicators),
+                            Style::default().fg(status_color(*status, palette)),
+                        );
+                    }
+                    put_text(
+                        buffer,
+                        rect.right().saturating_sub(1),
+                        rect.y,
+                        1,
+                        if *collapsed { "▸" } else { "▾" },
+                        Style::default().fg(palette.accent),
+                    );
+                }
+                if *worktree && state.repository_drilldown.is_none() {
+                    hits.repositories.push(RepositoryHit {
+                        rect,
+                        endpoint_id: endpoint.endpoint_id.clone(),
+                        key: key.clone(),
+                        collapsible: *collapsible,
+                    });
+                }
+                if endpoint.status != ClientEndpointStatus::Online {
+                    buffer.set_style(
+                        rect,
+                        Style::default()
+                            .fg(palette.overlay0)
+                            .add_modifier(Modifier::DIM),
+                    );
+                }
+            }
+            SidebarTreeRowKind::Workspace {
+                endpoint_index,
+                entry,
+                status,
+                rows,
+                indent,
+                repository_child,
+            } => {
+                let endpoint = &state.endpoints[*endpoint_index];
+                let Some(snapshot) = endpoint.snapshot.as_deref() else {
+                    continue;
+                };
+                let Some(workspace) = snapshot.workspaces.get(entry.index) else {
+                    continue;
+                };
+                let selected = state.selected_workspace_id.is_some_and(|target| {
+                    target.matches(&endpoint.endpoint_id, &workspace.workspace_id)
+                });
+                let focused =
+                    &endpoint.endpoint_id == state.active_endpoint_id && workspace.focused;
+                let dragged =
+                    focused && state.dragged_workspace_id == Some(workspace.workspace_id.as_str());
+                let nested = if include_endpoints {
+                    Rect::new(
+                        rect.x.saturating_add(2),
+                        rect.y,
+                        rect.width.saturating_sub(2),
+                        rect.height,
+                    )
+                } else {
+                    rect
+                };
+                let background = if selected {
+                    Some(if palette.selection_bg == ratatui::style::Color::Reset {
+                        palette.active_row_bg
+                    } else {
+                        palette.selection_bg
+                    })
+                } else if dragged {
+                    Some(palette.surface1)
+                } else if focused {
+                    Some(palette.active_row_bg)
+                } else {
+                    None
+                };
+                if let Some(background) = background {
+                    buffer.set_style(rect, Style::default().bg(background));
+                }
+                super::render::sidebar::render_workspace_rows(
+                    buffer,
+                    nested,
+                    *status,
+                    config.status_indicators,
+                    *indent,
+                    rows.clone(),
+                    focused,
+                    selected,
+                    dragged,
+                    palette,
+                );
+                if *repository_child {
+                    let label_width = rows
+                        .first()
+                        .into_iter()
+                        .flatten()
+                        .find_map(|token| match &token.kind {
+                            crate::ui::ResolvedTokenKind::Workspace(label) => {
+                                Some(unicode_width::UnicodeWidthStr::width(label.as_str()) as u16)
+                            }
+                            _ => None,
+                        })
+                        .unwrap_or_default()
+                        .min(nested.width.saturating_sub(*indent as u16));
+                    buffer.set_style(
+                        Rect::new(
+                            nested.x.saturating_add(*indent as u16),
+                            rect.y,
+                            label_width,
+                            1,
+                        ),
+                        Style::default()
+                            .fg(palette.blue)
+                            .add_modifier(Modifier::BOLD),
+                    );
+                }
+                if endpoint.status != ClientEndpointStatus::Online {
+                    buffer.set_style(
+                        rect,
+                        Style::default()
+                            .fg(palette.overlay0)
+                            .add_modifier(Modifier::DIM),
+                    );
+                }
+                hits.workspaces.push(WorkspaceHit {
+                    rect,
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                    workspace_id: workspace.workspace_id.clone(),
+                    indented: entry.indented,
+                });
+            }
+            SidebarTreeRowKind::Agent {
+                endpoint_index,
+                row,
+                parent_last,
+                last_child,
+                stale,
+                active_workspace,
+            } => {
+                let endpoint = &state.endpoints[*endpoint_index];
+                let nested = if include_endpoints {
+                    Rect::new(
+                        rect.x.saturating_add(2),
+                        rect.y,
+                        rect.width.saturating_sub(2),
+                        rect.height,
+                    )
+                } else {
+                    rect
+                };
+                let row_style = if row.focused {
+                    Some(focused_agent_style(palette, *stale))
+                } else if *active_workspace {
+                    Some(Style::default().bg(palette.active_row_bg))
+                } else {
+                    None
+                };
+                if let Some(row_style) = row_style {
+                    buffer.set_style(rect, row_style);
+                }
+                render_tree_child(
+                    buffer,
+                    nested,
+                    &row.label,
+                    Some(row.status),
+                    *parent_last,
+                    *last_child,
+                    row.focused,
+                    config,
+                );
+                if *stale {
+                    buffer.set_style(
+                        rect,
+                        Style::default()
+                            .fg(palette.overlay0)
+                            .add_modifier(Modifier::DIM),
+                    );
+                }
+                if route_endpoints {
+                    hits.endpoint_agents.push((
+                        rect,
+                        endpoint.endpoint_id.clone(),
+                        row.pane_id.clone(),
+                    ));
+                } else {
+                    hits.agents.push((rect, row.pane_id.clone()));
+                }
+            }
+            SidebarTreeRowKind::Tool {
+                endpoint_index,
+                pane_id,
+                label,
+                focused,
+                parent_last,
+                last_child,
+                stale,
+                active_workspace,
+            } => {
+                let endpoint = &state.endpoints[*endpoint_index];
+                let nested = if include_endpoints {
+                    Rect::new(
+                        rect.x.saturating_add(2),
+                        rect.y,
+                        rect.width.saturating_sub(2),
+                        rect.height,
+                    )
+                } else {
+                    rect
+                };
+                let row_style = if *focused {
+                    Some(focused_agent_style(palette, *stale))
+                } else if *active_workspace {
+                    Some(Style::default().bg(palette.active_row_bg))
+                } else {
+                    None
+                };
+                if let Some(row_style) = row_style {
+                    buffer.set_style(rect, row_style);
+                }
+                render_tree_child(
+                    buffer,
+                    nested,
+                    label,
+                    None,
+                    *parent_last,
+                    *last_child,
+                    *focused,
+                    config,
+                );
+                if *stale {
+                    buffer.set_style(
+                        rect,
+                        Style::default()
+                            .fg(palette.overlay0)
+                            .add_modifier(Modifier::DIM),
+                    );
+                }
+                if route_endpoints {
+                    hits.endpoint_agents.push((
+                        rect,
+                        endpoint.endpoint_id.clone(),
+                        pane_id.clone(),
+                    ));
+                } else {
+                    hits.agents.push((rect, pane_id.clone()));
+                }
+            }
+        }
+        y = y
+            .saturating_add(height)
+            .saturating_add(gaps.get(row_index).copied().unwrap_or(0));
+    }
+    if show_scrollbar {
+        let track = Rect::new(body.right().saturating_sub(1), body.y, 1, body.height);
+        hits.workspace_scrollbar = track;
+        super::scroll::render_list_scrollbar(buffer, track, metrics, palette);
+    }
+    if let Some(row) = state
+        .workspace_drop_indicator_row
+        .filter(|row| *row >= body.y.saturating_sub(1) && *row < footer.y)
+    {
+        put_text(
+            buffer,
+            body.x,
+            row,
+            body.width,
+            &"─".repeat(body.width as usize),
+            Style::default().fg(palette.accent),
+        );
+    }
+    render_footer(buffer, footer, config, hits);
+}
+
+pub(super) fn render_collapsed(
+    buffer: &mut Buffer,
+    area: Rect,
+    config: &ClientShellConfig,
+    state: &mut super::render::ShellRenderState<'_>,
+    hits: &mut ShellHitMap,
+    include_endpoints: bool,
+) {
+    let palette = &config.palette;
+    super::render::render_sidebar_background(buffer, area, palette);
+    let content = Rect::new(area.x, area.y, area.width.saturating_sub(1), area.height);
+    let body = Rect::new(
+        content.x,
+        content.y,
+        content.width,
+        content.height.saturating_sub(1),
+    );
+    hits.workspace_body = body;
+    let tree_rows = rows(
+        state.endpoints,
+        state.active_endpoint_id,
+        state.collapsed_endpoints,
+        state.collapsed_groups,
+        state.remote_collapsed_groups,
+        state.last_project_workspaces,
+        None,
+        config,
+        include_endpoints,
+    )
+    .into_iter()
+    .filter(|row| {
+        !matches!(
+            &row.kind,
+            SidebarTreeRowKind::Spacer
+                | SidebarTreeRowKind::Back
+                | SidebarTreeRowKind::Project { .. }
+        )
+    })
+    .collect::<Vec<_>>();
+    let heights = vec![1; tree_rows.len()];
+    let gaps = vec![0; tree_rows.len()];
+    let reveal_navigation = !body.is_empty() && std::mem::take(state.reveal_navigation_workspace);
+    let reveal_focus = !body.is_empty() && std::mem::take(state.reveal_focused_workspace);
+    if reveal_navigation || reveal_focus {
+        if let Some(target) = tree_rows.iter().position(|tree_row| match &tree_row.kind {
+            SidebarTreeRowKind::Workspace {
+                endpoint_index,
+                entry,
+                ..
+            } => {
+                let endpoint = &state.endpoints[*endpoint_index];
+                endpoint
+                    .snapshot
+                    .as_deref()
+                    .and_then(|snapshot| snapshot.workspaces.get(entry.index))
+                    .is_some_and(|workspace| {
+                        if reveal_navigation {
+                            state.selected_workspace_id.is_some_and(|target| {
+                                target.matches(&endpoint.endpoint_id, &workspace.workspace_id)
+                            })
+                        } else {
+                            &endpoint.endpoint_id == state.active_endpoint_id && workspace.focused
+                        }
+                    })
+            }
+            _ => false,
+        }) {
+            *state.workspace_scroll = super::scroll::list_scroll_start_to_reveal(
+                &heights,
+                &gaps,
+                body.height,
+                *state.workspace_scroll,
+                target,
+            );
+        }
+    }
+    let metrics =
+        super::scroll::list_scroll_metrics(&heights, &gaps, body.height, *state.workspace_scroll);
+    hits.workspace_max_scroll = metrics.max_offset_from_bottom;
+    hits.workspace_scroll_metrics = Some(metrics);
+    *state.workspace_scroll = metrics
+        .max_offset_from_bottom
+        .saturating_sub(metrics.offset_from_bottom);
+    let mut y = body.y;
+    for tree_row in tree_rows.into_iter().skip(*state.workspace_scroll) {
+        if y >= body.bottom() {
+            break;
+        }
+        let rect = Rect::new(body.x, y, body.width, 1);
+        match tree_row.kind {
+            SidebarTreeRowKind::Spacer
+            | SidebarTreeRowKind::Back
+            | SidebarTreeRowKind::Project { .. } => continue,
+            SidebarTreeRowKind::Endpoint { endpoint_index } => {
+                let endpoint = &state.endpoints[endpoint_index];
+                let collapsed = state.collapsed_endpoints.contains(&endpoint.endpoint_id);
+                let label = if endpoint.endpoint_id.is_local() {
+                    "L".to_owned()
+                } else {
+                    (endpoint_index + 1).to_string()
+                };
+                let marker = if collapsed { "▸" } else { "▾" };
+                put_text(
+                    buffer,
+                    rect.x,
+                    rect.y,
+                    rect.width.saturating_sub(1),
+                    &format!("{marker}{label}"),
+                    Style::default().fg(if endpoint.status == ClientEndpointStatus::Online {
+                        palette.text
+                    } else {
+                        palette.overlay0
+                    }),
+                );
+                let status_badge = if endpoint.endpoint_id.is_local() {
+                    Rect::default()
+                } else {
+                    let (glyph, _, color) = endpoint_status_presentation(endpoint.status, palette);
+                    let width = super::render::display_width(glyph).min(rect.width);
+                    let badge = Rect::new(rect.right().saturating_sub(width), rect.y, width, 1);
+                    put_right_text(
+                        buffer,
+                        rect,
+                        rect.y,
+                        glyph,
+                        state.machine_diagnostics.badge_style(
+                            endpoint,
+                            palette,
+                            Style::default().fg(color),
+                        ),
+                    );
+                    badge
+                };
+                hits.machines.push(MachineHit {
+                    rect,
+                    status_badge,
+                    collapse_toggle: Rect::new(rect.x, rect.y, u16::from(rect.width > 1), 1),
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                });
+            }
+            SidebarTreeRowKind::Workspace {
+                endpoint_index,
+                entry,
+                status,
+                ..
+            } => {
+                let endpoint = &state.endpoints[endpoint_index];
+                let Some(snapshot) = endpoint.snapshot.as_deref() else {
+                    continue;
+                };
+                let Some(workspace) = snapshot.workspaces.get(entry.index) else {
+                    continue;
+                };
+                let selected = state.selected_workspace_id.is_some_and(|target| {
+                    target.matches(&endpoint.endpoint_id, &workspace.workspace_id)
+                });
+                let focused =
+                    &endpoint.endpoint_id == state.active_endpoint_id && workspace.focused;
+                if selected || focused {
+                    buffer.set_style(
+                        rect,
+                        Style::default().bg(
+                            if selected && palette.selection_bg != ratatui::style::Color::Reset {
+                                palette.selection_bg
+                            } else {
+                                palette.active_row_bg
+                            },
+                        ),
+                    );
+                }
+                let stale = endpoint.status != ClientEndpointStatus::Online;
+                let number = format!(" {}", workspace.number);
+                let number_width = super::render::display_width(&number).min(rect.width);
+                put_text(
+                    buffer,
+                    rect.x,
+                    rect.y,
+                    number_width,
+                    &number,
+                    Style::default()
+                        .fg(if focused && !stale {
+                            palette.accent
+                        } else {
+                            palette.overlay0
+                        })
+                        .add_modifier(if stale {
+                            Modifier::DIM
+                        } else if focused {
+                            Modifier::BOLD
+                        } else {
+                            Modifier::empty()
+                        }),
+                );
+                put_text(
+                    buffer,
+                    rect.x.saturating_add(number_width),
+                    rect.y,
+                    rect.width.saturating_sub(number_width),
+                    status_icon(status, config.status_indicators),
+                    Style::default()
+                        .fg(if stale {
+                            palette.overlay0
+                        } else {
+                            status_color(status, palette)
+                        })
+                        .add_modifier(if stale {
+                            Modifier::DIM
+                        } else {
+                            Modifier::empty()
+                        }),
+                );
+                hits.workspaces.push(WorkspaceHit {
+                    rect,
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                    workspace_id: workspace.workspace_id.clone(),
+                    indented: entry.indented,
+                });
+            }
+            SidebarTreeRowKind::Agent {
+                endpoint_index,
+                row,
+                stale,
+                active_workspace,
+                ..
+            } => {
+                let endpoint = &state.endpoints[endpoint_index];
+                put_text(
+                    buffer,
+                    rect.x,
+                    rect.y,
+                    rect.width,
+                    &format!("└{}", status_icon(row.status, config.status_indicators)),
+                    Style::default()
+                        .fg(if stale {
+                            palette.overlay0
+                        } else {
+                            status_color(row.status, palette)
+                        })
+                        .add_modifier(if stale {
+                            Modifier::DIM
+                        } else {
+                            Modifier::empty()
+                        }),
+                );
+                let row_style = if row.focused {
+                    Some(focused_agent_style(palette, stale))
+                } else if active_workspace {
+                    Some(Style::default().bg(palette.active_row_bg))
+                } else {
+                    None
+                };
+                if let Some(row_style) = row_style {
+                    buffer.set_style(rect, row_style);
+                }
+                if include_endpoints {
+                    hits.endpoint_agents
+                        .push((rect, endpoint.endpoint_id.clone(), row.pane_id));
+                } else {
+                    hits.agents.push((rect, row.pane_id));
+                }
+            }
+            SidebarTreeRowKind::Tool {
+                endpoint_index,
+                pane_id,
+                label,
+                focused,
+                stale,
+                active_workspace,
+                ..
+            } => {
+                let endpoint = &state.endpoints[endpoint_index];
+                put_text(
+                    buffer,
+                    rect.x,
+                    rect.y,
+                    rect.width,
+                    &format!("└{}", label.chars().next().unwrap_or('?')),
+                    Style::default().fg(if stale {
+                        palette.overlay0
+                    } else {
+                        palette.blue
+                    }),
+                );
+                let row_style = if focused {
+                    Some(focused_agent_style(palette, stale))
+                } else if active_workspace {
+                    Some(Style::default().bg(palette.active_row_bg))
+                } else {
+                    None
+                };
+                if let Some(row_style) = row_style {
+                    buffer.set_style(rect, row_style);
+                }
+                if include_endpoints {
+                    hits.endpoint_agents
+                        .push((rect, endpoint.endpoint_id.clone(), pane_id));
+                } else {
+                    hits.agents.push((rect, pane_id));
+                }
+            }
+        }
+        y = y.saturating_add(1);
+    }
+    hits.sidebar_toggle = if content.is_empty() {
+        Rect::default()
+    } else {
+        Rect::new(
+            content.x + content.width / 2,
+            content.bottom().saturating_sub(1),
+            1,
+            1,
+        )
+    };
+    let attention = state
+        .endpoints
+        .iter()
+        .find(|endpoint| &endpoint.endpoint_id == state.active_endpoint_id)
+        .and_then(|endpoint| endpoint.snapshot.as_deref())
+        .is_some_and(super::global_menu::global_menu_attention);
+    put_text(
+        buffer,
+        hits.sidebar_toggle.x,
+        hits.sidebar_toggle.y,
+        hits.sidebar_toggle.width,
+        "»",
+        if attention {
+            Style::default()
+                .fg(palette.accent)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(palette.overlay0)
+        },
+    );
+}
+
+fn render_tree_child(
+    buffer: &mut Buffer,
+    rect: Rect,
+    label: &str,
+    status: Option<crate::api::schema::AgentStatus>,
+    parent_last: Option<bool>,
+    last_child: bool,
+    focused: bool,
+    config: &ClientShellConfig,
+) {
+    let palette = &config.palette;
+    let connector = if last_child { '└' } else { '├' };
+    let prefix = match parent_last {
+        Some(true) => format!("    {connector}─ "),
+        Some(false) => format!(" │  {connector}─ "),
+        None => format!(" {connector}─ "),
+    };
+    let prefix_width = unicode_width::UnicodeWidthStr::width(prefix.as_str()) as u16;
+    let reserved = u16::from(status.is_some()) * 3;
+    put_text(
+        buffer,
+        rect.x,
+        rect.y,
+        prefix_width.min(rect.width),
+        &prefix,
+        Style::default().fg(palette.overlay0),
+    );
+    put_text(
+        buffer,
+        rect.x.saturating_add(prefix_width),
+        rect.y,
+        rect.width.saturating_sub(prefix_width + reserved),
+        label,
+        if focused {
+            Style::default()
+                .fg(palette.blue)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(palette.text)
+        },
+    );
+    if let Some(status) = status {
+        put_text(
+            buffer,
+            rect.right().saturating_sub(2),
+            rect.y,
+            1,
+            status_icon(status, config.status_indicators),
+            Style::default().fg(status_color(status, palette)),
+        );
+    }
+}
+
+fn focused_agent_style(palette: &Palette, stale: bool) -> Style {
+    let background = if palette.selection_bg == ratatui::style::Color::Reset {
+        palette.active_row_bg
+    } else {
+        palette.selection_bg
+    };
+    let style = Style::default().bg(background);
+    if stale {
+        style.fg(palette.overlay0).add_modifier(Modifier::DIM)
+    } else {
+        style.fg(palette.panel_bg).add_modifier(Modifier::BOLD)
+    }
+}
+
+fn render_footer(
+    buffer: &mut Buffer,
+    footer: Rect,
+    config: &ClientShellConfig,
+    hits: &mut ShellHitMap,
+) {
+    if !config.mouse_capture {
+        return;
+    }
+    let label = " todo";
+    hits.todo_launcher = Rect::new(
+        footer.x,
+        footer.y,
+        super::render::display_width(label).min(footer.width),
+        1,
+    );
+    put_text(
+        buffer,
+        footer.x,
+        footer.y,
+        footer.width,
+        label,
+        Style::default()
+            .fg(config.palette.accent)
+            .add_modifier(Modifier::BOLD),
+    );
+}
+
+fn render_endpoint_row(
+    buffer: &mut Buffer,
+    rect: Rect,
+    marker: &str,
+    endpoint: &ClientShellEndpoint,
+    highlighted: bool,
+    auth: &super::machine_diagnostics::MachineDiagnostics,
+    palette: &Palette,
+) -> Rect {
+    if highlighted {
+        buffer.set_style(rect, Style::default().bg(palette.active_row_bg));
+    }
+    let (glyph, state, color) = endpoint_status_presentation(endpoint.status, palette);
+    let state = if endpoint.status == ClientEndpointStatus::Online {
+        ""
+    } else {
+        state
+    };
+    let signal = if auth.required_for(endpoint) {
+        "! auth".to_owned()
+    } else if endpoint.status == ClientEndpointStatus::Attention {
+        "! error".to_owned()
+    } else if endpoint.endpoint_id.is_local() {
+        String::new()
+    } else if state.is_empty() {
+        glyph.to_owned()
+    } else {
+        format!("{glyph} {state}")
+    };
+    let signal_width = super::render::display_width(&signal).min(rect.width);
+    put_text(
+        buffer,
+        rect.x,
+        rect.y,
+        rect.width.saturating_sub(signal_width.saturating_add(1)),
+        &format!(" {marker} {}", endpoint.label),
+        Style::default()
+            .fg(
+                if matches!(endpoint.status, ClientEndpointStatus::Disabled) {
+                    palette.overlay0
+                } else {
+                    palette.text
+                },
+            )
+            .add_modifier(Modifier::BOLD),
+    );
+    put_right_text(
+        buffer,
+        rect,
+        rect.y,
+        &signal,
+        auth.badge_style(endpoint, palette, Style::default().fg(color)),
+    );
+    Rect::new(
+        rect.right().saturating_sub(signal_width),
+        rect.y,
+        signal_width,
+        1,
+    )
+}
+
+fn put_text(buffer: &mut Buffer, x: u16, y: u16, width: u16, text: &str, style: Style) {
+    super::render::put_text(buffer, x, y, width, text, style);
+}
+
+fn put_right_text(buffer: &mut Buffer, area: Rect, y: u16, text: &str, style: Style) {
+    super::render::put_right_text(buffer, area, y, text, style);
+}
+
+pub(super) fn online_agent_targets(
+    endpoints: &[ClientShellEndpoint],
+    active_endpoint_id: &ClientEndpointId,
+    config: &ClientShellConfig,
+) -> Vec<super::aggregate_navigation::AggregateAgentTarget> {
+    rows(
+        endpoints,
+        active_endpoint_id,
+        &HashSet::new(),
+        &HashSet::new(),
+        &HashMap::new(),
+        &HashMap::new(),
+        None,
+        config,
+        false,
+    )
+    .into_iter()
+    .filter_map(|tree_row| match tree_row.kind {
+        SidebarTreeRowKind::Agent {
+            endpoint_index,
+            row,
+            stale: false,
+            ..
+        } => Some(super::aggregate_navigation::AggregateAgentTarget {
+            endpoint_id: endpoints[endpoint_index].endpoint_id.clone(),
+            pane_id: row.pane_id,
+        }),
+        _ => None,
+    })
+    .collect()
+}
