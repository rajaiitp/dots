+    let rows = frame_rows(&frame);
+    let sidebar_width = state.hits.sidebar_divider.x as usize;
+    let sidebar_row = |y: u16| {
+        rows[y as usize]
+            .chars()
+            .take(sidebar_width)
+            .collect::<String>()
+    };
+    let workspace_y = |workspace_id: &str| {
+        state
+            .hits
+            .workspaces
+            .iter()
+            .find(|hit| hit.workspace_id == workspace_id)
