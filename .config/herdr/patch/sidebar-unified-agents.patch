+            .any(|command| {
+                command.action_type == crate::config::CommandKeybindType::Shell
+                    && command.command == TODO_WORKSPACE_COMMAND
+            })
+            .then(|| {
+                std::env::var_os("HOME")
+                    .map(std::path::PathBuf::from)
+                    .map(|home| home.join(TODO_LAUNCHER_RELATIVE_PATH))
