+fn pane_run_command(args: &[String]) -> std::io::Result<i32> {
+    const USAGE: &str = "usage: herdr pane run-command <pane_id> [--timeout MS] -- <command>";
+    let Some(pane_id) = args.first() else {
+        eprintln!("{USAGE}");
+        return Ok(2);
+    };
+    let mut timeout_ms = None;
+    let mut command_start = None;
+    let mut index = 1;
+    while index < args.len() {
+        match args[index].as_str() {
+            "--timeout" if index + 1 < args.len() => {
+                timeout_ms = match args[index + 1].parse::<u64>() {
+                    Ok(value) => Some(value),
+                    Err(_) => {
+                        eprintln!("invalid --timeout value: {}", args[index + 1]);
+                        return Ok(2);
+                    }
+                };
+                index += 2;
+            }
+            "--" => {
+                command_start = Some(index + 1);
+                break;
+            }
+            _ => {
+                eprintln!("{USAGE}");
+                return Ok(2);
+            }
+        }
+    }
+    let Some(command_start) = command_start.filter(|start| *start < args.len()) else {
+        eprintln!("{USAGE}");
+        return Ok(2);
+    };
+    let params = PaneRunCommandParams {
+        pane_id: super::normalize_pane_id(pane_id),
+        command: args[command_start..].join(" "),
+        timeout_ms,
+    };
+    super::print_response(&super::send_request(&Request {
+        id: "cli:pane:run-command".into(),
+        method: Method::PaneRunCommand(params),
+    })?)
+}
