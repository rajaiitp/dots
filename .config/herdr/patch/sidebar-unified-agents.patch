+#[test]
+fn unified_sidebar_tree_groups_only_detected_agents_under_workspaces() {
+    let mut projected = snapshot();
+    let mut empty_workspace = projected.workspaces[0].clone();
+    empty_workspace.workspace_id = "ws_2".into();
+    empty_workspace.number = 2;
+    empty_workspace.label = "empty-space".into();
+    empty_workspace.focused = false;
+    projected.workspaces.push(empty_workspace);
+    let mut ordinary_pane = projected.panes[0].clone();
+    ordinary_pane.pane_id = "ordinary-pane".into();
+    ordinary_pane.workspace_id = "ws_2".into();
+    ordinary_pane.focused = false;
+    projected.panes.push(ordinary_pane);
+    projected.agents = vec![ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: Some("tree agent".into()),
+        display_agent: None,
+        agent: Some("pi".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Working,
+        state_change_seq: 1,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: true,
+    }];
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 30).expect("unified sidebar tree");
+
+    assert_eq!(
+        state
+            .hits
+            .workspaces
+            .iter()
+            .map(|hit| hit.workspace_id.as_str())
+            .collect::<Vec<_>>(),
+        ["ws_1", "ws_2"]
+    );
+    assert_eq!(
+        state
+            .hits
+            .agents
+            .iter()
+            .map(|(_, pane_id)| pane_id.as_str())
+            .collect::<Vec<_>>(),
+        ["pane_1"]
+    );
+    assert!(state.hits.sidebar_section_divider.is_empty());
+    assert!(state.hits.workspaces[0].rect.bottom() <= state.hits.agents[0].0.y);
+    assert_eq!(
+        state.hits.agents[0].0.bottom() + 1,
+        state.hits.workspaces[1].rect.y
+    );
+    let buffer = frame.to_ratatui_buffer().expect("unified sidebar buffer");
+    let active = state.hits.workspaces[0].rect;
+    assert_eq!(active.height, 1);
+    let accent_bold = (active.x..active.right())
+        .filter(|x| {
+            let cell = &buffer[(*x, active.y)];
+            cell.fg == state.config.palette.accent && cell.modifier.contains(Modifier::BOLD)
+        })
+        .count();
+    assert!(accent_bold > 1);
+    let (workspace_x, workspace_y) = cell_symbol_position(&frame, active, "client-shell");
+    let workspace_cell = &buffer[(workspace_x, workspace_y)];
+    assert_eq!(workspace_cell.fg, state.config.palette.accent);
+    assert!(workspace_cell.modifier.contains(Modifier::BOLD));
+    let active_text = (active.x..active.right())
+        .map(|x| buffer[(x, active.y)].symbol())
+        .collect::<String>();
+    assert!(active_text.trim_start().starts_with("client-shell"));
+    assert!((active.x..active.right())
+        .all(|x| buffer[(x, active.y)].bg != state.config.palette.active_row_bg));
+    let text = frame
+        .cells
+        .chunks(frame.width as usize)
+        .map(|row| {
+            row.iter()
+                .map(|cell| cell.symbol.as_str())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(text.contains("client-shell · main"), "frame: {text}");
+    assert!(!text.contains("tree agent"), "frame: {text}");
+    assert!(!text.contains("working"), "frame: {text}");
+    assert!(text.contains("empty-space · main"), "frame: {text}");
+    assert!(!text.contains("spaces · agents"), "frame: {text}");
+}
