+#[test]
+fn remote_repository_drilldown_keeps_endpoint_routing_and_exits_on_outside_focus() {
+    let (mut state, remote_id) = state_with_remote();
+    let mut remote = state
+        .endpoints
+        .iter()
+        .find(|endpoint| endpoint.endpoint_id == remote_id)
+        .and_then(|endpoint| endpoint.snapshot.clone())
+        .unwrap();
+    remote.revision = remote.revision.saturating_add(1);
+    remote.workspaces[0].worktree = Some(ClientShellWorktree {
+        key: "remote-repo".into(),
+        label: "remote-repo".into(),
+        is_linked_worktree: false,
+    });
+    state.set_endpoint_snapshot(&remote_id, remote);
+    state
+        .endpoints
+        .iter_mut()
+        .find(|endpoint| endpoint.endpoint_id == remote_id)
+        .and_then(|endpoint| endpoint.snapshot.as_mut())
+        .unwrap()
+        .agents = vec![agent("remote agent", AgentStatus::Idle, 2)];
+    state.compose(120, 30).unwrap();
+    let repository = state
+        .hits
+        .repositories
+        .iter()
+        .find(|hit| hit.endpoint_id == remote_id)
+        .unwrap()
+        .rect;
+    for kind in [
+        MouseEventKind::Down(MouseButton::Left),
+        MouseEventKind::Up(MouseButton::Left),
+        MouseEventKind::Down(MouseButton::Left),
+    ] {
+        state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind,
+            column: repository.x.saturating_add(1),
+            row: repository.y,
+            modifiers: KeyModifiers::empty(),
+        })]);
+    }
+    let drilldown = state.repository_drilldown.as_ref().unwrap();
+    assert_eq!(drilldown.endpoint_id, remote_id);
+    assert_eq!(state.active_endpoint_id, ClientEndpointId::Local);
+
+    state.compose(120, 30).unwrap();
+    assert!(state.hits.agents.is_empty());
+    assert!(state
+        .hits
+        .endpoint_agents
+        .iter()
+        .any(|(_, endpoint_id, _)| endpoint_id == &remote_id));
+
+    assert!(state.activate_endpoint_projection(&remote_id));
+    assert!(state.repository_drilldown.is_some());
+    assert!(state.activate_endpoint_projection(&ClientEndpointId::Local));
+    assert!(state.repository_drilldown.is_none());
+}
