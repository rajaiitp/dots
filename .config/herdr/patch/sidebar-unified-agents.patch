+    fn spawn_todo_launcher(launcher: std::path::PathBuf, background: bool) -> std::io::Result<()> {
+        #[cfg(test)]
+        {
+            let _ = (launcher, background);
+            Ok(())
+        }
+        #[cfg(not(test))]
+        {
+            let thread_name = if background {
+                TODO_STARTUP_THREAD_NAME
+            } else {
+                TODO_FOCUS_THREAD_NAME
+            };
+            std::thread::Builder::new()
+                .name(thread_name.into())
+                .spawn(move || {
+                    let mut command = std::process::Command::new(&launcher);
+                    if background {
+                        command.arg(TODO_BACKGROUND_ARGUMENT);
+                    }
+                    let result = command
+                        .env(crate::api::SOCKET_PATH_ENV_VAR, crate::api::socket_path())
+                        .stdin(std::process::Stdio::null())
+                        .stdout(std::process::Stdio::null())
+                        .stderr(std::process::Stdio::null())
+                        .status();
+                    match result {
+                        Ok(status) if status.success() => {}
+                        Ok(status) => tracing::warn!(
+                            path = %launcher.display(),
+                            ?status,
+                            background,
+                            "Todo launcher failed"
+                        ),
+                        Err(error) => tracing::warn!(
+                            path = %launcher.display(),
+                            %error,
