+        key: String,
+        overview_scroll: usize,
+    ) -> bool {
+        if !self.repository_exists(&endpoint_id, &key) {
+            return false;
+        }
+        self.repository_drilldown = Some(ClientRepositoryDrilldown {
+            endpoint_id,
+            key,
+            overview_scroll,
+            last_observed_focus: self.current_repository_focus_cursor(),
+        });
+        self.workspace_scroll = 0;
