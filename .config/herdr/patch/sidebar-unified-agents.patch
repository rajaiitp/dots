+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ShellCommandCapture {
+    pub sequence: u64,
+    pub exit_code: i32,
+    pub output: Vec<u8>,
+    pub truncated: bool,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct ShellCommandCompletion {
+    pub sequence: u64,
+    pub exit_code: i32,
+    pub managed: bool,
+}
+
+#[derive(Debug, Default)]
+struct ShellCommandTracker {
+    scan_buffer: Vec<u8>,
+    active_output: Option<Vec<u8>>,
+    active_truncated: bool,
+    active_managed: bool,
+    managed_pending_deadline: Option<Instant>,
+    next_sequence: u64,
+    captures: VecDeque<ShellCommandCapture>,
+    pending: Vec<ShellCommandCompletion>,
+}
+
+impl ShellCommandTracker {
+    fn reserve_managed(&mut self, timeout: Duration) -> Result<u64, ()> {
+        if self
+            .managed_pending_deadline
+            .is_some_and(|deadline| Instant::now() >= deadline)
+        {
+            self.managed_pending_deadline = None;
+        }
+        if self.managed_pending_deadline.is_some() || self.active_output.is_some() {
+            return Err(());
+        }
+        self.managed_pending_deadline = Some(Instant::now() + timeout);
+        Ok(self.next_sequence)
+    }
+
+    fn cancel_managed_reservation(&mut self) {
+        self.managed_pending_deadline = None;
+    }
+
+    fn observe(&mut self, bytes: &[u8]) {
+        self.scan_buffer.extend_from_slice(bytes);
+        loop {
+            let Some(start) = find_subslice(&self.scan_buffer, SHELL_SEMANTIC_OSC_PREFIX) else {
+                let keep = semantic_prefix_suffix_len(&self.scan_buffer);
+                let emit_len = self.scan_buffer.len().saturating_sub(keep);
+                if emit_len > 0 {
+                    let text = self.scan_buffer.drain(..emit_len).collect::<Vec<_>>();
+                    self.capture_text(&text);
+                }
+                break;
+            };
+            if start > 0 {
+                let text = self.scan_buffer.drain(..start).collect::<Vec<_>>();
+                self.capture_text(&text);
+                continue;
+            }
+
+            let payload_start = SHELL_SEMANTIC_OSC_PREFIX.len();
+            let Some((payload_end, sequence_end)) =
+                semantic_osc_terminator(&self.scan_buffer, payload_start)
+            else {
+                if self.scan_buffer.len() > SHELL_SEMANTIC_OSC_LIMIT_BYTES {
+                    let byte = self.scan_buffer.remove(0);
+                    self.capture_text(&[byte]);
+                    continue;
+                }
+                break;
+            };
+            let payload = self.scan_buffer[payload_start..payload_end].to_vec();
+            self.scan_buffer.drain(..sequence_end);
+            self.handle_semantic_payload(&payload);
+        }
+    }
+
+    fn capture_text(&mut self, bytes: &[u8]) {
+        let Some(output) = self.active_output.as_mut() else {
+            return;
+        };
+        if output.len().saturating_add(bytes.len()) <= SHELL_COMMAND_CAPTURE_LIMIT_BYTES {
+            output.extend_from_slice(bytes);
+            return;
+        }
+
+        self.active_truncated = true;
+        if bytes.len() >= SHELL_COMMAND_CAPTURE_LIMIT_BYTES {
+            output.clear();
+            output.extend_from_slice(&bytes[bytes.len() - SHELL_COMMAND_CAPTURE_LIMIT_BYTES..]);
+            return;
+        }
+        let overflow = output
+            .len()
+            .saturating_add(bytes.len())
+            .saturating_sub(SHELL_COMMAND_CAPTURE_LIMIT_BYTES);
+        output.drain(..overflow.min(output.len()));
+        output.extend_from_slice(bytes);
+    }
+
+    fn handle_semantic_payload(&mut self, payload: &[u8]) {
+        let mut fields = payload.split(|byte| *byte == b';');
+        match fields.next() {
+            Some(b"C") => {
+                self.active_output = Some(Vec::new());
+                self.active_truncated = false;
+                self.active_managed = self
+                    .managed_pending_deadline
+                    .take()
+                    .is_some_and(|deadline| Instant::now() < deadline);
+            }
+            Some(b"D") => {
+                let Some(output) = self.active_output.take() else {
+                    return;
+                };
+                let Some(exit_code) = fields
+                    .next()
+                    .and_then(|field| std::str::from_utf8(field).ok())
+                    .and_then(|field| field.parse::<i32>().ok())
+                else {
+                    self.active_output = Some(output);
+                    return;
+                };
+                self.next_sequence = self.next_sequence.wrapping_add(1).max(1);
+                let sequence = self.next_sequence;
+                self.captures.push_back(ShellCommandCapture {
+                    sequence,
+                    exit_code,
+                    output,
+                    truncated: self.active_truncated,
+                });
+                while self.captures.len() > SHELL_COMMAND_CAPTURE_HISTORY {
+                    self.captures.pop_front();
+                }
+                self.pending.push(ShellCommandCompletion {
+                    sequence,
+                    exit_code,
+                    managed: self.active_managed,
+                });
+                self.active_truncated = false;
+                self.active_managed = false;
+            }
+            _ => {}
+        }
+    }
+
+    fn drain_pending(&mut self) -> Vec<ShellCommandCompletion> {
+        std::mem::take(&mut self.pending)
+    }
+
+    fn capture(&self, sequence: u64) -> Option<ShellCommandCapture> {
+        self.captures
+            .iter()
+            .find(|capture| capture.sequence == sequence)
+            .cloned()
+    }
+}
+
+fn find_subslice(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    haystack
+        .windows(needle.len())
+        .position(|window| window == needle)
+}
+
+fn semantic_prefix_suffix_len(bytes: &[u8]) -> usize {
+    (1..SHELL_SEMANTIC_OSC_PREFIX.len())
+        .rev()
+        .find(|len| bytes.ends_with(&SHELL_SEMANTIC_OSC_PREFIX[..*len]))
+        .unwrap_or(0)
+}
+
+fn semantic_osc_terminator(bytes: &[u8], payload_start: usize) -> Option<(usize, usize)> {
+    for index in payload_start..bytes.len() {
+        if bytes[index] == b'\x07' {
+            return Some((index, index + 1));
+        }
+        if bytes[index] == b'\x1b' && bytes.get(index + 1) == Some(&b'\\') {
+            return Some((index, index + 2));
+        }
+    }
+    None
+}
