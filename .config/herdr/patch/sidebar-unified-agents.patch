+#[test]
+fn repository_connectors_begin_at_workspace_children() {
+    let mut projected = repository_drilldown_snapshot(0, false);
+    projected.tabs[0].label = "nvim".into();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 20).expect("repository hierarchy");
+    let rows = frame_rows(&frame);
+    let workspace = state
+        .hits
+        .workspaces
+        .iter()
+        .find(|hit| hit.workspace_id == "ws_1")
+        .expect("root workspace row");
+    let sidebar_width = state.hits.sidebar_divider.x as usize;
+    let workspace_text = rows[workspace.rect.y as usize]
+        .chars()
+        .take(sidebar_width)
+        .collect::<String>();
+    let child_text = rows[workspace.rect.y.saturating_add(1) as usize]
+        .chars()
+        .take(sidebar_width)
