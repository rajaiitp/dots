+    linked.active_tab_id = "tab_ws2".into();
+    linked.new_workspace_cwd = "/repo/feature".into();
+    linked.number = 2;
+    linked.label = "repo-feature".into();
+    linked.branch = Some("worktree/feature".into());
+    linked.worktree = Some(ClientShellWorktree {
+        key: "repo".into(),
+        label: "repo".into(),
+        is_linked_worktree: true,
+    });
+    linked.focused = false;
+    projected.workspaces.push(linked);
+    for index in 0..outside_count {
+        let mut outside = projected.workspaces[0].clone();
+        outside.workspace_id = format!("outside_{index}");
+        outside.active_tab_id = format!("outside_tab_{index}");
+        outside.number = index.saturating_add(3);
