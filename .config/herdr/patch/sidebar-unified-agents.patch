+#[test]
+fn repository_single_click_drills_down_and_back_restores_the_overview() {
+    let root = std::env::temp_dir().join(format!(
+        "herdr-repository-drilldown-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    std::fs::create_dir_all(&root).unwrap();
+    let preferences_path = root.join("preferences.json");
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    config.preferences_path = Some(preferences_path.clone());
+    let mut state = ClientShellState::new(config);
+    let mut projected = repository_drilldown_snapshot(0, false);
+    let mut prior = projected.workspaces[0].clone();
+    prior.workspace_id = "prior_ws".into();
+    prior.active_tab_id = "prior_tab".into();
+    prior.number = 9;
+    prior.label = "prior".into();
+    prior.focused = false;
+    prior.worktree = Some(ClientShellWorktree {
+        key: "prior".into(),
+        label: "prior".into(),
+        is_linked_worktree: false,
+    });
+    projected.workspaces.insert(0, prior);
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.workspace_scroll = 2;
+    state.compose(106, 5).expect("overview frame");
+    assert_eq!(state.workspace_scroll, 2);
+    let repository = state
+        .hits
+        .repositories
+        .iter()
+        .find(|hit| hit.key == "repo")
+        .unwrap()
+        .rect;
+
+    let outcome = state.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(outcome.actions.is_empty());
+    assert!(outcome.repaint);
+    assert!(state.repository_drilldown.is_some());
+    assert!(state.collapsed_groups.is_empty());
+    assert_eq!(state.workspace_scroll, 0);
+
+    let drilled = state.compose(106, 7).expect("drilled frame");
+    assert!(!state.hits.repository_back.is_empty());
+    assert_eq!(
+        state
+            .hits
+            .workspaces
+            .iter()
+            .map(|hit| hit.workspace_id.as_str())
+            .collect::<Vec<_>>(),
+        ["ws_1", "ws_2"]
+    );
+    let text = drilled
+        .cells
+        .chunks(drilled.width as usize)
+        .map(|row| {
+            row.iter()
+                .map(|cell| cell.symbol.as_str())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(text.contains("‹ Back"), "frame: {text}");
+    assert!(!text.contains("prior"), "frame: {text}");
+
+    let back = state.hits.repository_back;
+    let outcome = state.handle_raw_events(vec![repository_mouse(
+        back,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(outcome.repaint);
+    assert!(state.repository_drilldown.is_none());
+    assert_eq!(state.workspace_scroll, 2);
+    assert!(!state.reveal_focused_workspace);
+    assert!(!state.reveal_navigation_workspace);
+    assert!(state.pending_agent_reveal.is_none());
+    state.compose(106, 5).expect("restored overview");
+    assert_eq!(state.workspace_scroll, 2);
+    std::fs::remove_dir_all(root).unwrap();
+}
