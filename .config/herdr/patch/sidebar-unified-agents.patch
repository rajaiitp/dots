+    assert!(workspace_text.starts_with("    main"), "{workspace_text:?}");
+    assert!(!workspace_text.contains("├─"), "{workspace_text:?}");
+    assert!(!workspace_text.contains("└─"), "{workspace_text:?}");
+    assert!(child_text.starts_with("    └─ nvim"), "{child_text:?}");
+    assert!(!child_text.starts_with(" │"), "{child_text:?}");
+}
