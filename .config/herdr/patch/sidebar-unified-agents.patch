+#[test]
+fn pane_run_command_waits_without_visible_protocol_text() {
+    let base = unique_test_dir();
+    let config_home = base.join("config");
+    let runtime_dir = base.join("runtime");
+    let socket_path = runtime_dir.join("herdr.sock");
+    let shell = base.join("semantic-shell");
+    std::fs::create_dir_all(&base).unwrap();
+    std::fs::write(
+        &shell,
+        "#!/bin/sh\nprintf '\\033]133;A\\a$ \\033]133;B\\a'\nwhile IFS= read -r command; do\n  printf '\\033]133;C\\a'\n  eval \"$command\"\n  status=$?\n  printf '\\033]133;D;%s\\a\\033]133;A\\a$ \\033]133;B\\a' \"$status\"\ndone\n",
+    )
+    .unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mut permissions = std::fs::metadata(&shell).unwrap().permissions();
+        permissions.set_mode(0o755);
+        std::fs::set_permissions(&shell, permissions).unwrap();
+    }
+    let config = format!(
+        "onboarding = false\n[terminal]\ndefault_shell = {:?}\nshell_mode = \"non_login\"\n",
+        shell.to_str().unwrap()
+    );
+    let herdr = spawn_herdr_with_config(&config_home, &runtime_dir, &socket_path, None, &config);
+    wait_for_socket(&socket_path, Duration::from_secs(5));
+
+    let created = run_cli(
+        &socket_path,
+        &["workspace", "create", "--cwd", base.to_str().unwrap()],
+    );
+    assert!(created.status.success());
+    let setup = run_cli(
+        &socket_path,
+        &["pane", "run", "1-1", "printf 'setup complete\\n'"],
+    );
+    assert!(setup.status.success());
+    let setup_wait = run_cli(
+        &socket_path,
+        &[
+            "pane",
+            "wait-output",
+            "1-1",
+            "--regex",
+            "^setup complete$",
+            "--source",
+            "recent-unwrapped",
+            "--lines",
+            "40",
+            "--timeout",
+            "5000",
+        ],
+    );
+    assert!(setup_wait.status.success());
+
+    let run = run_cli(
+        &socket_path,
+        &[
+            "pane",
+            "run-command",
+            "1-1",
+            "--timeout",
+            "5000",
+            "--",
+            "printf 'clean output\\n'; false",
+        ],
+    );
+    if !run.status.success() {
+        let debug_read = run_cli(
+            &socket_path,
+            &[
+                "pane",
+                "read",
+                "1-1",
+                "--source",
+                "recent-unwrapped",
+                "--lines",
+                "40",
+            ],
+        );
+        panic!(
+            "stderr: {} stdout: {} pane: {}",
+            String::from_utf8_lossy(&run.stderr),
+            String::from_utf8_lossy(&run.stdout),
+            String::from_utf8_lossy(&debug_read.stdout)
+        );
+    }
+    let run_json: serde_json::Value = serde_json::from_slice(&run.stdout).unwrap();
+    assert_eq!(run_json["result"]["exit_code"], 1);
+    assert_eq!(run_json["result"]["output"], "clean output\r\n");
+
+    let read = run_cli(
+        &socket_path,
+        &[
+            "pane",
+            "read",
+            "1-1",
+            "--source",
+            "recent-unwrapped",
+            "--lines",
+            "40",
+        ],
+    );
+    assert!(read.status.success());
+    let pane_text = String::from_utf8(read.stdout).unwrap();
+    assert!(pane_text.contains("printf 'clean output\\n'; false"));
+    assert!(!pane_text.contains("__PI_HERDR_"));
+    assert!(!pane_text.contains("__pi_herdr_"));
+
+    cleanup_spawned_herdr(herdr, base);
+}
