+#[test]
+fn repository_drilldown_disables_workspace_drag_and_exits_if_the_repository_disappears() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(repository_drilldown_snapshot(1, false)));
+    state.set_pane_surface(surface());
+    assert!(state.enter_repository_drilldown(ClientEndpointId::Local, "repo".into()));
+    state.compose(106, 20).expect("drilled repository");
+    let first = state.hits.workspaces[0].rect;
+    let second = state.hits.workspaces[1].rect;
+    state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: first.x.saturating_add(2),
+        row: first.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind: MouseEventKind::Drag(MouseButton::Left),
+        column: second.x.saturating_add(2),
+        row: second.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    assert!(state.chrome_drag.is_none());
+
+    let mut removed = repository_drilldown_snapshot(1, false);
+    removed.revision = 2;
+    for workspace in &mut removed.workspaces {
+        workspace.worktree = None;
+    }
+    state.set_snapshot(Box::new(removed));
+    assert!(state.repository_drilldown.is_none());
+    assert!(state.workspace_press.is_none());
+}
