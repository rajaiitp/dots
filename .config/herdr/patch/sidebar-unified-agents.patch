+        if !self.repository_exists(&drilldown.endpoint_id, &drilldown.key) {
+            return self.exit_repository_drilldown();
+        }
+        let current = self.current_repository_focus_cursor();
+        if current == drilldown.last_observed_focus {
+            return false;
+        }
+        let inside = current.workspace_id.as_deref().is_some_and(|workspace_id| {
+            self.repository_contains_workspace(&drilldown.endpoint_id, &drilldown.key, workspace_id)
+                && current.endpoint_id == drilldown.endpoint_id
+        });
+        if !inside {
+            return self.exit_repository_drilldown();
+        }
+        if let Some(drilldown) = self.repository_drilldown.as_mut() {
+            drilldown.last_observed_focus = current;
+        }
+        false
+    }
