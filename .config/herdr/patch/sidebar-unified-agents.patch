+    pub(super) fn repository_collapsible(
+        &self,
+        endpoint_id: &ClientEndpointId,
+        key: &str,
+    ) -> Option<bool> {
+        let snapshot = self
+            .endpoints
+            .iter()
+            .find(|endpoint| &endpoint.endpoint_id == endpoint_id)?
+            .snapshot
+            .as_deref()?;
+        let mut count = 0usize;
+        let mut has_primary = false;
+        for workspace in &snapshot.workspaces {
+            let Some(worktree) = workspace
+                .worktree
+                .as_ref()
+                .filter(|worktree| worktree.key == key)
+            else {
+                continue;
+            };
+            count = count.saturating_add(1);
+            has_primary |= !worktree.is_linked_worktree;
+        }
+        (count > 0).then_some(count >= 2 && has_primary)
+    }
+
+    fn repository_exists(&self, endpoint_id: &ClientEndpointId, key: &str) -> bool {
+        self.repository_collapsible(endpoint_id, key).is_some()
+    }
