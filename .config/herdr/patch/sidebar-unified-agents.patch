+#[test]
+fn repository_drilldown_disables_workspace_drag_and_exits_if_the_repository_disappears() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(repository_drilldown_snapshot(1, false)));
+    state.set_pane_surface(surface());
