+pub(super) const TODO_WORKSPACE_LABEL: &str = "todo";
+const TODO_WORKSPACE_COMMAND: &str = "~/.config/herdr/scripts/tuxedo-workspace.sh";
+const TODO_WORKSPACE_DESCRIPTION: &str = "Open Todo workspace";
+const TODO_BACKGROUND_ARGUMENT: &str = "--background";
+const TODO_LAUNCHER_RELATIVE_PATH: &str = ".config/herdr/scripts/tuxedo-workspace.sh";
+const TODO_STARTUP_THREAD_NAME: &str = "herdr-todo-startup";
+
 impl ClientShellState {
+    pub(super) fn todo_background_launcher(&self) -> Option<std::path::PathBuf> {
+        self.config
+            .local_keys
+            .command
+            .iter()
+            .any(|command| {
+                command.action_type == crate::config::CommandKeybindType::Shell
+                    && command.command == TODO_WORKSPACE_COMMAND
+            })
+            .then(|| {
+                std::env::var_os("HOME")
+                    .map(std::path::PathBuf::from)
+                    .map(|home| home.join(TODO_LAUNCHER_RELATIVE_PATH))
+            })
+            .flatten()
+    }
+
+    pub(crate) fn start_todo_workspace_in_background(&mut self) {
+        if self.todo_background_start_requested {
+            return;
+        }
+        let Some(launcher) = self.todo_background_launcher() else {
+            return;
+        };
+        self.todo_background_start_requested = true;
+        let thread = std::thread::Builder::new()
+            .name(TODO_STARTUP_THREAD_NAME.into())
+            .spawn(move || {
+                let result = std::process::Command::new(&launcher)
+                    .arg(TODO_BACKGROUND_ARGUMENT)
+                    .env(crate::api::SOCKET_PATH_ENV_VAR, crate::api::socket_path())
+                    .stdin(std::process::Stdio::null())
+                    .stdout(std::process::Stdio::null())
+                    .stderr(std::process::Stdio::null())
+                    .status();
+                match result {
+                    Ok(status) if status.success() => {}
+                    Ok(status) => tracing::warn!(
+                        path = %launcher.display(),
+                        ?status,
+                        "Todo background launcher failed"
+                    ),
+                    Err(error) => tracing::warn!(
+                        path = %launcher.display(),
+                        %error,
+                        "Could not start Todo background launcher"
+                    ),
+                }
+            });
+        if let Err(error) = thread {
+            tracing::warn!(%error, "Could not create Todo startup thread");
+        }
+    }
+
+    pub(super) fn open_todo_workspace(&mut self, outcome: &mut ClientShellInput) {
+        let command = self
+            .config
+            .keybinds
+            .keybinds
+            .custom_commands
+            .iter()
+            .find(|command| {
+                command.action == crate::config::CustomCommandAction::Shell
+                    && (command.command == TODO_WORKSPACE_COMMAND
+                        || command.description.as_deref() == Some(TODO_WORKSPACE_DESCRIPTION))
+            })
+            .cloned();
+        let Some(command) = command else {
+            self.set_endpoint_error("Todo workspace command is not configured");
+            outcome.repaint = true;
+            return;
+        };
+        self.record_binding(crate::input::KeybindMatch::Command(command), outcome);
+    }
