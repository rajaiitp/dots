+pub(super) fn run_command(
+    request_id: String,
+    params: crate::api::schema::PaneRunCommandParams,
+    stream: &mut LocalStream,
+    api_tx: &ApiRequestSender,
+    event_hub: &EventHub,
+    running: &Arc<AtomicBool>,
+) -> std::io::Result<Option<String>> {
+    let timeout_ms = params
+        .timeout_ms
+        .unwrap_or(DEFAULT_PANE_RUN_COMMAND_TIMEOUT_MS);
+    let deadline = Some(std::time::Instant::now() + std::time::Duration::from_millis(timeout_ms));
+    let client_disconnected = watch_for_connection_close(stream, event_hub.clone())?;
+    let mut last_event_sequence = event_hub.current_sequence();
+    let mut wake_generation = event_hub.wake_generation();
+    let (pane_id, after_sequence) = match start_command(
+        &request_id,
+        crate::api::schema::PaneRunCommandParams {
+            pane_id: params.pane_id,
+            command: params.command,
+            timeout_ms: Some(timeout_ms),
+        },
+        api_tx,
+    ) {
+        Ok(started) => started,
+        Err(response) => return Ok(Some(response)),
+    };
+
+    loop {
+        if client_disconnected.load(Ordering::Acquire) || !running.load(Ordering::Relaxed) {
+            return Ok(None);
+        }
+
+        match event_hub.events_after_checked(last_event_sequence) {
+            Ok(events) => {
+                for (sequence, event) in events {
+                    last_event_sequence = sequence;
+                    match event.data {
+                        EventData::PaneCommandFinished {
+                            pane_id: completed_pane_id,
+                            sequence,
+                            exit_code,
+                            managed: true,
+                            ..
+                        } if completed_pane_id == pane_id && sequence > after_sequence => {
+                            return Ok(Some(read_command_capture(
+                                &request_id,
+                                &pane_id,
+                                sequence,
+                                exit_code,
+                                api_tx,
+                            )));
+                        }
+                        EventData::PaneClosed {
+                            pane_id: closed_pane_id,
+                            ..
+                        }
+                        | EventData::PaneExited {
+                            pane_id: closed_pane_id,
+                            ..
+                        } if closed_pane_id == pane_id => {
+                            return Ok(Some(wait_error(
+                                &request_id,
+                                "pane_not_found",
+                                format!("pane {pane_id} is no longer running"),
+                            )));
+                        }
+                        EventData::PaneMoved {
+                            previous_pane_id, ..
+                        } if previous_pane_id == pane_id => {
+                            return Ok(Some(wait_error(
+                                &request_id,
+                                "pane_moved",
+                                format!("pane {pane_id} moved while running a command"),
+                            )));
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            Err(EventHistoryError::Lost) => {
+                return Ok(Some(wait_error(
+                    &request_id,
+                    "event_history_lost",
+                    "command completion history was lost before it could be observed",
+                )));
+            }
+            Err(EventHistoryError::Unavailable) => {
+                return Ok(Some(wait_error(
+                    &request_id,
+                    "server_unavailable",
+                    "event history is unavailable",
+                )));
+            }
+        }
+
+        match event_hub.wait_for_change(wake_generation, deadline) {
+            Ok(EventWaitOutcome::Changed(generation)) => wake_generation = generation,
+            Ok(EventWaitOutcome::TimedOut) => {
+                return Ok(Some(wait_error(
+                    &request_id,
+                    "timeout",
+                    "timed out waiting for OSC 133 shell command completion",
+                )));
+            }
+            Err(_) => {
+                return Ok(Some(wait_error(
+                    &request_id,
+                    "server_unavailable",
+                    "event wait is unavailable",
+                )));
+            }
+        }
+    }
+}
+
+fn start_command(
+    request_id: &str,
+    params: crate::api::schema::PaneRunCommandParams,
+    api_tx: &ApiRequestSender,
+) -> Result<(String, u64), String> {
+    let response = dispatch_to_app_with_timeout(
+        Request {
+            id: format!("{request_id}:start"),
+            method: Method::PaneRunCommandStart(params),
+        },
+        api_tx,
+        Some(APP_RESPONSE_TIMEOUT),
+    );
+    if let Some(error) = reidentify_error_response(request_id, &response) {
+        return Err(error);
+    }
+    let value = serde_json::from_str::<serde_json::Value>(&response).map_err(|_| {
+        wait_error(
+            request_id,
+            "internal_error",
+            "failed to decode shell command start response",
+        )
+    })?;
+    let pane_id = value["result"]["pane_id"].as_str().map(str::to_owned);
+    let after_sequence = value["result"]["after_sequence"].as_u64();
+    pane_id.zip(after_sequence).ok_or_else(|| {
+        wait_error(
+            request_id,
+            "internal_error",
+            "shell command start response was incomplete",
+        )
+    })
+}
+
+fn read_command_capture(
+    request_id: &str,
+    pane_id: &str,
+    sequence: u64,
+    exit_code: i32,
+    api_tx: &ApiRequestSender,
+) -> String {
+    let response = dispatch_to_app_with_timeout(
+        Request {
+            id: format!("{request_id}:capture"),
+            method: Method::PaneCommandCapture(crate::api::schema::PaneCommandCaptureParams {
+                pane_id: pane_id.to_string(),
+                sequence,
+            }),
+        },
+        api_tx,
+        Some(APP_RESPONSE_TIMEOUT),
+    );
+    let Ok(mut value) = serde_json::from_str::<serde_json::Value>(&response) else {
+        return response;
+    };
+    if value.get("error").is_some() {
+        value["id"] = serde_json::Value::String(request_id.to_string());
+        return serde_json::to_string(&value).unwrap();
+    }
+    if value["result"]["exit_code"].as_i64() != Some(i64::from(exit_code)) {
+        return wait_error(
+            request_id,
+            "command_capture_mismatch",
+            "shell completion status did not match its captured output",
+        );
+    }
+    value["id"] = serde_json::Value::String(request_id.to_string());
+    serde_json::to_string(&value).unwrap()
+}
+
+fn reidentify_error_response(request_id: &str, response: &str) -> Option<String> {
+    let Ok(mut value) = serde_json::from_str::<serde_json::Value>(response) else {
+        return Some(response.to_string());
+    };
+    value.get("error")?;
+    value["id"] = serde_json::Value::String(request_id.to_string());
+    Some(serde_json::to_string(&value).unwrap())
+}
+
+fn watch_for_connection_close(
+    stream: &LocalStream,
+    event_hub: EventHub,
+) -> std::io::Result<Arc<AtomicBool>> {
+    let mut reader = stream.try_clone()?;
+    let disconnected = Arc::new(AtomicBool::new(false));
+    let disconnected_for_reader = Arc::clone(&disconnected);
+    std::thread::spawn(move || {
+        let mut byte = [0u8; 1];
+        loop {
+            match reader.read(&mut byte) {
+                Ok(0) | Err(_) => break,
+                Ok(_) => {}
+            }
+        }
+        disconnected_for_reader.store(true, Ordering::Release);
+        event_hub.wake_all();
+    });
+    Ok(disconnected)
+}
+
+fn read_output_wait_snapshot(
+    request_id: &str,
+    params: &crate::api::schema::PaneWaitForOutputParams,
+    api_tx: &ApiRequestSender,
+) -> Result<crate::api::schema::PaneReadResult, String> {
+    let read_request = Request {
+        id: format!("{request_id}:read"),
+        method: Method::PaneRead(crate::api::schema::PaneReadParams {
+            pane_id: params.pane_id.clone(),
+            source: output_match_read_source(&params.source),
+            lines: params.lines,
+            format: crate::api::schema::ReadFormat::Text,
+            strip_ansi: params.strip_ansi,
+            intent: crate::api::schema::ReadIntent::Passive,
+        }),
+    };
+    let response = dispatch_to_app_with_timeout(read_request, api_tx, Some(APP_RESPONSE_TIMEOUT));
+    let Ok(mut value) = serde_json::from_str::<serde_json::Value>(&response) else {
+        return Err(response);
+    };
+    if value.get("error").is_some() {
+        value["id"] = serde_json::Value::String(request_id.to_string());
+        return Err(serde_json::to_string(&value).unwrap());
+    }
+    serde_json::from_value(value["result"]["read"].clone()).map_err(|_| {
+        wait_error(
+            request_id,
+            "internal_error",
+            "failed to decode pane read result",
+        )
+    })
+}
+
+fn wait_error(request_id: &str, code: &str, message: impl Into<String>) -> String {
+    serde_json::to_string(&ErrorResponse {
+        id: request_id.into(),
+        error: ErrorBody {
+            code: code.into(),
+            message: message.into(),
+        },
+    })
+    .unwrap()
+}
