+    };
+    projected.workspaces[2].branch = Some("main".into());
+    projected.workspaces[2].worktree = Some(second_repository.clone());
+    projected.workspaces[3].branch = Some("feature".into());
+    projected.workspaces[3].worktree = Some(ClientShellWorktree {
+        is_linked_worktree: true,
+        ..second_repository
+    });
+    projected.workspaces[4].branch = Some("main".into());
+    projected.workspaces[5].branch = Some("main".into());
