+#[test]
+fn repository_drilldown_tracks_focus_and_escape_without_stealing_other_modes() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(repository_drilldown_snapshot(1, true)));
+    state.set_pane_surface(surface());
+    state.workspace_scroll = 3;
+    assert!(state.enter_repository_drilldown(ClientEndpointId::Local, "repo".into()));
+
+    let mut inside = repository_drilldown_snapshot(1, false);
+    inside.revision = 2;
+    inside.focused_workspace_id = Some("ws_1".into());
+    inside.workspaces[0].focused = true;
+    state.set_snapshot(Box::new(inside));
+    assert!(state.repository_drilldown.is_some());
+
+    let mut original_outside = repository_drilldown_snapshot(1, true);
+    original_outside.revision = 3;
+    state.set_snapshot(Box::new(original_outside));
+    assert!(state.repository_drilldown.is_none());
+    assert_eq!(state.workspace_scroll, 3);
+    assert!(!state.reveal_focused_workspace);
+    assert!(!state.reveal_navigation_workspace);
+
+    assert!(state.enter_repository_drilldown(ClientEndpointId::Local, "repo".into()));
+    let escape = state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Esc,
+        KeyModifiers::empty(),
+    ))]);
+    assert!(escape.requests.is_empty());
+    assert!(escape.actions.is_empty());
+    assert!(state.repository_drilldown.is_none());
+
+    assert!(state.enter_repository_drilldown(ClientEndpointId::Local, "repo".into()));
+    state.mode = ClientShellMode::Prefix;
+    state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Esc,
+        KeyModifiers::empty(),
+    ))]);
+    assert!(state.repository_drilldown.is_some());
+    assert_eq!(state.mode, ClientShellMode::Terminal);
+
+    state.mode = ClientShellMode::Navigate;
+    state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Esc,
+        KeyModifiers::empty(),
+    ))]);
+    assert!(state.repository_drilldown.is_some());
+    assert_eq!(state.mode, ClientShellMode::Terminal);
+
+    state.mode = ClientShellMode::Copy;
+    state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Esc,
+        KeyModifiers::empty(),
+    ))]);
+    assert!(state.repository_drilldown.is_some());
+
+    state.mode = ClientShellMode::Terminal;
+    state.overlay = Some(ClientShellOverlay::GlobalMenu(ClientGlobalMenuOverlay {
+        highlighted: 0,
+    }));
+    state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Esc,
+        KeyModifiers::empty(),
+    ))]);
+    assert!(state.overlay.is_none());
+    assert!(state.repository_drilldown.is_some());
+
+    state.popup_terminal_id = Some("popup-terminal".into());
+    state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Esc,
+        KeyModifiers::empty(),
+    ))]);
+    assert!(state.repository_drilldown.is_some());
+    state.popup_terminal_id = None;
+
+    state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Esc,
+        KeyModifiers::ALT,
+    ))]);
+    assert!(state.repository_drilldown.is_some());
+}
