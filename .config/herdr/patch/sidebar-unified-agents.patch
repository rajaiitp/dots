+#[test]
+fn repository_double_click_candidate_requires_a_clean_click_lifecycle() {
+    let make_state = || {
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        state.set_snapshot(Box::new(repository_drilldown_snapshot(1, false)));
+        state.set_pane_surface(surface());
+        state.compose(106, 20).expect("repository frame");
+        let repository = state.hits.repositories[0].rect;
+        (state, repository)
+    };
+
+    let (mut modified, repository) = make_state();
+    modified.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::ALT,
+    )]);
+    assert!(modified.last_repository_click.is_none());
+
+    let (mut no_release, repository) = make_state();
+    for _ in 0..2 {
+        no_release.handle_raw_events(vec![repository_mouse(
+            repository,
+            MouseEventKind::Down(MouseButton::Left),
+            KeyModifiers::empty(),
+        )]);
+    }
+    assert!(no_release.repository_drilldown.is_none());
+
+    let (mut expired, repository) = make_state();
+    expired.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    expired.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    expired.last_repository_click.as_mut().unwrap().at =
+        std::time::Instant::now() - std::time::Duration::from_millis(400);
+    expired.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(expired.repository_drilldown.is_none());
+
+    let (mut dragged, repository) = make_state();
+    dragged.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    dragged.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Drag(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(dragged.last_repository_click.is_none());
+
+    let (mut released_away, repository) = make_state();
+    released_away.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    released_away.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind: MouseEventKind::Up(MouseButton::Left),
+        column: repository.x.saturating_add(1),
+        row: repository.y.saturating_add(3),
+        modifiers: KeyModifiers::empty(),
+    })]);
+    assert!(released_away.last_repository_click.is_none());
+
+    let (mut modified_release, repository) = make_state();
+    modified_release.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    modified_release.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::ALT,
+    )]);
+    assert!(modified_release.last_repository_click.is_none());
+
+    let (mut duplicate_release, repository) = make_state();
+    duplicate_release.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    for _ in 0..2 {
+        duplicate_release.handle_raw_events(vec![repository_mouse(
+            repository,
+            MouseEventKind::Up(MouseButton::Left),
+            KeyModifiers::empty(),
+        )]);
+    }
+    assert!(duplicate_release.last_repository_click.is_none());
+
+    let (mut wrong_button, repository) = make_state();
+    wrong_button.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    wrong_button.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Right),
+        KeyModifiers::empty(),
+    )]);
+    wrong_button.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    assert!(wrong_button.last_repository_click.is_none());
+
+    let (mut scrolled, repository) = make_state();
+    scrolled.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    scrolled.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    scrolled.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::ScrollDown,
+        KeyModifiers::empty(),
+    )]);
+    assert!(scrolled.last_repository_click.is_none());
+
+    let (mut keyed, repository) = make_state();
+    keyed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    keyed.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    keyed.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Char('x'),
+        KeyModifiers::empty(),
+    ))]);
+    assert!(keyed.last_repository_click.is_none());
+
+    let (mut unrelated, repository) = make_state();
+    unrelated.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Down(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    unrelated.handle_raw_events(vec![repository_mouse(
+        repository,
+        MouseEventKind::Up(MouseButton::Left),
+        KeyModifiers::empty(),
+    )]);
+    let pane = unrelated.hits.panes[0].rect;
+    unrelated.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: pane.x,
+        row: pane.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    assert!(unrelated.last_repository_click.is_none());
+}
