+        self.reveal_focused_workspace = false;
+        self.reveal_navigation_workspace = false;
+        self.chrome_drag = None;
+        self.workspace_press = None;
+        true
+    }
+
+    pub(super) fn exit_repository_drilldown(&mut self) -> bool {
+        let Some(drilldown) = self.repository_drilldown.take() else {
+            return false;
+        };
+        self.workspace_scroll = drilldown.overview_scroll;
+        self.pending_agent_reveal = None;
+        self.reveal_focused_workspace = false;
+        self.reveal_navigation_workspace = false;
+        self.last_repository_click = None;
+        self.chrome_drag = None;
+        self.workspace_press = None;
+        true
+    }
