 use super::*;
 
+fn focus_follows_mouse_state(enabled: bool, mouse_capture: bool) -> ClientShellState {
+    let mut config = Config::default();
+    config.ui.focus_follows_mouse = enabled;
+    config.ui.mouse_capture = mouse_capture;
+
+    let mut projected = snapshot();
+    let mut second_pane = projected.panes[0].clone();
+    second_pane.pane_id = "pane_2".into();
+    second_pane.focused = false;
+    projected.panes.push(second_pane);
+
+    let mut pane_surface = surface();
+    pane_surface.frame = FrameData::from_ratatui_buffer_with_hyperlinks(
+        &Buffer::with_lines(["ONE TWO ", "        "]),
+        None,
+        &[],
+    );
+    pane_surface.panes[0].rect.width = 4;
+    pane_surface.panes[0].inner_rect.width = 4;
+    let mut second_surface = pane_surface.panes[0].clone();
+    second_surface.pane_id = "pane_2".into();
+    second_surface.rect.x = 4;
+    second_surface.inner_rect.x = 4;
+    second_surface.focused = false;
+    pane_surface.panes.push(second_surface);
+
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(pane_surface);
+    state.compose(106, 20).expect("two-pane frame");
+    state
+}
+
+fn move_over_pane(state: &mut ClientShellState, index: usize) -> ClientShellInput {
+    let pane = state.hits.panes[index].clone();
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Moved,
+        column: pane.inner_rect.x,
+        row: pane.inner_rect.y,
+        modifiers: KeyModifiers::empty(),
+    })])
+}
+
+#[test]
+fn focus_follows_mouse_focuses_an_unfocused_pane_once() {
+    let mut state = focus_follows_mouse_state(true, true);
+
+    let first = move_over_pane(&mut state, 1);
+    assert!(matches!(
+        &first.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(
+                &request.method,
+                crate::api::schema::Method::PaneFocus(target) if target.pane_id == "pane_2"
+            )
+    ));
+
+    let repeated = move_over_pane(&mut state, 1);
+    assert!(repeated.actions.is_empty());
+}
+
+#[test]
+fn focus_follows_mouse_requires_both_settings() {
+    for (enabled, mouse_capture) in [(false, true), (true, false)] {
+        let mut state = focus_follows_mouse_state(enabled, mouse_capture);
+        assert!(move_over_pane(&mut state, 1).actions.is_empty());
+    }
+}
+
+#[test]
+fn focus_follows_mouse_ignores_non_terminal_modes_and_active_gestures() {
+    let mut navigating = focus_follows_mouse_state(true, true);
+    navigating.mode = ClientShellMode::Navigate;
+    assert!(move_over_pane(&mut navigating, 1).actions.is_empty());
+
+    let mut dragging = focus_follows_mouse_state(true, true);
+    dragging.chrome_drag = Some(ClientChromeDrag::SidebarWidth);
+    assert!(move_over_pane(&mut dragging, 1).actions.is_empty());
+}
+
+#[test]
+fn focus_follows_mouse_preserves_pane_mouse_motion() {
+    let mut state = focus_follows_mouse_state(true, true);
+    let mut surface = state.pane_surface.as_ref().expect("pane surface").clone();
+    surface.panes[1].mouse_reporting = true;
+    state.set_pane_surface(surface);
+    state.compose(106, 20).expect("mouse-reporting pane frame");
+
+    let moved = move_over_pane(&mut state, 1);
+    assert!(matches!(
+        &moved.requests[..],
+        [ClientMessage::ClientShellPaneInput { pane_id, events }]
+            if pane_id == "pane_2"
+                && matches!(
+                    &events[..],
+                    [ClientPaneInputEvent::Mouse {
+                        kind: crate::protocol::ClientMouseKind::Moved,
+                        ..
+                    }]
+                )
+    ));
+    assert!(matches!(
+        &moved.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::PaneFocus(_))
+    ));
+}
