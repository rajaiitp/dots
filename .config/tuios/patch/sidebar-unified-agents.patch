+		{"session", ui.Session}, {"branch", ui.Branch}, {"agent", ui.Agent},
+		{"dock_header", ui.DockHeader}, {"mode", ui.Mode}, {"workspace", ui.Workspace},
+		{"status", ui.Status}, {"window", ui.Window}, {"info", ui.Info},
+		{"session_control", ui.SessionControl}, {"footer", ui.Footer},
+	}
+	for _, item := range styles {
+		field := "appearance.sidebar.ui." + item.name
+		warnEnum(result, field, "align", item.style.Align, []string{"left", "center", "right"}, "left")
+		warnRange(item.name+".padding_left", item.style.PaddingLeft, 0, 12)
+		warnRange(item.name+".padding_right", item.style.PaddingRight, 0, 12)
+		warnRange(item.name+".indent", item.style.Indent, 0, 24)
+		warnRange(item.name+".bottom_offset_percent", item.style.BottomOffsetPercent, 0, 100)
+		warnColours(result, field, "The element keeps its existing colour",
+			"foreground", item.style.Foreground, "background", item.style.Background,
+			"active_foreground", item.style.ActiveForeground, "active_background", item.style.ActiveBackground)
+	}
+}
