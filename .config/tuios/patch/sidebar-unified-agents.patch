new file mode 100644
index 0000000..d1eb567
--- /dev/null
+++ w/internal/app/sidebar_agent_focus.go
@@ -0,0 +1,80 @@
+package app
+
+import "github.com/Gaurav-Gosain/tuios/internal/sessiontree"
+
+type sidebarAgentFocusKey struct {
+	machine string
+	session string
+}
+
+type sidebarAgentFocusState struct {
+	windows    map[sidebarAgentFocusKey]string
+	generation uint64
+}
+
+func (s *sidebarAgentFocusState) remember(key sidebarAgentFocusKey, windowID string) {
+	if s.windows[key] == windowID {
+		return
+	}
+	if windowID == "" {
+		delete(s.windows, key)
+	} else {
+		if s.windows == nil {
+			s.windows = make(map[sidebarAgentFocusKey]string)
+		}
+		s.windows[key] = windowID
+	}
+	s.generation++
+}
+
+func (m *OS) sidebarAgentFocusKey(sessionID string) sidebarAgentFocusKey {
+	return sidebarAgentFocusKey{machine: m.attachedMachine(), session: sessionID}
+}
+
+func (m *OS) rememberFocusedSidebarAgent() {
+	w := m.GetFocusedWindow()
+	if !m.agentsOn() || w == nil || w.AgentState == "" || isScratch(w) {
+		return
+	}
+	sessionID := m.SessionName
+	if sessionID == "" {
+		sessionID = "local"
+	}
+	m.sidebarAgentFocus.remember(m.sidebarAgentFocusKey(sessionID), w.ID)
+}
+
+func (m *OS) reconcileSidebarAgentFocus(sessions []sessiontree.Node) {
+	machine := m.attachedMachine()
+	known := make(map[string]bool, len(sessions))
+	for _, node := range sessions {
+		if node.Kind != sessiontree.KindSession || node.Host != "" {
+			continue
+		}
+		known[node.ID] = true
+		key := m.sidebarAgentFocusKey(node.ID)
+		remembered := m.sidebarAgentFocus.windows[key]
+		found := false
+		for _, win := range node.Children {
+			if win.AgentState == "" {
+				continue
+			}
+			if node.IsCurrent && win.IsCurrent {
+				m.sidebarAgentFocus.remember(key, win.ID)
+				remembered = win.ID
+			}
+			found = found || win.ID == remembered
+		}
+		if node.Children != nil && !found {
+			m.sidebarAgentFocus.remember(key, "")
+		}
+	}
+	for key := range m.sidebarAgentFocus.windows {
+		if key.machine == machine && !known[key.session] {
+			m.sidebarAgentFocus.remember(key, "")
+		}
+	}
+}
+
+func (m *OS) sidebarAgentWasLastFocused(e sidebarAgentEntry) bool {
+	return e.Host == "" && e.WindowID != "" && m.sidebarAgentFocus.windows[m.sidebarAgentFocusKey(e.SessionID)] == e.WindowID
+}
