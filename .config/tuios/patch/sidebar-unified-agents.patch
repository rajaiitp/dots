diff --git i/internal/app/sidebar_checkout.go w/internal/app/sidebar_checkout.go
new file mode 100644
index 0000000..a39be81
--- /dev/null
+++ w/internal/app/sidebar_checkout.go
@@ -0,0 +1,174 @@
+package app
+
+import (
+	"path/filepath"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/gitstate"
+	"github.com/Gaurav-Gosain/tuios/internal/session"
+	"github.com/Gaurav-Gosain/tuios/internal/sessiontree"
+)
+
+const sidebarCheckoutRefreshInterval = 2 * time.Second
+
+type sidebarCheckoutKey struct {
+	machine string
+	session string
+}
+
+type sidebarCheckout struct {
+	dir     string
+	root    string
+	repo    string
+	branch  string
+	askedAt time.Time
+	pending bool
+}
+
+type sidebarCheckoutState struct {
+	entries    map[sidebarCheckoutKey]sidebarCheckout
+	generation uint64
+}
+
+type sidebarCheckoutMsg struct {
+	key    sidebarCheckoutKey
+	dir    string
+	root   string
+	repo   string
+	branch string
+}
+
+func (m *OS) sidebarCheckoutKey(name string) sidebarCheckoutKey {
+	if name == "" {
+		name = "local"
+	}
+	return sidebarCheckoutKey{machine: m.attachedMachine(), session: name}
+}
+
+func (m *OS) rememberSidebarCheckout(name, dir string) {
+	if m.AttachedHost != "" || dir == "" || !filepath.IsAbs(dir) {
+		return
+	}
+	key := m.sidebarCheckoutKey(name)
+	if _, exists := m.sidebarCheckouts.entries[key]; exists {
+		return
+	}
+	if m.sidebarCheckouts.entries == nil {
+		m.sidebarCheckouts.entries = make(map[sidebarCheckoutKey]sidebarCheckout)
+	}
+	m.sidebarCheckouts.entries[key] = sidebarCheckout{dir: filepath.Clean(dir)}
+	m.sidebarCheckouts.generation++
+}
+
+func (m *OS) adoptSidebarCheckout(state *session.SessionState) {
+	if state.Global || m.AttachedHost != "" {
+		return
+	}
+	if state.Worktree != nil && state.Worktree.Path != "" {
+		m.rememberSidebarCheckout(state.Name, state.Worktree.Path)
+		return
+	}
+	if state.StartDir != "" {
+		m.rememberSidebarCheckout(state.Name, state.StartDir)
+		return
+	}
+	for _, w := range state.Windows {
+		if w.Scratch || w.Host != "" || w.CwdHost != "" {
+			continue
+		}
+		dir := w.StartDir
+		if dir == "" {
+			dir = w.Cwd
+		}
+		if dir != "" {
+			m.rememberSidebarCheckout(state.Name, dir)
+			return
+		}
+	}
+}
+
+func (m *OS) sidebarCheckoutEnabled() bool {
+	return m.AttachedHost == "" && (m.Settings.SidebarEnabled || m.sidebarDrawing) &&
+		(sidebarLayoutHas(sidebarSectionOverview, &m.Settings) || sidebarLayoutHas(sidebarSectionSessions, &m.Settings))
+}
+
+func (m *OS) sidebarCheckoutSyncCmd() tea.Cmd {
+	if !m.sidebarCheckoutEnabled() {
+		return nil
+	}
+	if m.DaemonClient != nil {
+		known := map[string]bool{m.sidebarCheckoutKey(m.SessionName).session: true}
+		for _, info := range m.DaemonClient.CachedSessions() {
+			known[info.Name] = true
+			if !info.Global && info.Worktree != nil {
+				m.rememberSidebarCheckout(info.Name, info.Worktree.Path)
+			}
+		}
+		for key := range m.sidebarCheckouts.entries {
+			if key.machine == m.attachedMachine() && !known[key.session] {
+				delete(m.sidebarCheckouts.entries, key)
+				m.sidebarCheckouts.generation++
+			}
+		}
+	}
+	if !m.SessionGlobal {
+		for _, w := range m.Windows {
+			if w != nil && !isScratch(w) && m.paneIsLocal(w) && w.CwdHost == "" && w.Cwd != "" {
+				key := m.sidebarCheckoutKey(m.SessionName)
+				if entry, exists := m.sidebarCheckouts.entries[key]; exists && entry.root == "" && !entry.pending && !entry.askedAt.IsZero() && entry.dir != filepath.Clean(w.Cwd) {
+					delete(m.sidebarCheckouts.entries, key)
+				}
+				m.rememberSidebarCheckout(m.SessionName, w.Cwd)
+				break
+			}
+		}
+	}
+	var cmds []tea.Cmd
+	for key, entry := range m.sidebarCheckouts.entries {
+		if key.machine != m.attachedMachine() || entry.pending || time.Since(entry.askedAt) < sidebarCheckoutRefreshInterval {
+			continue
+		}
+		entry.pending, entry.askedAt = true, time.Now()
+		m.sidebarCheckouts.entries[key] = entry
+		cmds = append(cmds, func() tea.Msg { return readSidebarCheckout(key, entry.dir) })
+	}
+	return tea.Batch(cmds...)
+}
+
+func readSidebarCheckout(key sidebarCheckoutKey, dir string) sidebarCheckoutMsg {
+	msg := sidebarCheckoutMsg{key: key, dir: dir}
+	_, common, root, found := gitstate.Locate(dir)
+	if found {
+		msg.root = root
+		msg.repo = filepath.Base(filepath.Dir(common))
+		msg.branch = gitstate.Branch(root)
+	}
+	return msg
+}
+
+func (m *OS) applySidebarCheckout(msg sidebarCheckoutMsg) {
+	entry, exists := m.sidebarCheckouts.entries[msg.key]
+	if !exists || entry.dir != msg.dir {
+		return
+	}
+	entry.pending = false
+	if entry.root != msg.root || entry.repo != msg.repo || entry.branch != msg.branch {
+		m.sidebarCheckouts.generation++
+	}
+	entry.root, entry.repo, entry.branch = msg.root, msg.repo, msg.branch
+	m.sidebarCheckouts.entries[msg.key] = entry
+}
+
+func (m *OS) sidebarCheckoutPlace(name string) (sidebarCheckout, bool) {
+	entry, exists := m.sidebarCheckouts.entries[m.sidebarCheckoutKey(name)]
+	return entry, exists
+}
+
+func (m *OS) sidebarCheckoutWorktree(name string, info *session.WorktreeInfo) *sessiontree.WorktreeRef {
+	ref := worktreeRef(info)
+	if checkout, known := m.sidebarCheckoutPlace(name); ref != nil && known {
+		ref.Branch = checkout.branch
+	}
+	return ref
+}
diff --git i/internal/app/sidebar_checkout_test.go w/internal/app/sidebar_checkout_test.go
new file mode 100644
index 0000000..93ea150
--- /dev/null
+++ w/internal/app/sidebar_checkout_test.go
@@ -0,0 +1,176 @@
+package app
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/session"
+	"github.com/Gaurav-Gosain/tuios/internal/sessiontree"
+)
+
+func sidebarCheckoutRepo(t *testing.T, branch string) string {
+	t.Helper()
+	root := filepath.Join(t.TempDir(), "checkout")
+	if err := os.MkdirAll(filepath.Join(root, ".git"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	setSidebarCheckoutBranch(t, filepath.Join(root, ".git"), branch)
+	return root
+}
+
+func setSidebarCheckoutBranch(t *testing.T, gitdir, branch string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(gitdir, "HEAD"), []byte("ref: refs/heads/"+branch+"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func runSidebarCheckoutCmd(t *testing.T, m *OS, cmd tea.Cmd) {
+	t.Helper()
+	if cmd == nil {
+		t.Fatal("checkout refresh was not scheduled")
+	}
+	switch msg := cmd().(type) {
+	case sidebarCheckoutMsg:
+		m.applySidebarCheckout(msg)
+	case tea.BatchMsg:
+		for _, child := range msg {
+			runSidebarCheckoutCmd(t, m, child)
+		}
+	default:
+		t.Fatalf("unexpected checkout message %T", msg)
+	}
+}
+
+func TestSidebarCheckoutIgnoresPaneFocusAndStaleBranches(t *testing.T) {
+	root := sidebarCheckoutRepo(t, "main")
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+	m.adoptSidebarCheckout(&session.SessionState{Name: m.SessionName, StartDir: root})
+	if _, branch := m.sessionPlace(m.SessionName); branch != "" {
+		t.Fatalf("unresolved checkout used stale branch %q", branch)
+	}
+	runSidebarCheckoutCmd(t, m, m.sidebarCheckoutSyncCmd())
+	for i := range m.Windows {
+		m.FocusedWindow = i
+		tree.Sessions[0].Branch = []string{"mac", "main", "stale"}[i]
+		if _, branch := m.sessionPlace(m.SessionName); branch != "main" {
+			t.Fatalf("pane %d changed checkout branch to %q", i, branch)
+		}
+		if cmd := m.sidebarCheckoutSyncCmd(); cmd != nil {
+			t.Fatal("pane focus forced another checkout read")
+		}
+		for _, node := range m.sidebarOverviewSessionRows(tree.Sessions) {
+			if node.Kind == sessiontree.KindSession && node.ID == m.SessionName {
+				if node.Worktree == nil || node.Worktree.Branch != "main" || node.Worktree.Repo != "checkout" {
+					t.Fatalf("pane %d changed the worktree identity: %+v", i, node.Worktree)
+				}
+			}
+		}
+	}
+	before := m.sidebarSignature()
+	setSidebarCheckoutBranch(t, filepath.Join(root, ".git"), "release")
+	key := m.sidebarCheckoutKey(m.SessionName)
+	entry := m.sidebarCheckouts.entries[key]
+	entry.askedAt = time.Time{}
+	m.sidebarCheckouts.entries[key] = entry
+	runSidebarCheckoutCmd(t, m, m.sidebarCheckoutSyncCmd())
+	if _, branch := m.sessionPlace(m.SessionName); branch != "release" {
+		t.Fatalf("actual HEAD change was not reflected: %q", branch)
+	}
+	if before == m.sidebarSignature() {
+		t.Fatal("HEAD change did not invalidate sidebar rendering")
+	}
+}
+
+func TestSidebarCheckoutUsesStableWindowStartDirectory(t *testing.T) {
+	root := sidebarCheckoutRepo(t, "main")
+	other := sidebarCheckoutRepo(t, "mac")
+	m, _ := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+	state := &session.SessionState{Name: m.SessionName, Windows: []session.WindowState{
+		{ID: "first", StartDir: root, Cwd: other},
+		{ID: "second", StartDir: other, Cwd: other},
+	}}
+	m.adoptSidebarCheckout(state)
+	runSidebarCheckoutCmd(t, m, m.sidebarCheckoutSyncCmd())
+	state.Windows = state.Windows[1:]
+	m.adoptSidebarCheckout(state)
+	if entry, _ := m.sidebarCheckoutPlace(m.SessionName); entry.dir != root || entry.branch != "main" {
+		t.Fatalf("closing or moving a pane changed the checkout: %+v", entry)
+	}
+}
+
+func TestSidebarCheckoutReadsLinkedWorktreeHeadWithoutMutatingMetadata(t *testing.T) {
+	root := sidebarCheckoutRepo(t, "main")
+	linked := t.TempDir()
+	gitdir := filepath.Join(root, ".git", "worktrees", "feature")
+	if err := os.MkdirAll(gitdir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for path, content := range map[string]string{
+		filepath.Join(linked, ".git"):      "gitdir: " + gitdir,
+		filepath.Join(gitdir, "commondir"): "../..",
+	} {
+		if err := os.WriteFile(path, []byte(content+"\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	setSidebarCheckoutBranch(t, gitdir, "feature")
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+	info := &session.WorktreeInfo{}
+	info.Path = linked
+	m.adoptSidebarCheckout(&session.SessionState{Name: m.SessionName, Worktree: info})
+	runSidebarCheckoutCmd(t, m, m.sidebarCheckoutSyncCmd())
+	ref := &sessiontree.WorktreeRef{Repo: "checkout", Branch: "stale", Path: linked}
+	tree.Sessions[0].Worktree = ref
+	for _, node := range m.sidebarOverviewSessionRows(tree.Sessions) {
+		if node.Kind == sessiontree.KindSession && node.ID == m.SessionName && node.Worktree.Branch != "feature" {
+			t.Fatalf("linked worktree used another checkout's branch: %+v", node.Worktree)
+		}
+	}
+	if ref.Branch != "stale" {
+		t.Fatal("display refresh mutated managed worktree metadata")
+	}
+	info.Branch = "stale"
+	m.SessionWorktree = info
+	if got := m.currentSessionInput().Worktree.Branch; got != "feature" || info.Branch != "stale" {
+		t.Fatalf("session tree branch = %q, daemon metadata = %q", got, info.Branch)
+	}
+}
+
+func TestSidebarCheckoutRejectsRemoteAndStaleResults(t *testing.T) {
+	root := sidebarCheckoutRepo(t, "main")
+	m, _ := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+	m.AttachedHost = "remote"
+	m.adoptSidebarCheckout(&session.SessionState{Name: m.SessionName, StartDir: root})
+	if len(m.sidebarCheckouts.entries) != 0 || m.sidebarCheckoutSyncCmd() != nil {
+		t.Fatal("remote daemon paths were read on this machine")
+	}
+	m.AttachedHost = ""
+	m.adoptSidebarCheckout(&session.SessionState{Name: m.SessionName, StartDir: root})
+	cmd := m.sidebarCheckoutSyncCmd()
+	if m.sidebarCheckoutSyncCmd() != nil {
+		t.Fatal("duplicate checkout read was scheduled while pending")
+	}
+	key := m.sidebarCheckoutKey(m.SessionName)
+	m.applySidebarCheckout(sidebarCheckoutMsg{key: key, dir: root + "/old", branch: "wrong"})
+	if entry, _ := m.sidebarCheckoutPlace(m.SessionName); entry.branch != "" {
+		t.Fatal("stale result overwrote the current checkout")
+	}
+	runSidebarCheckoutCmd(t, m, cmd)
+	var due time.Time
+	m.railReadsDue(func(at time.Time) { due = at })
+	if want := m.sidebarCheckouts.entries[key].askedAt.Add(sidebarCheckoutRefreshInterval); !due.Equal(want) {
+		t.Fatalf("checkout refresh deadline = %s, want %s", due, want)
+	}
+	m.Settings.SidebarEnabled = false
+	if m.sidebarCheckoutSyncCmd() != nil {
+		t.Fatal("hidden sidebar kept polling")
+	}
+}
diff --git i/internal/app/sidebar_custom.go w/internal/app/sidebar_custom.go
