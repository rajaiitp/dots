+
+func TestOverviewRailNestsAgentsWithoutTerminalContext(t *testing.T) {
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+
+	lines := railPlain(t, m, tree)
+	joined := strings.Join(lines, "\n")
+	for _, want := range []string{"overview", "main", "refactor", "build", "api", "server", "docs"} {
+		if !strings.Contains(joined, want) {
+			t.Fatalf("overview rail does not contain %q:\n%s", want, joined)
+		}
+	}
+	if strings.Contains(joined, "nvim") {
+		t.Fatalf("overview rail exposed a non-agent terminal:\n%s", joined)
+	}
+	for _, pair := range [][2]string{{"main", "refactor"}, {"main", "build"}, {"api", "server"}} {
+		parent, child := lineOf(lines, pair[0]), lineOf(lines, pair[1])
+		if parent < 0 || child <= parent {
+			t.Fatalf("%q is not nested after %q:\n%s", pair[1], pair[0], joined)
+		}
+		parentCol := lipgloss.Width(lines[parent][:strings.Index(lines[parent], pair[0])])
+		childCol := lipgloss.Width(lines[child][:strings.Index(lines[child], pair[1])])
+		if childCol-parentCol != sidebarGroupIndent {
+			t.Fatalf("%q starts at column %d under %q at %d, want one %d-cell hierarchy step:\n%s",
+				pair[1], childCol, pair[0], parentCol, sidebarGroupIndent, joined)
+		}
+	}
+	if lineOf(lines, "server") >= lineOf(lines, "docs") {
+		t.Fatalf("api's agent escaped its session group:\n%s", joined)
+	}
+
+	seen := map[string]bool{}
+	for _, hit := range m.SidebarHits {
+		if hit.Kind == sidebarRowWindow {
+			t.Fatalf("overview published terminal hit %+v", hit)
+		}
+		if hit.Kind == sidebarRowAgent {
+			seen[hit.WindowID] = true
+		}
+	}
+	for _, id := range []string{"bbbbbbbb2222", "cccccccc3333", "dddddddd4444"} {
+		if !seen[id] {
+			t.Errorf("overview did not publish a pane hit for %s", id)
+		}
+	}
+}
+
+func TestOverviewSessionsUseFlatPresentation(t *testing.T) {
+	for _, rowStyle := range config.RailRowStyles {
+		t.Run(rowStyle, func(t *testing.T) {
+			m, tree := sectionsTestOS(t, 120, 40)
+			m.Settings.SidebarSections = "overview"
+			m.Settings.RailRowStyle = rowStyle
+
+			styled := railStyled(t, m, tree)
+			plain := make([]string, len(styled))
+			for i, line := range styled {
+				plain[i] = stripANSIForTrace(line)
+			}
+			main := plain[lineOf(plain, "main")]
+			api := plain[lineOf(plain, "api")]
+			if prefix := main[:strings.Index(main, "main")]; prefix != m.Settings.GetRailFocusMark()+"  " {
+				t.Fatalf("current session prefix = %q, want only the active vertical gutter", prefix)
+			}
+			if prefix := api[:strings.Index(api, "api")]; prefix != "   " {
+				t.Fatalf("inactive session prefix = %q, want a blank gutter and glyph cell", prefix)
+			}
+			joined := strings.Join(plain, "\n")
+			for _, connector := range []string{m.Settings.GetRailTreeBranch(), m.Settings.GetRailTreeLast()} {
+				if strings.Contains(joined, connector) {
+					t.Fatalf("overview retained tree connector %q:\n%s", connector, joined)
+				}
+			}
+
+			activeRow := styledRow(t, styled, "main")
+			width := lipgloss.Width(activeRow) - 1
+			canvas := uv.NewScreenBuffer(width, 1)
+			uv.NewStyledString(activeRow).Draw(canvas, canvas.Bounds())
+			nameCol := lipgloss.Width(main[:strings.Index(main, "main")])
+			for x := nameCol; x < nameCol+lipgloss.Width("main"); x++ {
+				cell := canvas.CellAt(x, 0)
+				if cell == nil || cell.Style.Attrs&uv.AttrBold != 0 {
+					t.Fatalf("active session name cell %d is bold; emphasis belongs to its repository heading: %+v", x, cell)
+				}
+			}
+		})
+	}
+}
+
+func assertOverviewRepositoryNameStyle(t *testing.T, m *OS, tree sessiontree.Tree, name string, active bool) {
+	t.Helper()
+	row := styledRow(t, railStyled(t, m, tree), name)
+	plain := stripANSIForTrace(row)
+	nameCol := lipgloss.Width(plain[:strings.Index(plain, name)])
+	width := lipgloss.Width(row) - 1
+	canvas := uv.NewScreenBuffer(width, 1)
+	uv.NewStyledString(row).Draw(canvas, canvas.Bounds())
+	pal := m.groundUI()
+	wantFg := pal.FgDim
+	if active {
+		wantFg = theme.Readable(pal.Accent, m.railGround())
+	}
+	for x := nameCol; x < nameCol+lipgloss.Width(name); x++ {
+		cell := canvas.CellAt(x, 0)
+		if cell == nil {
+			t.Fatalf("repository name cell %d is missing", x)
+		}
+		if got := cell.Style.Attrs&uv.AttrBold != 0; got != active {
+			t.Fatalf("repository %q bold = %t, want %t: %+v", name, got, active, cell.Style)
+		}
+		if !samePaneColor(cell.Style.Fg, wantFg) {
+			t.Fatalf("repository %q foreground = %v, want %v", name, cell.Style.Fg, wantFg)
+		}
+	}
+}
+
+func TestOverviewActiveRepositoryKeepsTextHighlightAtANSI16(t *testing.T) {
+	was := theme.ColorProfile()
