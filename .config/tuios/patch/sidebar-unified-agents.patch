+func TestSidebarUIStylesUpdateFromConfigWithoutRebuilding(t *testing.T) {
+	m, _ := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview,dock"
+	m.Settings.DockWorkspaceTabs = true
+
+	apply := func(toml string) ([]string, []sidebarDockZone) {
+		t.Helper()
+		cfg, err := config.ParseUserConfig([]byte(toml))
+		if err != nil {
+			t.Fatal(err)
+		}
+		m.UserConfig = cfg
+		return m.sidebarDockFooter(24, 0, m.groundUI(), -1, -1)
+	}
+	lines, zones := apply(`
+[appearance.sidebar.ui.workspace]
+align = "center"
+active_background = "red"
+full_width = true
+padding_left = 1
+padding_right = 1
+`)
+	currentLine := -1
+	for _, zone := range zones {
+		if zone.Kind == sidebarRowDockWorkspace && zone.WindowIndex == m.CurrentWorkspace {
+			currentLine = zone.Line
+			break
+		}
+	}
+	if currentLine < 0 {
+		t.Fatal("current workspace row was not drawn")
+	}
+	centered := stripANSIForTrace(lines[currentLine])
+	centerCol := strings.Index(centered, m.workspacePillLabel(m.CurrentWorkspace))
+	canvas := uv.NewScreenBuffer(24, 1)
+	uv.NewStyledString(lines[currentLine]).Draw(canvas, canvas.Bounds())
+	pal := m.groundUI()
+	wantRed := theme.ConfigColorOn("red", &pal)
+	if cell := canvas.CellAt(23, 0); cell == nil || !samePaneColor(cell.Style.Bg, wantRed) {
+		t.Fatalf("hot style background = %+v, want red", cell)
+	}
+
+	lines, zones = apply(`
+[appearance.sidebar.ui.workspace]
+align = "right"
+active_background = "green"
+full_width = true
+padding_left = 1
+padding_right = 1
+`)
+	for _, zone := range zones {
+		if zone.Kind == sidebarRowDockWorkspace && zone.WindowIndex == m.CurrentWorkspace {
+			currentLine = zone.Line
+			break
+		}
+	}
+	right := stripANSIForTrace(lines[currentLine])
+	rightCol := strings.Index(right, m.workspacePillLabel(m.CurrentWorkspace))
+	if rightCol <= centerCol {
+		t.Fatalf("workspace label column did not move right after live config update: center=%d right=%d", centerCol, rightCol)
+	}
+	canvas = uv.NewScreenBuffer(24, 1)
+	uv.NewStyledString(lines[currentLine]).Draw(canvas, canvas.Bounds())
+	pal = m.groundUI()
+	wantGreen := theme.ConfigColorOn("green", &pal)
+	if cell := canvas.CellAt(23, 0); cell == nil || !samePaneColor(cell.Style.Bg, wantGreen) {
+		t.Fatalf("updated hot style background = %+v, want green", cell)
+	}
+}
