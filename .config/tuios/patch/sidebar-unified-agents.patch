+	}
+	for sessionID, want := range map[string]string{"main": "cccccccc3333", "api": "dddddddd4444"} {
+		if got := m.sidebarAgentFocus.windows[m.sidebarAgentFocusKey(sessionID)]; got != want {
+			t.Fatalf("%s remembers %q, want %q", sessionID, got, want)
+		}
+	}
+	if m.sidebarAgentWasLastFocused(sidebarAgentEntry{SessionID: "main", WindowID: "bbbbbbbb2222"}) {
+		t.Fatal("two agents in one subtree are remembered")
+	}
+	if m.sidebarAgentWasLastFocused(sidebarAgentEntry{Host: "other", SessionID: "main", WindowID: "cccccccc3333"}) {
+		t.Fatal("a remote session reused this machine's memory")
+	}
+
+	// An agent that closes or stops being an agent must not retain the mark.
+	tree.Sessions[0].Children[2].AgentState = ""
+	m.agentEntries(tree.Sessions)
+	if got := m.sidebarAgentFocus.windows[m.sidebarAgentFocusKey("main")]; got != "" {
+		t.Fatalf("stopped agent retained its mark: %q", got)
+	}
+	m.agentEntries(tree.Sessions[:1])
+	if len(m.sidebarAgentFocus.windows) != 0 {
+		t.Fatalf("removed session retained memory: %v", m.sidebarAgentFocus.windows)
+	}
+}
+
+func TestOverviewFocusMemorySurvivesHiddenRailsAndInvalidatesCache(t *testing.T) {
+	m, _ := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "sessions"
+	m.FocusedWindow = 1
+	m.focusReportedID = m.Windows[1].ID
+	before := m.sidebarSignature()
+	m.reportFocusChange()
+	if !m.sidebarAgentWasLastFocused(sidebarAgentEntry{SessionID: "main", WindowID: m.Windows[1].ID}) {
+		t.Fatal("focus on an already-focused agent was not remembered with overview hidden")
+	}
+	after := m.sidebarSignature()
+	if before == after {
+		t.Fatal("focus memory did not invalidate the sidebar signature")
+	}
+	m.reportFocusChange()
+	if after != m.sidebarSignature() {
+		t.Fatal("unchanged focus invalidated the signature again")
+	}
+	m.FocusedWindow = 0
+	m.focusReportedID = m.Windows[0].ID
+	m.reportFocusChange()
+	if !m.sidebarAgentWasLastFocused(sidebarAgentEntry{SessionID: "main", WindowID: m.Windows[1].ID}) {
+		t.Fatal("focusing a shell forgot the last agent")
+	}
+}
+
+func TestOverviewFocusMemoryKeepsUnknownAndOtherMachineSessions(t *testing.T) {
+	m, tree := sectionsTestOS(t, 120, 40)
+	local := m.sidebarAgentFocusKey("api")
+	other := sidebarAgentFocusKey{machine: "other", session: "api"}
+	m.sidebarAgentFocus.remember(local, "dddddddd4444")
+	m.sidebarAgentFocus.remember(other, "remote-window")
+	tree.Sessions[1].Children = nil
+	m.reconcileSidebarAgentFocus(tree.Sessions)
+	if m.sidebarAgentFocus.windows[local] != "dddddddd4444" || m.sidebarAgentFocus.windows[other] != "remote-window" {
+		t.Fatalf("unknown children or another machine lost memory: %v", m.sidebarAgentFocus.windows)
+	}
+	tree.Sessions[1].Children = []sessiontree.Node{}
+	m.reconcileSidebarAgentFocus(tree.Sessions)
+	if m.sidebarAgentFocus.windows[local] != "" || m.sidebarAgentFocus.windows[other] != "remote-window" {
+		t.Fatalf("empty session cleanup crossed machines: %v", m.sidebarAgentFocus.windows)
+	}
+}
+
+func overviewStyleConfig(t *testing.T, m *OS) {
+	t.Helper()
+	cfg, err := config.ParseUserConfig([]byte(`
+[appearance.sidebar.ui.repository]
+active_background = "surface"
+[appearance.sidebar.ui.branch]
+active_background = "surface"
+[appearance.sidebar.ui.agent]
+active_background = "surface"
+active_foreground = "accent"
+active_bold = true
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.UserConfig = cfg
+}
+
+func overviewRowCanvas(row string) uv.ScreenBuffer {
+	canvas := uv.NewScreenBuffer(lipgloss.Width(row), 1)
+	uv.NewStyledString(row).Draw(canvas, canvas.Bounds())
+	return canvas
+}
+
+func TestOverviewActiveSubtreeBackgroundIncludesEveryAgent(t *testing.T) {
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+	overviewStyleConfig(t, m)
+	for i := range 2 {
+		tree.Sessions[i].Worktree = &sessiontree.WorktreeRef{Repo: "project", Branch: tree.Sessions[i].ID}
+	}
+	pal := m.groundUI()
+	for _, focused := range []string{"aaaaaaaa1111", "bbbbbbbb2222", "cccccccc3333"} {
+		focusOverviewSession(&tree, "main", focused)
+		styled := railStyled(t, m, tree)
+		for _, title := range []string{"project", "main", "refactor", "build"} {
+			row := styledRow(t, styled, title)
+			canvas := overviewRowCanvas(row)
+			for x := range lipgloss.Width(row) - 1 {
+				if cell := canvas.CellAt(x, 0); cell == nil || !samePaneColor(cell.Style.Bg, pal.Surface) {
+					t.Fatalf("%s with focus %s has an unfilled cell at %d", title, focused, x)
+				}
+			}
+		}
+		for _, title := range []string{"api", "server"} {
+			canvas := overviewRowCanvas(styledRow(t, styled, title))
+			if samePaneColor(canvas.CellAt(0, 0).Style.Bg, pal.Surface) {
+				t.Fatalf("inactive subtree %s inherited the current subtree's background", title)
+			}
+		}
+	}
+}
+
+func TestOverviewRememberedAgentTextFollowsAccentWithoutFocusGutter(t *testing.T) {
+	m, _ := sectionsTestOS(t, 120, 40)
+	overviewStyleConfig(t, m)
+	e := sidebarAgentEntry{SessionID: "api", WindowID: "dddddddd4444", Title: "server", State: "idle", Foreign: true}
+	m.sidebarAgentFocus.remember(m.sidebarAgentFocusKey(e.SessionID), e.WindowID)
+	for _, accent := range []color.Color{color.RGBA{R: 125, G: 174, B: 163, A: 255}, color.RGBA{R: 245, G: 190, B: 90, A: 255}} {
+		pal := m.groundUI()
+		pal.Accent = accent
+		paint := activeDockTabPaint(&config.DockTabsConfig{ActiveBg: "accent"}, pal)
+		if !samePaneColor(paint.bg, accent) {
+			t.Fatal("tab did not resolve the theme accent")
+		}
+		for _, st := range []sidebarRowState{{}, {Hover: true}, {Cursor: true, Focused: true}} {
+			row := m.sidebarOverviewAgentRow(e, 2, 30, pal, st)
+			canvas := overviewRowCanvas(row)
+			plain := stripANSIForTrace(row)
+			col := lipgloss.Width(plain[:strings.Index(plain, e.Title)])
+			cell := canvas.CellAt(col, 0)
+			if !samePaneColor(cell.Style.Fg, paint.bg) || cell.Style.Attrs&uv.AttrBold == 0 {
+				t.Fatalf("remembered agent text lost accent/bold: %+v", cell.Style)
+			}
+			if canvas.CellAt(0, 0).Content != " " {
+				t.Fatal("remembered agent claimed the actual-focus gutter")
+			}
+			if !st.lit() && canvas.CellAt(0, 0).Style.Bg != nil {
+				t.Fatal("remembered agent filled an inactive subtree")
+			}
+		}
+	}
+}
