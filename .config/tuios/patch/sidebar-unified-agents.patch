+func TestOverviewGroupsStandaloneCheckoutAsRepositoryBranchAgent(t *testing.T) {
+	m, _ := worktreeRailOS(t, 120, 30)
+	m.SessionName = "calculator"
+	m.Settings.SidebarSections = "overview"
+	tree := sessiontree.Build([]sessiontree.SessionInput{{
+		Name: "calculator", Branch: "master", Attached: true, IsCurrent: true, CurrentWorkspace: 1,
+		Windows: []sessiontree.WindowInput{{
+			ID: "aaaaaaaa1111", Title: "pi", AgentState: "idle", Focused: true, Workspace: 1,
+		}},
+	}})
+
+	lines := railPlain(t, m, tree)
+	repoLine, repoHit := railRowLine(t, m, lines, sidebarRowRepo, "calculator")
+	branchLine, branchHit := railRowLine(t, m, lines, sidebarRowSession, "calculator")
+	agentLine, agentHit := railRowLine(t, m, lines, sidebarRowAgent, "calculator")
+	row := func(hit sidebarRowHit) int { return hit.Y0 - m.GetTopMargin() }
+	if !(row(repoHit) < row(branchHit) && row(branchHit) < row(agentHit)) {
+		t.Fatalf("standalone checkout hierarchy is out of order:\n%s", strings.Join(lines, "\n"))
+	}
+	col := func(line, label string) int {
+		return lipgloss.Width(line[:strings.Index(line, label)])
+	}
+	repoCol := col(repoLine, "calculator")
+	branchCol := col(branchLine, "master")
+	agentCol := col(agentLine, "pi")
+	if branchCol-repoCol != sidebarGroupIndent || agentCol-branchCol != sidebarGroupIndent {
+		t.Fatalf("standalone columns repository=%d branch=%d agent=%d, want one hierarchy step each:\n%s",
+			repoCol, branchCol, agentCol, strings.Join(lines, "\n"))
+	}
+	for _, connector := range []string{m.Settings.GetRailTreeBranch(), m.Settings.GetRailTreeLast()} {
+		if strings.Contains(strings.Join(lines, "\n"), connector) {
+			t.Fatalf("standalone overview retained tree connector %q:\n%s", connector, strings.Join(lines, "\n"))
+		}
+	}
+	if tree.Sessions[0].Worktree != nil {
+		t.Fatal("overview grouping changed a standalone primary checkout into a linked worktree")
+	}
+	assertOverviewRepositoryNameStyle(t, m, tree, "calculator", true)
+}
