@@ -0,0 +1,57 @@
+package tuie2e
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Gaurav-Gosain/tuitest"
+)
+
+func TestSidebarCheckoutTracksHeadWithoutFollowingPaneCaches(t *testing.T) {
+	base := t.TempDir()
+	repo := filepath.Join(base, "checkout")
+	if out, err := exec.Command("git", "init", "--initial-branch=mac", repo).CombinedOutput(); err != nil {
+		t.Fatalf("initialize checkout: %v\n%s", err, out)
+	}
+	writeConfig(t, base, `[appearance.sidebar]
+enabled = true
+width = 24
+sections = "overview"
+`)
+	const name = "checkout-e2e"
+	term := startIn(t, base, startOpts{cols: 120, rows: 40, args: []string{"new", name, "--cwd", repo}})
+	waitBoot(t, term)
+	newWindow(t, term)
+	waitWindowCount(t, term, 1, "first pane")
+	waitBranch := func(branch string) {
+		t.Helper()
+		if err := term.WaitFor(func(s tuitest.Screen) bool {
+			_, rows := s.Size()
+			for y := range rows {
+				line := []rune(s.Line(y))
+				if strings.Contains(string(line[:min(24, len(line))]), branch) {
+					return true
+				}
+			}
+			return false
+		}, uiTimeout); err != nil {
+			t.Fatalf("sidebar did not show branch %s: %v\n%s", branch, err, term.Snapshot())
+		}
+	}
+	waitBranch("mac")
+	if err := os.WriteFile(filepath.Join(repo, ".git", "HEAD"), []byte("ref: refs/heads/main\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	waitBranch("main")
+	newWindow(t, term)
+	waitWindowCount(t, term, 2, "second pane")
+	for _, pane := range []string{"0", "1", "0"} {
+		if out, err := tuiosCLI(t, base, "focus-window", "-s", name, pane); err != nil {
+			t.Fatalf("focus pane %s: %v\n%s", pane, err, out)
+		}
+		waitBranch("main")
+	}
+}
