+func TestSidebarDockFooterRendersConfiguredComponents(t *testing.T) {
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview,dock"
+	m.Settings.DockbarPosition = "hidden"
+	m.Settings.DockWorkspaceTabs = true
+
+	plain := strings.Join(railPlain(t, m, tree), "\n")
+	if !strings.Contains(plain, "1:") {
+		t.Fatalf("sidebar dock does not contain its workspace status:\n%s", plain)
+	}
+	for _, hidden := range []string{"overview", "dock", sidebarFilesLabel, m.Settings.GetRailCollapseGlyph()} {
+		if hidden != "" && strings.Contains(plain, hidden) {
+			t.Fatalf("sidebar retained hidden chrome %q:\n%s", hidden, plain)
+		}
+	}
+	for _, kind := range []sidebarRowKind{sidebarRowDockWorkspace, sidebarRowDockSessionControl} {
+		found := false
+		for _, zone := range m.SidebarHits {
+			if zone.Kind == kind {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Errorf("sidebar dock did not publish a %v zone: %+v", kind, m.SidebarHits)
+		}
+	}
+	if reserve := m.viewReserve(); reserve.Top != 0 {
+		t.Fatalf("hidden top dock reserved %d rows", reserve.Top)
+	}
+}
+
+func TestSidebarDockShowsSessionNameAndAddAboveTabs(t *testing.T) {
+	m, _ := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview,dock"
+	m.WorkspaceNames = map[int]string{m.CurrentWorkspace: "11"}
+	m.SessionName = "dots"
+	m.SessionDisplayName = ""
+	cfg, err := config.ParseUserConfig([]byte(`
+[appearance.sidebar.ui.dock_header]
+visible = true
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.UserConfig = cfg
+	lines, zones := m.sidebarDockFooter(24, 0, m.groundUI(), -1, -1)
+	if len(lines) == 0 {
+		t.Fatal("sidebar dock rendered no lines")
+	}
+	heading := stripANSIForTrace(lines[0])
+	if !strings.HasPrefix(heading, "dots") || !strings.HasSuffix(strings.TrimSpace(heading), m.Settings.GetRailAddGlyph()) {
+		t.Fatalf("workspace heading = %q, want name left and add right", heading)
+	}
+	addByte := strings.LastIndex(heading, m.Settings.GetRailAddGlyph())
+	if addByte < 0 {
+		t.Fatalf("workspace heading has no add glyph: %q", heading)
+	}
+	addCol := lipgloss.Width(heading[:addByte])
+	foundAdd := false
+	currentLine := -1
+	for _, zone := range zones {
+		if zone.Kind != sidebarRowDockWorkspace {
+			continue
+		}
+		if zone.WindowIndex == 0 {
+			foundAdd = zone.Line == 0 && zone.X0 == addCol && zone.X1 == 24
+			continue
+		}
+		if zone.WindowIndex == m.CurrentWorkspace {
+			currentLine = zone.Line
+		}
+		if zone.Line <= 0 {
+			t.Fatalf("workspace tab is not below heading: %+v", zone)
+		}
+	}
+	if !foundAdd {
+		t.Fatalf("workspace heading has no right-aligned add target: %+v", zones)
+	}
+	if currentLine < 0 {
+		t.Fatal("current workspace tab was not drawn")
+	}
+	count := strconv.Itoa(m.GetWorkspaceWindowCount(m.CurrentWorkspace))
+	workspaceRow := stripANSIForTrace(lines[currentLine])
+	countByte := strings.LastIndex(workspaceRow, count)
+	countRight := lipgloss.Width(workspaceRow[:countByte]) + lipgloss.Width(count) - 1
+	if addCol != countRight {
+		t.Fatalf("add column = %d, workspace count right edge = %d", addCol, countRight)
+	}
+}
+
+func TestSidebarDockStacksWorkspaceTabsAndOmitsModeLogo(t *testing.T) {
+	m, _ := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview,dock"
+	m.Settings.DockbarPosition = "hidden"
+	m.Settings.DockWorkspaceTabs = true
+
+	mode, _, _, _, _ := m.buildDockLeftText()
+	lines, zones := m.sidebarDockFooter(24, 0, m.groundUI(), -1, -1)
+	plain := stripANSIForTrace(strings.Join(lines, "\n"))
+	if logo := strings.TrimSpace(mode); logo != "" && strings.Contains(plain, logo) {
+		t.Fatalf("sidebar dock retained mode/logo %q:\n%s", logo, plain)
+	}
+
+	seenLines := map[int]bool{}
+	workspaceCount, lastWorkspaceLine := 0, -1
+	currentWorkspaceLine := -1
+	firstSessionControlLine := len(lines)
+	sessionControlLines := map[int]bool{}
+	var sessionControlZones []sidebarDockZone
+	for _, zone := range zones {
+		switch zone.Kind {
+		case sidebarRowDockWorkspace:
+			workspaceCount++
+			if seenLines[zone.Line] {
+				t.Fatalf("workspace tabs share line %d: %+v", zone.Line, zones)
+			}
+			seenLines[zone.Line] = true
+			lastWorkspaceLine = max(lastWorkspaceLine, zone.Line)
+			if zone.WindowIndex == m.CurrentWorkspace {
+				currentWorkspaceLine = zone.Line
+			}
+			if zone.X0 != 0 || zone.X1 != 24 {
+				t.Fatalf("workspace tab zone = [%d,%d), want full vertical row", zone.X0, zone.X1)
+			}
+		case sidebarRowDockSessionControl:
+			firstSessionControlLine = min(firstSessionControlLine, zone.Line)
+			sessionControlLines[zone.Line] = true
+			sessionControlZones = append(sessionControlZones, zone)
+		}
+	}
+	if workspaceCount < 2 {
+		t.Fatalf("workspace tab count = %d, want at least current and add", workspaceCount)
+	}
+	if lastWorkspaceLine+1 >= len(lines) || strings.TrimSpace(stripANSIForTrace(lines[lastWorkspaceLine+1])) != "" {
+		t.Fatalf("workspace section has no blank row after line %d:\n%s", lastWorkspaceLine, plain)
+	}
+	if firstSessionControlLine <= 0 || firstSessionControlLine >= len(lines) ||
+		strings.TrimSpace(stripANSIForTrace(lines[firstSessionControlLine-1])) != "" {
+		t.Fatalf("session controls have no blank row before line %d:\n%s", firstSessionControlLine, plain)
+	}
+	if len(sessionControlLines) != 1 {
+		t.Fatalf("session controls occupy %d lines, want one: %+v", len(sessionControlLines), zones)
+	}
+	if len(sessionControlZones) != 3 {
+		t.Fatalf("session control count = %d, want 3: %+v", len(sessionControlZones), sessionControlZones)
+	}
+	minWidth, maxWidth := 24, 0
+	for i, zone := range sessionControlZones {
+		width := zone.X1 - zone.X0
+		minWidth, maxWidth = min(minWidth, width), max(maxWidth, width)
+		if i > 0 && zone.X0 != sessionControlZones[i-1].X1 {
+			t.Fatalf("session control zones are not contiguous: %+v", sessionControlZones)
+		}
+	}
+	if sessionControlZones[0].X0 != 0 || sessionControlZones[len(sessionControlZones)-1].X1 != 24 || maxWidth-minWidth > 1 {
+		t.Fatalf("session controls are not uniformly distributed: %+v", sessionControlZones)
+	}
+	controlRow := stripANSIForTrace(lines[firstSessionControlLine])
+	for _, action := range []DockSessionAction{DockSessionNew, DockSessionLeave, DockSessionClose} {
+		label := dockSessionIcon(action, &m.Settings)
+		if !strings.Contains(controlRow, label) {
+			t.Fatalf("session control row does not contain %q: %q", label, controlRow)
+		}
+	}
+	for _, text := range []string{"New session", "Leave running", "Close session", "exit", "close"} {
+		if strings.Contains(controlRow, text) {
+			t.Fatalf("session control row contains text %q: %q", text, controlRow)
+		}
+	}
+	if currentWorkspaceLine < 0 {
+		t.Fatal("current workspace tab was not drawn")
+	}
+	canvas := uv.NewScreenBuffer(24, 1)
+	uv.NewStyledString(lines[currentWorkspaceLine]).Draw(canvas, canvas.Bounds())
+	first := canvas.CellAt(0, 0)
+	if first == nil || first.Content != m.Settings.GetRailFocusMark() {
+		t.Fatalf("current workspace tab has no active gutter marker: %+v", first)
+	}
+	currentLabel := m.workspacePillLabel(m.CurrentWorkspace)
+	currentPlain := stripANSIForTrace(lines[currentWorkspaceLine])
+	labelByte := strings.Index(currentPlain, currentLabel)
+	if labelByte < 0 {
+		t.Fatalf("current workspace label %q is missing", currentLabel)
+	}
+	labelCol := lipgloss.Width(currentPlain[:labelByte])
+	if cell := canvas.CellAt(labelCol, 0); cell == nil || cell.Style.Attrs&uv.AttrBold == 0 {
+		t.Fatalf("current workspace label is not bold: %+v", cell)
+	}
+	if count := m.GetWorkspaceWindowCount(m.CurrentWorkspace); count > 0 &&
+		!strings.HasSuffix(strings.TrimSpace(stripANSIForTrace(lines[currentWorkspaceLine])), strconv.Itoa(count)) {
+		t.Fatalf("current workspace row has no pane count: %q", stripANSIForTrace(lines[currentWorkspaceLine]))
+	}
+}
