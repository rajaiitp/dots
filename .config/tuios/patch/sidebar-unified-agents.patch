+// TestDetachConsumesKeyboardResetReply pins the Ctrl+B d failure where the
+// terminal's final Kitty keyboard-flags answer reached the shell as "7u". The
+// prefix answer may arrive first; detach waits for the post-prefix answer.
+func TestDetachConsumesKeyboardResetReply(t *testing.T) {
+	win := newTestWindow(t, "keyboard-detach", 80, 24)
+	o := newTestOS(win)
+	o.Mode = TerminalMode
+	o.IsDaemonSession = true
+	o.KeyboardEnhancementsEnabled = true
+	o.KeyboardFlags = 1 | ansi.KittyReportAlternateKeys | ansi.KittyReportAllKeysAsEscapeCodes | ansi.KittyReportAssociatedKeys
+
+	armCmd := o.DetachClient()
+	if armCmd == nil || !o.keyboardQuitPending {
+		t.Fatal("detach did not wait for the keyboard reset reply")
+	}
+	rawArmMsg := armCmd()
+	armMsg, ok := rawArmMsg.(keyboardQuitArmMsg)
+	if !ok {
+		t.Fatalf("detach command = %T, want keyboardQuitArmMsg", rawArmMsg)
+	}
+	_, timeoutCmd := o.Update(armMsg)
+	if timeoutCmd == nil || !o.keyboardQuitArmed {
+		t.Fatal("keyboard reset wait was not armed")
+	}
+
+	prefixFlags := 1 | ansi.KittyReportAlternateKeys | ansi.KittyReportAllKeysAsEscapeCodes | ansi.KittyReportAssociatedKeys
+	_, cmd := o.Update(tea.KeyboardEnhancementsMsg{Flags: prefixFlags})
+	if cmd != nil {
+		t.Fatal("detach quit on the stale prefix keyboard reply")
+	}
+
+	paneFlags := 1 | ansi.KittyReportEventTypes | ansi.KittyReportAlternateKeys
+	_, cmd = o.Update(tea.KeyboardEnhancementsMsg{Flags: paneFlags})
+	if cmd == nil {
+		t.Fatal("detach did not quit after consuming the post-prefix reply")
+	}
+	if _, ok := cmd().(tea.QuitMsg); !ok {
+		t.Fatalf("post-prefix command = %T, want tea.QuitMsg", cmd())
+	}
+	if o.keyboardQuitPending {
+		t.Fatal("keyboard reset wait remained pending after the matching reply")
+	}
+}
+
+func TestDetachKeyboardResetWaitTimesOut(t *testing.T) {
+	o := &OS{KeyboardEnhancementsEnabled: true, keyboardQuitPending: true}
+	o.keyboardQuitArmed = true
+
+	_, cmd := o.Update(keyboardQuitTimeoutMsg{})
+	if cmd == nil {
+		t.Fatal("keyboard reset timeout did not quit")
+	}
+	if _, ok := cmd().(tea.QuitMsg); !ok {
+		t.Fatalf("timeout command = %T, want tea.QuitMsg", cmd())
+	}
+	if o.keyboardQuitPending {
+		t.Fatal("keyboard reset wait remained pending after timeout")
+	}
+}
