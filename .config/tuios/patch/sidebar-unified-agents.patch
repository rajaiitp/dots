+	repoLine, repoHit := railRowLine(t, m, lines, sidebarRowRepo, "dots")
+	mainLine, mainHit := railRowLine(t, m, lines, sidebarRowSession, "dots")
+	macLine, macHit := railRowLine(t, m, lines, sidebarRowSession, "mac")
+	testLine, testHit := railRowLine(t, m, lines, sidebarRowSession, "dots-test")
+	agentLine, agentHit := railRowLine(t, m, lines, sidebarRowAgent, "mac")
+
+	row := func(hit sidebarRowHit) int { return hit.Y0 - m.GetTopMargin() }
+	if !(row(repoHit) < row(mainHit) && row(mainHit) < row(macHit) && row(macHit) < row(agentHit) && row(agentHit) < row(testHit)) {
+		t.Fatalf("repository hierarchy is out of order:\n%s", strings.Join(lines, "\n"))
