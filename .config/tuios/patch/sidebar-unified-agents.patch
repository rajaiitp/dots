+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/sessiontree"
+	uv "github.com/charmbracelet/ultraviolet"
+)
+
+func TestOverviewWorktreeRailSpansEveryAgent(t *testing.T) {
+	for _, rowStyle := range config.RailRowStyles {
+		t.Run(rowStyle, func(t *testing.T) {
+			m, tree := sectionsTestOS(t, 120, 40)
+			m.Settings.SidebarSections = "overview"
+			m.Settings.RailRowStyle = rowStyle
+			overviewStyleConfig(t, m)
+			for i := range 2 {
+				tree.Sessions[i].Worktree = &sessiontree.WorktreeRef{Repo: "project", Branch: tree.Sessions[i].ID}
+			}
+			pal := m.groundUI()
+			for _, focus := range [][2]string{
+				{"main", "aaaaaaaa1111"},
+				{"main", "bbbbbbbb2222"},
+				{"main", "cccccccc3333"},
+				{"api", "dddddddd4444"},
+				{"api", "eeeeeeee5555"},
+			} {
+				focusOverviewSession(&tree, focus[0], focus[1])
+				styled := railStyled(t, m, tree)
+				for title, session := range map[string]string{
+					"main": "main", "refactor": "main", "build": "main",
+					"api": "api", "server": "api", "project": "",
+				} {
+					canvas := overviewRowCanvas(styledRow(t, styled, title))
+					cell := canvas.CellAt(0, 0)
+					if session == focus[0] {
+						if cell.Content != m.Settings.GetRailFocusMark() || !samePaneColor(cell.Style.Fg, pal.Accent) {
+							t.Fatalf("%s lost the worktree rail with focus on %s: %+v", title, focus[1], cell)
+						}
+					} else if cell.Content != " " {
+						t.Fatalf("%s acquired the active worktree rail: %+v", title, cell)
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestOverviewUnselectedAgentTextKeepsNormalForeground(t *testing.T) {
+	m, _ := sectionsTestOS(t, 120, 40)
+	overviewStyleConfig(t, m)
+	pal := m.groundUI()
+	for _, foreign := range []bool{false, true} {
+		for _, state := range []string{"idle", "working", "needs_input", "done"} {
+			for _, st := range []sidebarRowState{{}, {Hover: true}, {Cursor: true}, {Cursor: true, Focused: true}} {
+				e := sidebarAgentEntry{SessionID: "main", WindowID: "agent-window", Title: "pi", State: state, Foreign: foreign}
+				row := m.sidebarOverviewAgentRow(e, 2, 30, pal, st)
+				canvas := overviewRowCanvas(row)
+				plain := stripANSIForTrace(row)
+				col := lipgloss.Width(plain[:strings.Index(plain, e.Title)])
+				cell := canvas.CellAt(col, 0)
+				if !samePaneColor(cell.Style.Fg, pal.Fg) || cell.Style.Attrs&uv.AttrBold != 0 {
+					t.Fatalf("unselected Pi label changed for state %s, foreign %t, row %+v: %+v", state, foreign, st, cell.Style)
+				}
+			}
+		}
+	}
+}
