+++ w/internal/app/sidebar_overview.go
@@ -0,0 +1,279 @@
+package app
+
+import (
+	"image/color"
+	"strconv"
+	"time"
+
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/overlay"
+	"github.com/Gaurav-Gosain/tuios/internal/sessiontree"
+)
+
+type sidebarOverviewRowKind uint8
+
+const (
+	sidebarOverviewNode sidebarOverviewRowKind = iota
+	sidebarOverviewAgent
+	sidebarOverviewGap
+)
+
+type sidebarOverviewRow struct {
+	Kind   sidebarOverviewRowKind
+	Node   sessiontree.Node
+	Agent  sidebarAgentEntry
+	Indent int
+}
+
+func (r sidebarOverviewRow) navRow() (sidebarNavRow, bool) {
+	switch r.Kind {
+	case sidebarOverviewAgent:
+		return sidebarNavRow{Kind: sidebarRowAgent, SessionID: r.Agent.SessionID, WindowID: r.Agent.WindowID, WindowIndex: r.Agent.WindowIndex}, true
+	case sidebarOverviewNode:
+		switch r.Node.Kind {
+		case sessiontree.KindSession:
+			if isRemoteNode(r.Node) {
+				return sidebarNavRow{Kind: sidebarRowHostSession, SessionID: r.Node.Host, WindowID: remoteSessionName(r.Node), WindowIndex: -1}, true
+			}
+			return sidebarNavRow{Kind: sidebarRowSession, SessionID: r.Node.ID, WindowIndex: -1}, true
+		case sessiontree.KindRepo:
+			return sidebarNavRow{Kind: sidebarRowRepo, SessionID: r.Node.ID, WindowID: r.Node.Space, WindowIndex: -1}, true
+		case sessiontree.KindHost:
+			return sidebarNavRow{Kind: sidebarRowHost, SessionID: r.Node.Host, WindowIndex: -1}, true
+		}
+	}
+	return sidebarNavRow{}, false
+}
+
+func (r sidebarOverviewRow) matches(target sidebarNavRow) bool {
+	row, ok := r.navRow()
+	return ok && sidebarNavRowsEqual(row, target)
+}
+
+type sidebarOverviewRepoKey struct {
+	repo  string
+	space string
+}
+
+// sidebarOverviewSessionRows gives every local checkout the same repository →
+// branch presentation. Linked worktrees already carry their repository; a
+// primary or standalone checkout gets a copied presentation-only WorktreeRef
+// from its cached branch and label. Nothing written back to the session tree can
+// therefore make a primary checkout removable as a worktree.
+func (m *OS) sidebarOverviewSessionRows(sessions []sessiontree.Node) []sessiontree.Node {
+	local := localSessionNodes(sessions)
+	linkedRepos := make(map[sidebarOverviewRepoKey]struct{})
+	for _, node := range local {
+		if node.Kind == sessiontree.KindSession && node.Worktree != nil {
+			linkedRepos[sidebarOverviewRepoKey{repo: node.Worktree.Repo, space: node.Space}] = struct{}{}
+		}
+	}
+
+	presented := make([]sessiontree.Node, len(local))
+	activeRepos := make(map[sidebarOverviewRepoKey]bool)
+	for i, node := range local {
+		checkout, known := m.sidebarCheckoutPlace(node.ID)
+		if node.Kind == sessiontree.KindSession && known {
+			node.Branch = checkout.branch
+			if node.Worktree != nil {
+				ref := *node.Worktree
+				ref.Branch = checkout.branch
+				node.Worktree = &ref
+			}
+		}
+		if node.Kind == sessiontree.KindSession && node.Host == "" && !node.Global && node.Worktree == nil && node.Branch != "" {
+			repo := node.Title
+			if checkout.repo != "" {
+				repo = checkout.repo
+			}
+			if repo == "" {
+				repo = node.ID
+			}
+			if _, ok := linkedRepos[sidebarOverviewRepoKey{repo: node.ID, space: node.Space}]; ok {
+				repo = node.ID
+			}
+			node.Worktree = &sessiontree.WorktreeRef{Repo: repo, Branch: node.Branch}
+		}
+		if node.Kind == sessiontree.KindSession && node.Worktree != nil && node.IsCurrent {
+			activeRepos[sidebarOverviewRepoKey{repo: node.Worktree.Repo, space: node.Space}] = true
+		}
+		presented[i] = node
+	}
+
+	grouped := sessiontree.GroupBySpace(presented, sessiontree.GroupByRepo)
+	visible := make([]sessiontree.Node, 0, len(grouped))
+	for _, node := range grouped {
+		if node.Kind == sessiontree.KindRepo {
+			node.IsCurrent = activeRepos[sidebarOverviewRepoKey{repo: node.ID, space: node.Space}]
+		}
+		if node.Kind == sessiontree.KindSession && node.Worktree != nil && m.SidebarRepoCollapsed(node.Worktree.Repo) && !node.IsCurrent {
+			continue
+		}
+		visible = append(visible, node)
+	}
+	return m.sidebarMachineRows(visible, sessions[len(local):])
+}
+
+// sidebarOverviewRows projects the existing session hierarchy into one list.
+// Host, space, repository and session rows keep the sessions section's order
+// and folding. Agent panes are then nested under their local session.
+func (m *OS) sidebarOverviewRows(sessions []sessiontree.Node, agents []sidebarAgentEntry) []sidebarOverviewRow {
+	if !sidebarLayoutHas(sidebarSectionOverview, &m.Settings) {
+		return nil
+	}
+	sessionRows := m.sidebarOverviewSessionRows(sessions)
+	agents = append([]sidebarAgentEntry(nil), agents...)
+	m.sidebarSortAgents(agents)
+	bySession := make(map[string][]sidebarAgentEntry)
+	for _, agent := range agents {
+		if agent.Host != "" {
+			continue
+		}
+		bySession[agent.SessionID] = append(bySession[agent.SessionID], agent)
+	}
+	visible := make(map[string]bool, len(sessionRows))
+	var current sessiontree.Node
+	for _, node := range sessionRows {
+		if node.Kind == sessiontree.KindSession && node.Host == "" {
+			visible[node.ID] = true
+		}
+	}
+	for _, session := range sessions {
+		if session.Host == "" && session.IsCurrent {
+			current = session
+			break
+		}
+	}
+
+	rows := make([]sidebarOverviewRow, 0, len(sessionRows)+len(agents)+2)
+	appendChildren := func(node sessiontree.Node) {
+		children := bySession[node.ID]
+		indent := m.sidebarNodeIndent(node) + sidebarGroupIndent
+		if node.Worktree != nil {
+			indent += sidebarGroupIndent
+		}
+		for _, agent := range children {
+			rows = append(rows, sidebarOverviewRow{
+				Kind: sidebarOverviewAgent, Agent: agent, Indent: indent,
+			})
+		}
+	}
+	for _, node := range sessionRows {
+		startsTopLevel := node.Kind == sessiontree.KindSpace || node.Kind == sessiontree.KindRepo || node.Kind == sessiontree.KindHost ||
+			node.Kind == sessiontree.KindSession && node.Host == "" && node.Space == "" && node.Worktree == nil
+		if startsTopLevel && len(rows) > 0 {
+			last := rows[len(rows)-1]
+			directlyUnderSpace := node.Kind == sessiontree.KindRepo && last.Kind == sidebarOverviewNode && last.Node.Kind == sessiontree.KindSpace
+			if !directlyUnderSpace {
+				if last.Kind != sidebarOverviewGap {
+					rows = append(rows, sidebarOverviewRow{Kind: sidebarOverviewGap})
+				}
+				rows = append(rows, sidebarOverviewRow{Kind: sidebarOverviewGap})
+			}
+		}
+		rows = append(rows, sidebarOverviewRow{Kind: sidebarOverviewNode, Node: node})
+		if node.Kind == sessiontree.KindSession {
+			if node.Host == "" {
+				appendChildren(node)
+			}
+			rows = append(rows, sidebarOverviewRow{Kind: sidebarOverviewGap})
+			continue
+		}
+		if node.Kind == sessiontree.KindRepo && current.ID != "" && !visible[current.ID] &&
+			current.Worktree != nil && node.ID == current.Worktree.Repo && node.Space == current.Space {
+			current.GroupLast = true
+			rows = append(rows, sidebarOverviewRow{Kind: sidebarOverviewNode, Node: current})
+			appendChildren(current)
+			rows = append(rows, sidebarOverviewRow{Kind: sidebarOverviewGap})
+		}
+	}
+	for len(rows) > 0 && rows[len(rows)-1].Kind == sidebarOverviewGap {
+		rows = rows[:len(rows)-1]
+	}
+	return rows
+}
+
+func overviewAgentFigure(e sidebarAgentEntry, ascii bool, now time.Time) string {
+	switch {
+	case e.Queued > 0:
+		return strconv.Itoa(e.Queued) + "q"
+	case e.Subagents > 0:
+		if ascii {
+			return strconv.Itoa(e.Subagents) + "s"
+		}
+		return strconv.Itoa(e.Subagents) + "↳"
+	default:
+		return railAgentAge(e.State, e.StateAt, now)
+	}
+}
+
+func (m *OS) sidebarOverviewGutter(current bool, bg color.Color, pal overlay.Palette) string {
+	mark, ink := " ", color.Color(nil)
+	if current {
+		mark, ink = m.Settings.GetRailFocusMark(), pal.Accent
+	}
+	return sidebarStyle(bg, ink).Render(mark)
+}
+
+func (m *OS) sidebarOverviewAgentRow(e sidebarAgentEntry, indent, cw int, pal overlay.Palette, st sidebarRowState) string {
+	st.ActiveSubtree = !e.Foreign
+	rowBg := sidebarRowBg(st, pal)
+	fg := pal.Fg
+	lastFocused := e.Focused || m.sidebarAgentWasLastFocused(e)
+	if lastFocused {
+		fg = overlay.Readable(pal.Accent, m.sidebarGroundOr(rowBg))
+	}
+	// The ground marks the current subtree; text remembers an agent even in another subtree.
+	style := m.sidebarUIResolved(sidebarUIAgent, !e.Foreign, pal, fg, rowBg, false, false)
+	textStyle := m.sidebarUIResolved(sidebarUIAgent, lastFocused, pal, fg, nil,
+		lastFocused, false)
+	style.fg, style.bold = textStyle.fg, textStyle.bold
+	rowBg = style.rowBackground(rowBg)
+	indent = style.rowIndent(max(indent-1, 0))
+	figure := overviewAgentFigure(e, overlay.UseASCII(), time.Now())
+	right := ""
+	rightW := lipgloss.Width(figure)
+	nameRoom := sidebarNameAvailIn(cw, rightW, indent)
+	if nameRoom < 4 {
+		figure = ""
+		nameRoom = sidebarNameAvailIn(cw, 0, indent)
+	}
+	nameRoom = max(nameRoom, 1)
+	if figure != "" {
+		right = sidebarStyle(rowBg, pal.FgMute).Render(figure)
+	}
+	title := printableTitle(e.Title)
+	if title == "" {
+		title = "agent"
+	}
+	name := style.render(m.sidebarMarquee("o:"+e.SessionID+"/"+e.WindowID, title, nameRoom, st.Cursor), nameRoom)
+	gutter := m.sidebarOverviewGutter(!e.Foreign, rowBg, pal)
+	return sidebarComposeGroupRow(indent, gutter,
+		sidebarGlyph(e.State, e.DoneSeen, e.Subagents, rowBg, pal, &m.Settings), name, right, cw, rowBg)
+}
+
+func (m *OS) sidebarOverviewCursorIndex(target sidebarNavRow, rows []sidebarOverviewRow) (int, bool) {
+	for i, row := range rows {
+		if row.matches(target) {
+			return i, true
+		}
+	}
+	return 0, false
+}
+
+func sidebarOverviewFocusedIndex(rows []sidebarOverviewRow, sessionID, windowID string) int {
+	session := -1
+	for i, row := range rows {
+		switch row.Kind {
+		case sidebarOverviewNode:
+			if row.Node.Kind == sessiontree.KindSession && row.Node.ID == sessionID && row.Node.Host == "" {
+				session = i
+			}
+		case sidebarOverviewAgent:
+			if row.Agent.SessionID == sessionID && row.Agent.WindowID == windowID {
+				return i
+			}
+		}
+	}
+	return session
+}
