diff --git i/internal/app/sidebar_dock.go w/internal/app/sidebar_dock.go
new file mode 100644
index 0000000..65c146b
--- /dev/null
+++ w/internal/app/sidebar_dock.go
@@ -0,0 +1,485 @@
+package app
+
+import (
+	"image/color"
+	"strconv"
+	"strings"
+
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/overlay"
+	"github.com/Gaurav-Gosain/tuios/internal/theme"
+)
+
+type sidebarDockZone struct {
+	Line        int
+	X0          int
+	X1          int
+	Kind        sidebarRowKind
+	SessionID   string
+	WindowIndex int
+}
+
+type sidebarDockGroup uint8
+
+const (
+	sidebarDockGroupInvalid sidebarDockGroup = iota
+	sidebarDockGroupWorkspaces
+	sidebarDockGroupStatus
+	sidebarDockGroupWindows
+	sidebarDockGroupInfo
+	sidebarDockGroupSession
+)
+
+func (m *OS) sidebarDockWorkspaceRow(tab dockWorkspaceTab, cw int, pal overlay.Palette) string {
+	fg := color.Color(pal.FgMute)
+	bold := false
+	if tab.Active {
+		fg = overlay.Readable(pal.Accent, m.sidebarGroundOr(nil))
+		bold = true
+	} else if tab.Attention {
+		tabs := m.dockTabs()
+		if attention := tabColor(tabs.AttentionFg, &pal); attention != nil {
+			fg = attention
+		}
+	}
+	style := m.sidebarUIResolved(sidebarUIWorkspace, tab.Active, pal, fg, nil, bold, false)
+	cfg := m.sidebarUIElementConfig(sidebarUIWorkspace)
+	if cfg.PaddingLeft == nil {
+		style.paddingLeft = 1
+	}
+	if cfg.PaddingRight == nil {
+		style.paddingRight = 1
+	}
+	rowBg := style.rowBackground(nil)
+	marker := sidebarStyle(rowBg, nil).Render(" ")
+	if tab.Active {
+		marker = sidebarStyle(rowBg, pal.Accent).Render(m.Settings.GetRailFocusMark())
+	}
+	right := ""
+	rightW := 0
+	if !tab.Add && tab.Workspace > 0 {
+		if count := m.GetWorkspaceWindowCount(tab.Workspace); count > 0 {
+			text := strconv.Itoa(count)
+			right = sidebarStyle(rowBg, pal.FgMute).Render(text)
+			rightW = lipgloss.Width(text)
+		}
+	}
+	nameWidth := max(cw-lipgloss.Width(marker)-rightW-1, 1)
+	row := marker + style.render(tab.Label, nameWidth)
+	if rightW > 0 {
+		gap := max(cw-lipgloss.Width(row)-rightW-1, 0)
+		row += sidebarStyle(rowBg, nil).Render(strings.Repeat(" ", gap)) + right + sidebarStyle(rowBg, nil).Render(" ")
+	}
+	fitBg := color.Color(nil)
+	if style.fullWidth {
+		fitBg = rowBg
+	}
+	return sidebarFit(row, cw, fitBg)
+}
+
+func (m *OS) sidebarDockAtTop() bool {
+	for _, section := range config.ParseSidebarSections(m.Settings.SidebarSections) {
+		switch section.Name {
+		case config.SidebarSectionDock:
+			return true
+		case config.SidebarSectionSpacer:
+			continue
+		default:
+			return false
+		}
+	}
+	return false
+}
+
+func (m *OS) sidebarDockEnabled() bool {
+	for _, section := range config.ParseSidebarSections(m.Settings.SidebarSections) {
+		if section.Name == config.SidebarSectionDock {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *OS) sidebarDockFooter(cw, height int, pal overlay.Palette, hoverLine, hoverX int) ([]string, []sidebarDockZone) {
+	if !m.sidebarDockEnabled() || cw <= 0 {
+		return nil, nil
+	}
+	m.ensureDockPlan()
+	mode, trail, tape, _, modeInfo := m.buildDockLeftText()
+	lines := make([]string, 0)
+	zones := make([]sidebarDockZone, 0)
+	appendRow := func(text string) int {
+		line := len(lines)
+		lines = append(lines, sidebarFit(text, cw, nil))
+		return line
+	}
+	appendZone := func(line, x0, x1 int, kind sidebarRowKind, id string, index int) {
+		if x1 <= x0 {
+			return
+		}
+		zones = append(zones, sidebarDockZone{
+			Line: line, X0: max(x0, 0), X1: min(x1, cw), Kind: kind, SessionID: id, WindowIndex: index,
+		})
+	}
+	renderElement := func(element sidebarUIElement, text string, active bool, fg, bg color.Color,
+		bold, fullWidth bool, defaultPaddingLeft int,
+	) (string, bool) {
+		if text = strings.TrimSpace(text); text == "" || !m.sidebarUIVisible(element, true) {
+			return "", false
+		}
+		style := m.sidebarUIResolved(element, active, pal, fg, bg, bold, fullWidth)
+		if cfg := m.sidebarUIElementConfig(element); cfg.PaddingLeft == nil {
+			style.paddingLeft = defaultPaddingLeft
+		}
+		fitBg := color.Color(nil)
+		if style.fullWidth {
+			fitBg = style.rowBackground(bg)
+		}
+		return sidebarFit(style.render(text, cw), cw, fitBg), true
+	}
+	drawMode := func() {
+		if !m.sidebarUIVisible(sidebarUIMode, false) {
+			return
+		}
+		bg := modeInfo.Color
+		if bg == nil {
+			bg = pal.Accent
+		}
+		if row, ok := renderElement(sidebarUIMode, mode, false, theme.ContrastText(bg), bg, true, false, 0); ok {
+			appendRow(row)
+		}
+	}
+	drawPassive := func(element sidebarUIElement, text string) {
+		if row, ok := renderElement(element, text, false, pal.FgMute, nil, false, false, 1); ok {
+			appendRow(row)
+		}
+	}
+	drawWorkspaces := func() {
+		if !m.sidebarUIVisible(sidebarUIWorkspace, true) {
+			return
+		}
+		tabs := m.buildDockWorkspaceTabs()
+		headerVisible := m.sidebarUIVisible(sidebarUIDockHeader, false)
+		if headerVisible {
+			style := m.sidebarUIResolved(sidebarUIDockHeader, false, pal, pal.Accent, nil, true, true)
+			label := printableTitle(m.sessionTitle(m.SessionName))
+			add := ""
+			for _, tab := range tabs {
+				if tab.Add {
+					add = m.Settings.GetRailAddGlyph()
+					break
+				}
+			}
+			addWidth := lipgloss.Width(add)
+			labelWidth := cw
+			addX := cw
+			if addWidth > 0 {
+				addX = max(cw-addWidth-1, 0)
+				labelWidth = max(addX-1, 1)
+			}
+			row := style.render(label, labelWidth)
+			if addWidth > 0 {
+				row += sidebarStyle(style.rowBackground(nil), nil).Render(" ") +
+					sidebarStyle(style.rowBackground(nil), style.fg).Bold(true).Render(add) +
+					sidebarStyle(style.rowBackground(nil), nil).Render(" ")
+			}
+			line := appendRow(sidebarFit(row, cw, style.rowBackground(nil)))
+			if addWidth > 0 {
+				appendZone(line, addX, cw, sidebarRowDockWorkspace, "", 0)
+			}
+		}
+		for _, tab := range tabs {
+			if tab.Add && headerVisible {
+				continue
+			}
+			line := appendRow(m.sidebarDockWorkspaceRow(tab, cw, pal))
+			appendZone(line, 0, cw, sidebarRowDockWorkspace, "", tab.Workspace)
+		}
+	}
+	drawWindows := func() {
+		for _, item := range m.getDockItems() {
+			active := item.WindowIndex == m.FocusedWindow
+			bg, fg := color.Color(pal.Panel), color.Color(pal.FgDim)
+			if active {
+				bg, fg = pal.Accent, theme.ContrastText(pal.Accent)
+			}
+			text, ok := renderElement(sidebarUIWindow, item.Label, active, fg, bg, active, true, 0)
+			if !ok {
+				continue
+			}
+			line := appendRow(text)
+			appendZone(line, 0, cw, sidebarRowDockWindow, "", item.WindowIndex)
+		}
+	}
+	drawCell := func(name string) {
+		cell := m.dockCustomCell(name)
+		cell, ok := renderElement(sidebarUIInfo, cell, false, pal.FgDim, nil, false, false, 0)
+		if !ok {
+			return
+		}
+		line := appendRow(cell)
+		switch {
+		case name == config.DockComponentTransfers:
+			appendZone(line, 0, min(lipgloss.Width(cell), cw), sidebarRowDockTransfers, "", -1)
+		case strings.HasPrefix(name, config.DockCustomPrefix):
+			appendZone(line, 0, min(lipgloss.Width(cell), cw), sidebarRowDockCustom, name, -1)
+		}
+	}
+	drawMeters := func(name string) {
+		text := ""
+		switch name {
+		case config.DockComponentCPU:
+			if m.Settings.ShowCPU {
+				text = m.GetCPUGraph()
+			}
+		case config.DockComponentRAM:
+			if m.Settings.ShowRAM {
+				text = m.GetRAMUsage()
+			}
+		}
+		drawPassive(sidebarUIInfo, text)
+	}
+	drawNotification := func() {
+		if len(m.Notifications) == 0 {
+			return
+		}
+		message := strings.TrimSpace(m.Notifications[len(m.Notifications)-1].Message)
+		if message == "" {
+			return
+		}
+		prefix := "! "
+		cut := lipgloss.Width(prefix+message) > cw
+		row, ok := renderElement(sidebarUIInfo, prefix+message, false, pal.Fg, nil, false, true, 0)
+		if !ok {
+			return
+		}
+		line := appendRow(row)
+		cutIndex := 0
+		if cut {
+			cutIndex = 1
+		}
+		appendZone(line, 0, cw, sidebarRowDockNotification, "", cutIndex)
+	}
+	drawLegend := func() {
+		if legend := m.dockModeLegend(); len(legend) > 0 && m.sidebarUIVisible(sidebarUIInfo, true) {
+			appendRow(renderModeLegend(legend, cw, pal))
+		}
+	}
+	drawSessionControls := func() {
+		if !m.sidebarUIVisible(sidebarUISessionControl, true) {
+			return
+		}
+		_, cells := m.buildDockSessionStrip()
+		if len(cells) == 0 {
+			return
+		}
+		base := m.sidebarUIResolved(sidebarUISessionControl, false, pal, pal.FgDim, nil, false, true)
+		start := min(base.paddingLeft, cw)
+		end := max(cw-base.paddingRight, start)
+		inside := end - start
+		if inside <= 0 {
+			return
+		}
+		spaceBg := color.Color(nil)
+		if base.fullWidth {
+			spaceBg = base.rowBackground(nil)
+		}
+		space := func(width int) string {
+			if width <= 0 {
+				return ""
+			}
+			return sidebarStyle(spaceBg, nil).Render(strings.Repeat(" ", width))
+		}
+		row := space(start)
+		x := start
+		line := len(lines)
+		for i, cell := range cells {
+			segmentStart := start + i*inside/len(cells)
+			segmentEnd := start + (i+1)*inside/len(cells)
+			label := overlay.Truncate(dockSessionIcon(cell.Action, &m.Settings), max(segmentEnd-segmentStart, 0))
+			width := lipgloss.Width(label)
+			iconX := segmentStart + max(segmentEnd-segmentStart-width, 0)/2
+			row += space(iconX - x)
+			x = iconX
+			fallbackFg := color.Color(pal.Fg)
+			fallbackBold := true
+			if cell.Action == DockSessionClose {
+				fallbackFg = pal.FgMute
+				fallbackBold = false
+			}
+			style := m.sidebarUIResolved(sidebarUISessionControl, false, pal, fallbackFg, base.bg, fallbackBold, false)
+			row += sidebarStyle(style.bg, style.fg).Bold(style.bold).Render(label)
+			x += width
+			appendZone(line, segmentStart, segmentEnd, sidebarRowDockSessionControl, "", int(cell.Action))
+		}
+		row += space(cw - x)
+		appendRow(row)
+	}
+
+	lastGroup := sidebarDockGroupInvalid
+	drawGrouped := func(group sidebarDockGroup, draw func()) {
+		lineStart, zoneStart := len(lines), len(zones)
+		draw()
+		if len(lines) == lineStart {
+			return
+		}
+		if gap := m.sidebarUIDockGroupGap(); lastGroup != sidebarDockGroupInvalid && lastGroup != group && gap > 0 {
+			lines = append(lines, make([]string, gap)...)
+			copy(lines[lineStart+gap:], lines[lineStart:])
+			for i := range gap {
+				lines[lineStart+i] = sidebarFit("", cw, nil)
+			}
+			for i := zoneStart; i < len(zones); i++ {
+				zones[i].Line += gap
+			}
+		}
+		lastGroup = group
+	}
+
+	componentGroup := func(fallback sidebarDockGroup, name string) sidebarDockGroup {
+		switch name {
+		case config.DockComponentWorkspaces:
+			return sidebarDockGroupWorkspaces
+		case config.DockComponentWindows:
+			return sidebarDockGroupWindows
+		case config.DockComponentSessionControls:
+			return sidebarDockGroupSession
+		default:
+			return fallback
+		}
+	}
+
+	sides := []struct {
+		names    []string
+		fallback sidebarDockGroup
+	}{
+		{m.dockPlan.Left, sidebarDockGroupStatus},
+		{m.dockPlan.Center, sidebarDockGroupInfo},
+		{m.dockPlan.Right, sidebarDockGroupInfo},
+	}
+	for _, side := range sides {
+		for _, name := range side.names {
+			group := componentGroup(side.fallback, name)
+			drawGrouped(group, func() {
+				switch name {
+				case config.DockComponentMode:
+					drawMode()
+				case config.DockComponentWorkspaces:
+					drawWorkspaces()
+				case config.DockComponentTrail:
+					drawPassive(sidebarUIStatus, trail)
+				case config.DockComponentTape:
+					drawPassive(sidebarUIStatus, tape)
+				case config.DockComponentWindows:
+					drawWindows()
+				case config.DockComponentCPU, config.DockComponentRAM:
+					drawMeters(name)
+				case config.DockComponentNotifications:
+					drawNotification()
+				case config.DockComponentCopyHelp:
+					drawLegend()
+				case config.DockComponentSessionControls:
+					drawSessionControls()
+				default:
+					if dockCellComponent(name) {
+						drawCell(name)
+					}
+				}
+			})
+		}
+	}
+	if percent, ok := m.sidebarUIBottomOffsetPercent(sidebarUIWorkspace); ok && height > 0 {
+		first, last := -1, -1
+		for _, zone := range zones {
+			if zone.Kind != sidebarRowDockWorkspace || zone.WindowIndex == 0 {
+				continue
+			}
+			if first < 0 || zone.Line < first {
+				first = zone.Line
+			}
+			if zone.Line > last {
+				last = zone.Line
+			}
+		}
+		if first >= 0 {
+			desiredDistance := (height*percent + 99) / 100
+			if gap := desiredDistance - (len(lines) - first); gap > 0 {
+				insertAt := last + 1
+				anchored := make([]string, 0, len(lines)+gap)
+				anchored = append(anchored, lines[:insertAt]...)
+				for range gap {
+					anchored = append(anchored, sidebarFit("", cw, nil))
+				}
+				anchored = append(anchored, lines[insertAt:]...)
+				lines = anchored
+				for i := range zones {
+					if zones[i].Line >= insertAt {
+						zones[i].Line += gap
+					}
+				}
+			}
+		}
+	}
+	for _, zone := range zones {
+		if zone.Line == hoverLine && hoverX >= zone.X0 && hoverX < zone.X1 {
+			lines[zone.Line] = m.railRowState(true, false).mark(pal, lines[zone.Line])
+			break
+		}
+	}
+	return lines, zones
+}
+
+func (m *OS) activateSidebarDockRow(hit sidebarRowHit) bool {
+	switch hit.Kind {
+	case sidebarRowDockWorkspace:
+		workspace := hit.WindowIndex
+		if workspace == 0 {
+			workspace = m.nextFreeWorkspace()
+		}
+		if workspace > 0 {
+			m.SwitchToWorkspace(workspace)
+		}
+	case sidebarRowDockWindow:
+		if hit.WindowIndex >= 0 && hit.WindowIndex < len(m.Windows) {
+			m.RestoreWindow(hit.WindowIndex)
+			if m.AutoTiling {
+				m.TileAllWindows()
+			}
+		}
+	case sidebarRowDockTransfers:
+		m.queueSidebarCmd(m.OpenTransfers())
+	case sidebarRowDockCustom:
+		m.RunDockComponentClick(hit.SessionID, 1)
+	case sidebarRowDockNotification:
+		m.activateSidebarDockNotification(hit.WindowIndex != 0)
+	case sidebarRowDockSessionControl:
+		switch DockSessionAction(hit.WindowIndex) {
+		case DockSessionNew:
+			m.OpenNewSessionPicker()
+		case DockSessionLeave:
+			m.queueSidebarCmd(m.DetachClient())
+		case DockSessionClose:
+			m.queueSidebarCmd(m.OpenSessionClose())
+		}
+	default:
+		return false
+	}
+	return true
+}
+
+func (m *OS) activateSidebarDockNotification(cut bool) {
+	if len(m.Notifications) == 0 {
+		return
+	}
+	index := len(m.Notifications) - 1
+	visible := m.Notifications[index]
+	m.Notifications = m.Notifications[:index]
+	if cut && !isClipboardAsk(visible.Target) && !isRestartNotice(visible.Target) {
+		m.openMessageView(m.notificationEntry(visible))
+		return
+	}
+	if visible.Target != nil {
+		m.jumpToNotifTarget(*visible.Target)
+	}
+}
