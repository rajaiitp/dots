+// quitAfterKeyboardSync waits for the terminal's answer to the keyboard-flags
+// query emitted after a prefix closes. Without the wait, Bubble Tea can stop
+// reading first and the shell receives the answer as text such as "7u".
+func (m *OS) quitAfterKeyboardSync() tea.Cmd {
+	if !m.KeyboardEnhancementsEnabled {
+		return tea.Quit
+	}
+	m.keyboardQuitPending = true
+	m.keyboardQuitArmed = false
+	m.keyboardQuitWantsAllKeys = m.keyboardEnhancements().ReportAllKeysAsEscapeCodes
+	return func() tea.Msg { return keyboardQuitArmMsg{} }
+}
+
+func (m *OS) armKeyboardSyncQuit() tea.Cmd {
+	if !m.keyboardQuitPending {
+		return nil
+	}
+	m.keyboardQuitArmed = true
+	return tea.Tick(keyboardQuitSyncTimeout, func(time.Time) tea.Msg {
+		return keyboardQuitTimeoutMsg{}
+	})
+}
+
+func (m *OS) finishKeyboardSyncQuit(flags int) tea.Cmd {
+	if !m.keyboardQuitPending || !m.keyboardQuitArmed {
+		return nil
+	}
+	hasAllKeys := flags&ansi.KittyReportAllKeysAsEscapeCodes != 0
+	if hasAllKeys != m.keyboardQuitWantsAllKeys {
+		return nil
+	}
+	m.keyboardQuitPending = false
+	return tea.Quit
+}
+
+func (m *OS) timeoutKeyboardSyncQuit() tea.Cmd {
+	if !m.keyboardQuitPending {
+		return nil
+	}
+	m.keyboardQuitPending = false
+	return tea.Quit
+}
+
 // AllKeysPending reports whether tuios has asked the host for every key as an
 // escape code and the host has not yet said it switched.
 //
