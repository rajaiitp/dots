+// ReverseRowWithInk turns a styled row into one reverse-video run while
+// retaining one foreground ink. It is the row-width form of an active tab at
+// ANSI depth, where a literal background would replace the terminal palette.
+func ReverseRowWithInk(s string, width int, ink color.Color) string {
+	return restyleRow(s, width, func(c *uv.Cell) {
+		c.Style.Fg, c.Style.Bg = ink, nil
+		c.Style.Attrs |= uv.AttrReverse
+		c.Style.Attrs &^= uv.AttrFaint
+	})
+}
