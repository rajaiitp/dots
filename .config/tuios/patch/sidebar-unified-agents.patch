+func TestClosingTheLastPaneKillsItsSessionAndReturnsToAnother(t *testing.T) {
+	r := newRig(t, 1)
+	other := r.otherSession()
+	if _, err := r.client.RefreshSessionList(); err != nil {
+		t.Fatalf("refresh sessions: %v", err)
+	}
+
+	if cmd := r.m.CloseWindowByHand(0); cmd != nil {
+		t.Fatal("closing the last pane quit even though another session exists")
+	}
+	if r.m.SessionName != other {
+		t.Fatalf("landed on session %q, want %q", r.m.SessionName, other)
+	}
+	if len(r.m.Windows) == 0 {
+		t.Fatal("the client rendered an empty session instead of the remaining session")
+	}
+	if r.m.lastSession.name != "" {
+		t.Fatalf("last-session points back to the killed session: %+v", r.m.lastSession)
+	}
+	for _, info := range r.client.CachedSessions() {
+		if info.Name == r.session {
+			t.Fatalf("the session whose last pane closed still exists: %+v", info)
+		}
+	}
+}
