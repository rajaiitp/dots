+
+func TestOverviewSeparatesSessions(t *testing.T) {
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+	lines := railPlain(t, m, tree)
+	lastMainChild := max(lineOf(lines, "refactor"), lineOf(lines, "build"))
