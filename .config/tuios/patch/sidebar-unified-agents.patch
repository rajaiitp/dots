@@ -0,0 +1,64 @@
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestSidebarUIConfigParsesElementStyles(t *testing.T) {
+	cfg, err := ParseUserConfig([]byte(`
+[appearance.sidebar.ui]
+section_gap = 2
+dock_group_gap = 3
+
+[appearance.sidebar.ui.workspace]
+align = "center"
+active_background = "red"
+full_width = true
+padding_left = 2
+padding_right = 1
+indent = 4
+bottom_offset_percent = 33
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ui := cfg.Appearance.Sidebar.UI
+	if ui.SectionGap == nil || *ui.SectionGap != 2 || ui.DockGroupGap == nil || *ui.DockGroupGap != 3 {
+		t.Fatalf("sidebar gaps = %+v", ui)
+	}
+	workspace := ui.Workspace
+	if workspace.Align != "center" || workspace.ActiveBackground != "red" ||
+		workspace.FullWidth == nil || !*workspace.FullWidth || workspace.PaddingLeft == nil ||
+		*workspace.PaddingLeft != 2 || workspace.PaddingRight == nil || *workspace.PaddingRight != 1 ||
+		workspace.Indent == nil || *workspace.Indent != 4 || workspace.BottomOffsetPercent == nil ||
+		*workspace.BottomOffsetPercent != 33 {
+		t.Fatalf("workspace style = %+v", workspace)
+	}
+}
+
+func TestSidebarUIValidationReportsInvalidStyles(t *testing.T) {
+	cfg, err := ParseUserConfig([]byte(`
+[appearance.sidebar.ui]
+section_gap = 20
+
+[appearance.sidebar.ui.repository]
+align = "middle"
+foreground = "not-a-colour"
+padding_left = -1
+bottom_offset_percent = 120
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := ValidateConfig(cfg)
+	joined := ""
+	for _, warning := range result.Warnings {
+		joined += warning.Field + "." + warning.Key + ": " + warning.Message + "\n"
+	}
+	for _, want := range []string{"section_gap", "align", "not-a-colour", "padding_left", "bottom_offset_percent"} {
+		if !strings.Contains(joined, want) {
+			t.Errorf("warnings do not contain %q:\n%s", want, joined)
