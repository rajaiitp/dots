+++ w/e2e/tui/dock_sidebar_bounds_test.go
@@ -0,0 +1,82 @@
+package tuie2e
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/Gaurav-Gosain/tuitest"
+)
+
+func TestTopDockStaysBetweenSidebars(t *testing.T) {
+	for _, edges := range []string{"left", "right", "both"} {
+		for _, compact := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/compact=%t", edges, compact), func(t *testing.T) {
+				base := t.TempDir()
+				cfg := fmt.Sprintf("[appearance]\ndockbar_position = \"top\"\ndock_compact = %t\n[appearance.sidebar]\nenabled = true\nposition = \"hidden\"\n", compact)
+				left, right := edges != "right", edges != "left"
+				for _, edge := range []string{"left", "right"} {
+					if edge != edges && edges != "both" {
+						continue
+					}
+					cfg += fmt.Sprintf("[appearance.sidebar.%s]\nenabled = true\nwidth = 28\nsections = \"custom\"\n[appearance.sidebar.%s.custom]\ncommand = \"printf RAIL-%s\"\n", edge, edge, edge)
+				}
+				writeConfig(t, base, cfg)
+				term := startIn(t, base, startOpts{cols: 140, rows: compactRows})
+				waitBoot(t, term)
+				if err := term.SendKeys("n"); err != nil {
+					t.Fatal(err)
+				}
+				waitDockStatus(t, term, "top", 1, 1, "initial pane")
+				checkRails := func(s tuitest.Screen) bool {
+					cols, _ := s.Size()
+					return (!left || s.Cell(27, 0).Rune == '│') &&
+						(!right || s.Cell(cols-28, 0).Rune == '│')
+				}
+				if err := term.WaitFor(checkRails, uiTimeout); err != nil {
+					t.Fatalf("top dock covers the sidebar: %v\n%s", err, term.Snapshot())
+				}
+				if err := term.SendKeys(tuitest.Ctrl('b'), "w", "2", "n"); err != nil {
+					t.Fatal(err)
+				}
+				waitDockStatus(t, term, "top", 2, 1, "second workspace")
+				if err := term.SendKeys(tuitest.Ctrl('b'), "w", "1"); err != nil {
+					t.Fatal(err)
+				}
+				waitDockStatus(t, term, "top", 1, 1, "first workspace")
+				col := pillCol(term.Screen().Line(0), "2")
+				if col < 0 {
+					t.Fatalf("workspace tab missing: %s", term.Screen().Line(0))
+				}
+				leftClick(t, term, col+1, 0)
+				waitDockStatus(t, term, "top", 2, 1, "shifted workspace tab click")
+				if err := term.Resize(160, compactRows); err != nil {
+					t.Fatal(err)
+				}
+				if err := term.WaitFor(func(s tuitest.Screen) bool {
+					cols, _ := s.Size()
+					return cols == 160 && checkRails(s) && strings.Contains(s.Line(0), "2:1")
+				}, uiTimeout); err != nil {
+					t.Fatalf("resized dock escaped pane bounds: %v\n%s", err, term.Snapshot())
+				}
+				saveArtifact(t, term, artifactDir(t), "top-dock-between-rails")
+				if err := term.Resize(39, compactRows); err != nil {
+					t.Fatal(err)
+				}
+				if err := term.WaitFor(func(s tuitest.Screen) bool {
+					cols, _ := s.Size()
+					return cols == 39 && strings.Contains(s.Line(0), "2:1") &&
+						s.Cell(27, 0).Rune != '│' && s.Cell(11, 0).Rune != '│'
+				}, uiTimeout); err != nil {
+					t.Fatalf("dock did not expand when narrow-screen rails hid: %v\n%s", err, term.Snapshot())
+				}
+				if err := term.Resize(140, compactRows); err != nil {
+					t.Fatal(err)
+				}
+				if err := term.WaitFor(checkRails, uiTimeout); err != nil {
+					t.Fatalf("dock did not release the restored sidebars: %v\n%s", err, term.Snapshot())
+				}
+			})
+		}
+	}
+}
