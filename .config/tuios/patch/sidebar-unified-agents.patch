--- /dev/null
+++ w/internal/app/dock_geometry.go
@@ -0,0 +1,68 @@
+package app
+
+import "image"
+
+func (m *OS) dockBounds() image.Rectangle {
+	width, height := m.GetRenderWidth(), m.GetRenderHeight()
+	left, right := 0, width
+	y := max(height-m.Settings.DockHeight(), 0)
+	if m.Settings.DockbarPosition == "top" {
+		reserve := m.viewReserve()
+		left = min(reserve.Left, width)
+		right = max(left, width-reserve.Right)
+		y = 0
+	}
+	return image.Rect(left, y, right, min(y+m.Settings.DockHeight(), height))
+}
+
+// DockBandContains reports whether a pointer is inside the dock's drawn band,
+// excluding the sidebars beside a top dock.
+func (m *OS) DockBandContains(x, y int) bool {
+	if m.Settings.DockbarPosition == "hidden" {
+		return false
+	}
+	x, y = m.ScreenPoint(x, y)
+	return image.Pt(x, y).In(m.dockBounds())
+}
+
+// placeDockHits converts this render pass's local columns into screen columns.
+// Clipping prevents controls cut from a crowded dock from claiming a rail.
+func (m *OS) placeDockHits(bounds image.Rectangle) {
+	place := func(x0, x1 int) (int, int) {
+		return min(max(x0+bounds.Min.X, bounds.Min.X), bounds.Max.X),
+			min(max(x1+bounds.Min.X, bounds.Min.X), bounds.Max.X)
+	}
+	for i := range m.dockWorkspaceHits {
+		h := &m.dockWorkspaceHits[i]
+		h.X0, h.X1 = place(h.X0, h.X1)
+	}
+	for i := range m.dockWorkspaceArrowHits {
+		h := &m.dockWorkspaceArrowHits[i]
+		h.X0, h.X1 = place(h.X0, h.X1)
+	}
+	for i := range m.dockItemHits {
+		h := &m.dockItemHits[i]
+		h.X0, h.X1 = place(h.X0, h.X1)
+	}
+	for i := range m.dockCustomHits {
+		h := &m.dockCustomHits[i]
+		h.X0, h.X1 = place(h.X0, h.X1)
+	}
+	for i := range m.dockSessionHits {
+		h := &m.dockSessionHits[i]
+		h.X0, h.X1 = place(h.X0, h.X1)
+	}
+	if h := &m.dockOverflowHit; h.Active {
+		h.X0, h.X1 = place(h.X0, h.X1)
+		h.Active = h.X1 > h.X0
+	}
+	if h := &m.notifHit; h.Active {
+		h.X0, h.X1 = place(h.X0, h.X1)
+		h.DismissX0, _ = place(h.DismissX0, h.DismissX0)
+		h.Active = h.X1 > h.X0
+	}
+	if h := &m.spotlight.chip; h.drawn {
+		h.x0, h.x1 = place(h.x0, h.x1)
+		h.drawn = h.x1 > h.x0
+	}
+}
