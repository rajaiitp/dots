diff --git i/internal/app/sidebar_ui.go w/internal/app/sidebar_ui.go
new file mode 100644
index 0000000..92969da
--- /dev/null
+++ w/internal/app/sidebar_ui.go
@@ -0,0 +1,258 @@
+package app
+
+import (
+	"image/color"
+	"strings"
+
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/overlay"
+	"github.com/Gaurav-Gosain/tuios/internal/sessiontree"
+	"github.com/Gaurav-Gosain/tuios/internal/theme"
+)
+
+type sidebarUIElement uint8
+
+const (
+	sidebarUIElementInvalid sidebarUIElement = iota
+	sidebarUIOverviewHeader
+	sidebarUISpace
+	sidebarUIRepository
+	sidebarUISession
+	sidebarUIBranch
+	sidebarUIAgent
+	sidebarUIDockHeader
+	sidebarUIMode
+	sidebarUIWorkspace
+	sidebarUIStatus
+	sidebarUIWindow
+	sidebarUIInfo
+	sidebarUISessionControl
+	sidebarUIFooter
+)
+
+type sidebarUIResolvedStyle struct {
+	visible      bool
+	align        string
+	fg           color.Color
+	bg           color.Color
+	bold         bool
+	fullWidth    bool
+	paddingLeft  int
+	paddingRight int
+	indent       *int
+}
+
+func (m *OS) sidebarUIConfig() config.SidebarUIConfig {
+	if m.UserConfig == nil {
+		return config.SidebarUIConfig{}
+	}
+	return m.UserConfig.Appearance.Sidebar.UI
+}
+
+func (m *OS) sidebarUIElementConfig(element sidebarUIElement) config.SidebarElementStyle {
+	ui := m.sidebarUIConfig()
+	switch element {
+	case sidebarUIOverviewHeader:
+		return ui.OverviewHeader
+	case sidebarUISpace:
+		return ui.Space
+	case sidebarUIRepository:
+		return ui.Repository
+	case sidebarUISession:
+		return ui.Session
+	case sidebarUIBranch:
+		return ui.Branch
+	case sidebarUIAgent:
+		return ui.Agent
+	case sidebarUIDockHeader:
+		return ui.DockHeader
+	case sidebarUIMode:
+		return ui.Mode
+	case sidebarUIWorkspace:
+		return ui.Workspace
+	case sidebarUIStatus:
+		return ui.Status
+	case sidebarUIWindow:
+		return ui.Window
+	case sidebarUIInfo:
+		return ui.Info
+	case sidebarUISessionControl:
+		return ui.SessionControl
+	case sidebarUIFooter:
+		return ui.Footer
+	case sidebarUIElementInvalid:
+		return config.SidebarElementStyle{}
+	}
+	return config.SidebarElementStyle{}
+}
+
+func sidebarUIBool(value *bool, fallback bool) bool {
+	if value == nil {
+		return fallback
+	}
+	return *value
+}
+
+func sidebarUIInt(value *int, fallback, low, high int) int {
+	if value == nil {
+		return fallback
+	}
+	return min(max(*value, low), high)
+}
+
+func (m *OS) sidebarUIVisible(element sidebarUIElement, fallback bool) bool {
+	return sidebarUIBool(m.sidebarUIElementConfig(element).Visible, fallback)
+}
+
+func (m *OS) sidebarUIElementConfigured(element sidebarUIElement) bool {
+	cfg := m.sidebarUIElementConfig(element)
+	return cfg.Visible != nil || cfg.Align != "" || cfg.Foreground != "" || cfg.Background != "" ||
+		cfg.ActiveForeground != "" || cfg.ActiveBackground != "" || cfg.Bold != nil || cfg.ActiveBold != nil ||
+		cfg.FullWidth != nil || cfg.PaddingLeft != nil || cfg.PaddingRight != nil || cfg.Indent != nil ||
+		cfg.BottomOffsetPercent != nil
+}
+
+func (m *OS) sidebarUIBottomOffsetPercent(element sidebarUIElement) (int, bool) {
+	value := m.sidebarUIElementConfig(element).BottomOffsetPercent
+	if value == nil {
+		return 0, false
+	}
+	return min(max(*value, 0), 100), true
+}
+
+func (m *OS) sidebarUIResolved(element sidebarUIElement, active bool, pal overlay.Palette,
+	fallbackFg, fallbackBg color.Color, fallbackBold, fallbackFullWidth bool,
+) sidebarUIResolvedStyle {
+	cfg := m.sidebarUIElementConfig(element)
+	fg, bg := fallbackFg, fallbackBg
+	fgValue, bgValue := cfg.Foreground, cfg.Background
+	if active {
+		if cfg.ActiveForeground != "" {
+			fgValue = cfg.ActiveForeground
+		}
+		if cfg.ActiveBackground != "" {
+			bgValue = cfg.ActiveBackground
+		}
+	}
+	if value := theme.ConfigColorOn(fgValue, &pal); value != nil {
+		fg = value
+	}
+	if value := theme.ConfigColorOn(bgValue, &pal); value != nil {
+		bg = value
+	}
+	bold := sidebarUIBool(cfg.Bold, fallbackBold)
+	if active && cfg.ActiveBold != nil {
+		bold = *cfg.ActiveBold
+	}
+	align := strings.ToLower(strings.TrimSpace(cfg.Align))
+	if align != "center" && align != "right" {
+		align = "left"
+	}
+	return sidebarUIResolvedStyle{
+		visible:      sidebarUIBool(cfg.Visible, true),
+		align:        align,
+		fg:           fg,
+		bg:           bg,
+		bold:         bold,
+		fullWidth:    sidebarUIBool(cfg.FullWidth, fallbackFullWidth),
+		paddingLeft:  sidebarUIInt(cfg.PaddingLeft, 0, 0, 12),
+		paddingRight: sidebarUIInt(cfg.PaddingRight, 0, 0, 12),
+		indent:       cfg.Indent,
+	}
+}
+
+func (style sidebarUIResolvedStyle) rowBackground(fallback color.Color) color.Color {
+	if style.bg != nil {
+		return style.bg
+	}
+	return fallback
+}
+
+func (style sidebarUIResolvedStyle) rowIndent(fallback int) int {
+	if style.indent == nil {
+		return fallback
+	}
+	return min(max(*style.indent, 0), 24)
+}
+
+func (style sidebarUIResolvedStyle) render(text string, width int) string {
+	width = max(width, 0)
+	inside := max(width-style.paddingLeft-style.paddingRight, 0)
+	text = overlay.Truncate(text, inside)
+	textWidth := lipgloss.Width(text)
+	left, right := style.paddingLeft, style.paddingRight
+	spare := max(inside-textWidth, 0)
+	switch style.align {
+	case "center":
+		left += spare / 2
+		right += spare - spare/2
+	case "right":
+		left += spare
+	default:
+		if style.fullWidth {
+			right += spare
+		}
+	}
+	body := strings.Repeat(" ", left) + text + strings.Repeat(" ", right)
+	ui := lipgloss.NewStyle().Bold(style.bold)
+	if style.fg != nil {
+		ui = ui.Foreground(style.fg)
+	}
+	if style.bg != nil {
+		ui = ui.Background(style.bg)
+	}
+	return ui.Render(body)
+}
+
+func (m *OS) sidebarUIOverviewElement(row sidebarOverviewRow) sidebarUIElement {
+	switch row.Kind {
+	case sidebarOverviewAgent:
+		return sidebarUIAgent
+	case sidebarOverviewNode:
+		switch row.Node.Kind {
+		case sessiontree.KindSpace:
+			return sidebarUISpace
+		case sessiontree.KindRepo:
+			return sidebarUIRepository
+		case sessiontree.KindSession:
+			if row.Node.Worktree != nil {
+				return sidebarUIBranch
+			}
+			return sidebarUISession
+		}
+	}
+	return sidebarUIElementInvalid
+}
+
+func (m *OS) sidebarUIFilterOverview(rows []sidebarOverviewRow) []sidebarOverviewRow {
+	out := rows[:0]
+	for _, row := range rows {
+		if row.Kind == sidebarOverviewGap {
+			if len(out) > 0 {
+				out = append(out, row)
+			}
+			continue
+		}
+		element := m.sidebarUIOverviewElement(row)
+		if element != sidebarUIElementInvalid && m.sidebarUIVisible(element, true) {
+			out = append(out, row)
+		}
+	}
+	for len(out) > 0 && out[len(out)-1].Kind == sidebarOverviewGap {
+		out = out[:len(out)-1]
+	}
+	return out
+}
+
+func (m *OS) sidebarUISectionGap() int {
+	fallback := 0
+	if m.Settings.RailRoomy {
+		fallback = 1
+	}
+	return sidebarUIInt(m.sidebarUIConfig().SectionGap, fallback, 0, 6)
+}
+
+func (m *OS) sidebarUIDockGroupGap() int {
+	return sidebarUIInt(m.sidebarUIConfig().DockGroupGap, 1, 0, 6)
+}
