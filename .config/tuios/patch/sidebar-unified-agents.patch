+func TestSidebarDockAnchorsWorkspaceTabsAboveBottomControls(t *testing.T) {
+	m, _ := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview,dock"
+	cfg, err := config.ParseUserConfig([]byte(`
+[dock]
+left = ["workspaces", "tape"]
+center = ["windows"]
+right = ["notifications", "copy-help", "cpu", "ram", "clock", "session-controls"]
+
+[appearance.sidebar.ui.workspace]
+bottom_offset_percent = 33
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.UserConfig = cfg
+	m.dockPlan = dockPlan{}
+	const height = 30
+	lines, zones := m.sidebarDockFooter(24, height, m.groundUI(), -1, -1)
+	firstWorkspace, lastControl := -1, -1
+	for _, zone := range zones {
+		switch zone.Kind {
+		case sidebarRowDockWorkspace:
+			if firstWorkspace < 0 || zone.Line < firstWorkspace {
+				firstWorkspace = zone.Line
+			}
+		case sidebarRowDockSessionControl:
+			lastControl = max(lastControl, zone.Line)
+		}
+	}
+	wantDistance := (height*33 + 99) / 100
+	if got := len(lines) - firstWorkspace; firstWorkspace < 0 || got != wantDistance {
+		t.Fatalf("workspace distance from bottom = %d, want %d; zones=%+v", got, wantDistance, zones)
+	}
+	if lastControl < 0 || lastControl >= len(lines) || len(lines)-lastControl != 1 {
+		t.Fatalf("session controls did not remain bottom-pinned: line=%d height=%d", lastControl, len(lines))
+	}
+}
