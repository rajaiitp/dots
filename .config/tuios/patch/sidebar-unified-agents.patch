+func assertOverviewNameStyleWithAccent(t *testing.T, m *OS, tree sessiontree.Tree, name string, accented bool) {
+	t.Helper()
+	row := styledRow(t, railStyled(t, m, tree), name)
+	plain := stripANSIForTrace(row)
+	nameCol := lipgloss.Width(plain[:strings.Index(plain, name)])
+	width := lipgloss.Width(row) - 1
+	canvas := uv.NewScreenBuffer(width, 1)
+	uv.NewStyledString(row).Draw(canvas, canvas.Bounds())
+	pal := m.groundUI()
+	ground := canvas.CellAt(nameCol, 0).Style.Bg
+	if ground == nil {
+		ground = m.railGround()
+	}
+	wantFg := pal.Fg
+	if accented {
+		wantFg = theme.Readable(pal.Accent, ground)
+	}
+	for x := nameCol; x < nameCol+lipgloss.Width(name); x++ {
+		cell := canvas.CellAt(x, 0)
+		if cell == nil {
+			t.Fatalf("name cell %d is missing", x)
+		}
+		if cell.Style.Attrs&uv.AttrBold == 0 {
+			t.Fatalf("overview name %q is not bold: %+v", name, cell.Style)
+		}
+		if !samePaneColor(cell.Style.Fg, wantFg) {
+			t.Fatalf("name %q foreground = %v, want %v", name, cell.Style.Fg, wantFg)
+		}
+	}
+}
