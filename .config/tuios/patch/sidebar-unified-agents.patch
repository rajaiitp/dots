+func TestOverviewSectionCycleReachesTheNextConfiguredSection(t *testing.T) {
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview,files"
+	m.loadFileViewNow(t, fileViewTree(t))
+	m.sidebarPanelLinesForTree(tree)
+
+	m.SidebarCursor = navIndexOfSession(m, "main")
+	m.SidebarCycleSection()
+	row, ok := m.sidebarCursorRow()
+	if !ok || m.sidebarSectionOfKind(row.Kind) != sidebarSectionFiles {
+		t.Fatalf("cycle landed on %+v, want the files section", row)
+	}
+
+	for i, candidate := range m.SidebarNav {
+		if candidate.Kind == sidebarRowNewSession {
+			m.SidebarCursor = i
+			m.SidebarCycleSection()
+			row, ok = m.sidebarCursorRow()
+			if !ok || m.sidebarSectionOfKind(row.Kind) != sidebarSectionFiles {
+				t.Fatalf("cycle from overview header landed on %+v, want the files section", row)
+			}
+			return
+		}
+	}
+	t.Fatal("overview header did not publish its new-session control")
+}
