+func TestOverviewRailNestsAgentsWithoutTerminalContext(t *testing.T) {
+	m, tree := sectionsTestOS(t, 120, 40)
+	m.Settings.SidebarSections = "overview"
+
+	lines := railPlain(t, m, tree)
+	joined := strings.Join(lines, "\n")
+	for _, want := range []string{"overview", "main", "refactor", "build", "api", "server", "docs"} {
+		if !strings.Contains(joined, want) {
+			t.Fatalf("overview rail does not contain %q:\n%s", want, joined)
+		}
+	}
+	if strings.Contains(joined, "nvim") {
+		t.Fatalf("overview rail exposed a non-agent terminal:\n%s", joined)
+	}
+	for _, pair := range [][2]string{{"main", "refactor"}, {"main", "build"}, {"api", "server"}} {
+		parent, child := lineOf(lines, pair[0]), lineOf(lines, pair[1])
+		if parent < 0 || child <= parent {
+			t.Fatalf("%q is not nested after %q:\n%s", pair[1], pair[0], joined)
+		}
+		parentCol := lipgloss.Width(lines[parent][:strings.Index(lines[parent], pair[0])])
+		childCol := lipgloss.Width(lines[child][:strings.Index(lines[child], pair[1])])
+		if childCol-parentCol != sidebarGroupIndent {
+			t.Fatalf("%q starts at column %d under %q at %d, want one %d-cell hierarchy step:\n%s",
+				pair[1], childCol, pair[0], parentCol, sidebarGroupIndent, joined)
+		}
+	}
+	if lineOf(lines, "server") >= lineOf(lines, "docs") {
+		t.Fatalf("api's agent escaped its session group:\n%s", joined)
+	}
+
+	seen := map[string]bool{}
+	for _, hit := range m.SidebarHits {
+		if hit.Kind == sidebarRowWindow {
+			t.Fatalf("overview published terminal hit %+v", hit)
+		}
+		if hit.Kind == sidebarRowAgent {
+			seen[hit.WindowID] = true
+		}
+	}
+	for _, id := range []string{"bbbbbbbb2222", "cccccccc3333", "dddddddd4444"} {
+		if !seen[id] {
+			t.Errorf("overview did not publish a pane hit for %s", id)
+		}
+	}
+}
