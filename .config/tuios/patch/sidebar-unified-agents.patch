diff --git i/e2e/tui/dock_growing_tabs_test.go w/e2e/tui/dock_growing_tabs_test.go
new file mode 100644
index 0000000..0f1c8ae
--- /dev/null
+++ w/e2e/tui/dock_growing_tabs_test.go
@@ -0,0 +1,112 @@
+package tuie2e
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/Gaurav-Gosain/tuitest"
+)
+
+func TestDockFlatTabsGrowWithLabels(t *testing.T) {
+	for _, tc := range []struct {
+		minimum int
+		labels  [3]string
+		widths  [3]int
+	}{
+		{8, [3]string{"   A    ", "  longname  ", "   界   "}, [3]int{8, 12, 8}},
+		{12, [3]string{"     A      ", "  longname  ", "     界     "}, [3]int{12, 12, 12}},
+	} {
+		t.Run(fmt.Sprintf("minimum=%d", tc.minimum), func(t *testing.T) {
+			base := t.TempDir()
+			writeConfig(t, base, fmt.Sprintf(`[appearance]
+dockbar_position = "top"
+dock_compact = true
+dock_background = "#101010"
+dock_workspace_tab_format = "{icon}"
+dock_workspace_label_max = 0
+[dock]
+left = ["workspaces", "trail"]
+center = []
+right = []
+[dock.tabs]
+style = "flat"
+min_width = %d
+padding = 2
+show_add = true
+active_bg = "accent"
+active_fg = "#101010"
+active_bold = true
+inactive_bg = "#3c3836"
+inactive_fg = "#d4be98"
+number_glyphs = ["A", "longname", "界"]
+`, tc.minimum))
+			term := startIn(t, base, startOpts{cols: 140, rows: 30})
+			waitBoot(t, term)
+			if err := term.SendKeys("n"); err != nil {
+				t.Fatal(err)
+			}
+			waitDockStatus(t, term, "top", 1, 1, "first workspace")
+			for _, ws := range []int{2, 3} {
+				if err := term.SendKeys(tuitest.Ctrl('b'), "w", fmt.Sprint(ws), "n"); err != nil {
+					t.Fatal(err)
+				}
+				waitDockStatus(t, term, "top", ws, 1, "new workspace")
+			}
+			if err := term.SendKeys(tuitest.Ctrl('b'), "w", "1"); err != nil {
+				t.Fatal(err)
+			}
+			joined := strings.Join(tc.labels[:], " ")
+			if err := term.WaitFor(func(s tuitest.Screen) bool {
+				return strings.Contains(s.Line(0), joined) && strings.Contains(s.Line(0), "1:1")
+			}, uiTimeout); err != nil {
+				t.Fatalf("tabs did not grow with padded labels: %v\n%s", err, term.Snapshot())
+			}
+			first := strings.Index(term.Screen().Line(0), joined)
+			offsets := [3]int{0, tc.widths[0] + 1, tc.widths[0] + tc.widths[1] + 2}
+			checkPaint := func(s tuitest.Screen, current int) bool {
+				active := s.Cell(first+offsets[current], 0).Bg
+				inactive := s.Cell(first+offsets[(current+1)%3], 0).Bg
+				if active == inactive || inactive == s.Cell(0, 0).Bg {
+					return false
+				}
+				for tab, width := range tc.widths {
+					bg := inactive
+					if tab == current {
+						bg = active
+					}
+					for col := range width {
+						x := first + offsets[tab] + col
+						cell := s.Cell(x, 0)
+						if cell.Width == 0 && col > 0 && s.Cell(x-1, 0).Width == 2 {
+							cell = s.Cell(x-1, 0)
+						}
+						if cell.Bg != bg {
+							return false
+						}
+					}
+				}
+				return true
+			}
+			if !checkPaint(term.Screen(), 0) {
+				t.Fatalf("tab backgrounds do not cover their padding: %s", term.Snapshot())
+			}
+			leftClick(t, term, first+offsets[1]+tc.widths[1]-1, 0)
+			if err := term.WaitFor(func(s tuitest.Screen) bool {
+				return strings.Contains(s.Line(0), "2:1") && strings.Contains(s.Line(0), joined) && checkPaint(s, 1)
+			}, uiTimeout); err != nil {
+				t.Fatalf("clicking tab padding missed its workspace: %v\n%s", err, term.Snapshot())
+			}
+			if err := term.Resize(100, 30); err != nil {
+				t.Fatal(err)
+			}
+			if err := term.WaitFor(func(s tuitest.Screen) bool {
+				cols, _ := s.Size()
+				return cols == 100 && strings.Contains(s.Line(0), joined) && checkPaint(s, 1)
+			}, uiTimeout); err != nil {
+				t.Fatalf("resizing changed the tab dimensions: %v\n%s", err, term.Snapshot())
+			}
+			saveArtifact(t, term, artifactDir(t), "growing-flat-tabs")
+		})
+	}
+}
