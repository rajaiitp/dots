+		}
+	}
+}
+
+func TestOverviewGroupsPrimaryAndLinkedCheckoutsAsEqualBranchRows(t *testing.T) {
+	m, _ := worktreeRailOS(t, 120, 30)
+	m.SessionName = "dots"
+	m.Settings.SidebarSections = "overview"
+	tree := sessiontree.Build([]sessiontree.SessionInput{
+		{
+			Name: "dots", Branch: "main", Attached: true, IsCurrent: true, CurrentWorkspace: 1,
+			Windows: []sessiontree.WindowInput{{ID: "aaaaaaaa1111", Title: "nvim", Focused: true, Workspace: 1}},
+		},
+		{
+			Name: "mac", Worktree: &sessiontree.WorktreeRef{Repo: "dots", Branch: "mac"},
+			Windows: []sessiontree.WindowInput{{ID: "bbbbbbbb2222", Title: "pi", AgentState: "working", Workspace: 1}},
+		},
+		{Name: "dots-test", Worktree: &sessiontree.WorktreeRef{Repo: "dots", Branch: "test"}},
+		{Name: "docs-preview", Worktree: &sessiontree.WorktreeRef{Repo: "docs", Branch: "preview"}},
+	})
+
+	lines := railPlain(t, m, tree)
+	repoLine, repoHit := railRowLine(t, m, lines, sidebarRowRepo, "dots")
+	mainLine, mainHit := railRowLine(t, m, lines, sidebarRowSession, "dots")
+	macLine, macHit := railRowLine(t, m, lines, sidebarRowSession, "mac")
+	testLine, testHit := railRowLine(t, m, lines, sidebarRowSession, "dots-test")
+	agentLine, agentHit := railRowLine(t, m, lines, sidebarRowAgent, "mac")
+
+	row := func(hit sidebarRowHit) int { return hit.Y0 - m.GetTopMargin() }
+	if !(row(repoHit) < row(mainHit) && row(mainHit) < row(macHit) && row(macHit) < row(agentHit) && row(agentHit) < row(testHit)) {
+		t.Fatalf("repository hierarchy is out of order:\n%s", strings.Join(lines, "\n"))
+	}
+	col := func(line, label string) int {
+		return lipgloss.Width(line[:strings.Index(line, label)])
+	}
+	repoCol := col(repoLine, "dots")
+	mainCol, macCol, testCol := col(mainLine, "main"), col(macLine, "mac"), col(testLine, "test")
+	if mainCol != macCol || macCol != testCol || mainCol-repoCol != sidebarGroupIndent {
+		t.Fatalf("branch columns main=%d mac=%d test=%d repo=%d, want equal rows one hierarchy step under the repository:\n%s",
+			mainCol, macCol, testCol, repoCol, strings.Join(lines, "\n"))
+	}
+	if agentCol := col(agentLine, "pi"); agentCol-macCol != sidebarGroupIndent {
+		t.Fatalf("agent column = %d under branch at %d, want one %d-cell hierarchy step:\n%s",
+			agentCol, macCol, sidebarGroupIndent, strings.Join(lines, "\n"))
+	}
+	joined := strings.Join(lines, "\n")
+	for _, connector := range []string{m.Settings.GetRailTreeBranch(), m.Settings.GetRailTreeLast()} {
+		if strings.Contains(joined, connector) {
+			t.Fatalf("overview retained tree connector %q:\n%s", connector, joined)
+		}
+	}
+	if tree.Sessions[0].Worktree != nil {
+		t.Fatal("overview grouping changed the primary session into a linked worktree")
+	}
+	assertOverviewRepositoryNameStyle(t, m, tree, "dots", true)
+	assertOverviewRepositoryNameStyle(t, m, tree, "docs", false)
+
+	m.SidebarCollapsedRepos = map[string]bool{"dots": true}
+	lines = railPlain(t, m, tree)
+	joined = strings.Join(lines, "\n")
