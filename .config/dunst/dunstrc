# Dunst — Gruvbox Dark (orange accent) — square corners
# Only overrides colors + corners; everything else inherits from /etc/dunst/dunstrc

[global]
    frame_width = 1
    frame_color = "#504945"                    # surface1
    corner_radius = 0
    separator_color = frame
    font = "JetBrainsMono Nerd Font Mono 10"
    # Explicitly include the installed Pop/Adwaita status icons used by OSDs.
    icon_theme = Pop
    icon_path = /usr/share/icons/Pop/scalable/status/:/usr/share/icons/Adwaita/symbolic/status/:/usr/share/icons/AdwaitaLegacy/48x48/legacy/
    origin = top-right
    offset = (10, 50)
    width = 320
    padding = 10
    horizontal_padding = 12
    progress_bar_corner_radius = 0
    icon_corner_radius = 0

[urgency_low]
    background = "#1d2021"                     # surface
    foreground = "#a89984"                     # subtle
    frame_color = "#504945"                    # highlight-med
    timeout = 5

[urgency_normal]
    background = "#3c3836"                     # overlay
    foreground = "#ebdbb2"                     # text
    frame_color = "#fe8019"                    # mauve (accent)
    timeout = 8

[urgency_critical]
    background = "#3c3836"                     # overlay
    foreground = "#ebdbb2"                     # text
    frame_color = "#fb4934"                    # love
    timeout = 60
