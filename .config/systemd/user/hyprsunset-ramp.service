[Unit]
Description=Smooth sunrise/sunset color-temperature ramp for Hyprsunset
After=graphical-session-pre.target

[Service]
Type=simple
# Retry until this user service has the live Hyprland IPC environment and the
# native Hyprsunset daemon launched by Hyprland autostart is available.
ExecStartPre=/usr/bin/hyprctl -j monitors
ExecStartPre=/usr/bin/pgrep -x hyprsunset
ExecStart=%h/.config/hypr/scripts/hyprsunset-ramp.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
