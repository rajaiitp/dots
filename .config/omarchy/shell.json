{
  "version": 1,
  "idle": {
    "screensaver": 86400,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 9
        },
        {
          "id": "raja.system-stats"
        },
        {
          "id": "omarchy.spacer",
          "size": 9
        },
        {
          "id": "raja.power",
          "showPercentage": true
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.spacer",
          "size": 9
        },
        {
          "id": "raja.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "raja.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "raja.tray",
          "alwaysExpanded": false,
          "passiveDrawerOnly": true
        },
        {
          "id": "raja.indicators",
          "alwaysShow": false,
          "items": [
            "Dictation",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "raja.monitor"
        }
      ]
    },
    "id": "raja.bar"
  },
  "plugins": []
}
