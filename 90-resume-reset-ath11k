#!/bin/sh
# Recover the QCNFA765 / ath11k Wi-Fi PCI function on demand from the
# Omarchy network panel. systemd-sleep may invoke this as
# pre|post <sleep-operation>, but those paths intentionally do no recovery.

PATH=/usr/local/sbin:/usr/local/bin:/usr/bin

BDF=0000:02:00.0
DEVICE=/sys/bus/pci/devices/$BDF
DRIVER_DIR=/sys/bus/pci/drivers/ath11k_pci
RESET=$DEVICE/reset
BIND=$DRIVER_DIR/bind
UNBIND=$DRIVER_DIR/unbind
LOCK=/run/lock/ath11k-pci-recovery.lock
SYSFS_TIMEOUT=15

log() {
  logger -t resume-ath11k-reset "$*"
}

write_control() {
  _write_label=$1
  _write_path=$2
  _write_value=$3
  _write_output=$(
    timeout --signal=TERM --kill-after=2s "${SYSFS_TIMEOUT}s" \
      sh -c 'printf "%s\n" "$1" >"$2"' sh \
      "$_write_value" "$_write_path" 2>&1
  )
  _write_status=$?

  if [ "$_write_status" -eq 0 ]; then
    return 0
  fi

  if [ -n "$_write_output" ]; then
    log "$_write_label failed (exit $_write_status): $_write_output"
  else
    log "$_write_label failed (exit $_write_status)"
  fi
  return 1
}

wait_unbound() {
  _wait_count=0
  while [ "$_wait_count" -lt 50 ]; do
    [ ! -L "$DEVICE/driver" ] && return 0
    sleep 0.2
    _wait_count=$((_wait_count + 1))
  done
  return 1
}

wait_bound() {
  _wait_count=0
  while [ "$_wait_count" -lt 75 ]; do
    _wait_driver=$(readlink "$DEVICE/driver" 2>/dev/null || true)
    case "$_wait_driver" in
      */ath11k_pci) return 0 ;;
      "") ;;
      *)
        log "unexpected driver after bind: $_wait_driver"
        return 1
        ;;
    esac
    sleep 0.2
    _wait_count=$((_wait_count + 1))
  done
  return 1
}

wait_netdev() {
  _wait_count=0
  while [ "$_wait_count" -lt 50 ]; do
    for _netdev in "$DEVICE"/net/*; do
      [ -e "$_netdev" ] && return 0
    done
    sleep 0.2
    _wait_count=$((_wait_count + 1))
  done
  return 1
}

bind_device() {
  _bind_driver=$(readlink "$DEVICE/driver" 2>/dev/null || true)
  case "$_bind_driver" in
    */ath11k_pci) ;;
    "")
      log "binding QCNFA765 to ath11k_pci"
      write_control "ath11k driver bind" "$BIND" "$BDF" || return 1
      ;;
    *)
      log "refusing bind because another driver is active: $_bind_driver"
      return 1
      ;;
  esac

  if ! wait_bound; then
    log "ath11k_pci did not bind within 15 seconds"
    return 1
  fi
  if ! wait_netdev; then
    log "ath11k_pci rebound but did not create a network interface"
    return 1
  fi
  return 0
}

validate_target() {
  if [ "$(id -u)" -ne 0 ]; then
    log "refusing ath11k recovery without root privileges"
    return 1
  fi
  if [ ! -d "$DEVICE" ]; then
    log "QCNFA765 PCI device is unavailable"
    return 1
  fi

  _vendor=$(cat "$DEVICE/vendor" 2>/dev/null) || {
    log "unable to read PCI vendor"
    return 1
  }
  _device_id=$(cat "$DEVICE/device" 2>/dev/null) || {
    log "unable to read PCI device ID"
    return 1
  }
  if [ "$_vendor" != 0x17cb ] || [ "$_device_id" != 0x1103 ]; then
    log "refusing recovery for unexpected PCI device $_vendor:$_device_id"
    return 1
  fi

  # The kernel selected a bus reset. Refuse it if another function ever appears
  # on this bus, because that reset could disrupt the sibling device too.
  for _peer in /sys/bus/pci/devices/0000:02:*; do
    if [ "$_peer" != "$DEVICE" ]; then
      log "refusing bus reset while sibling PCI device ${_peer##*/} is present"
      return 1
    fi
  done

  for _control in "$RESET" "$BIND" "$UNBIND"; do
    if [ ! -w "$_control" ]; then
      log "required PCI control is unavailable: $_control"
      return 1
    fi
  done

  _target_driver=$(readlink "$DEVICE/driver" 2>/dev/null || true)
  case "$_target_driver" in
    */ath11k_pci|"") return 0 ;;
    *)
      log "refusing recovery because another driver is active: $_target_driver"
      return 1
      ;;
  esac
}

recover_device() {
  validate_target || return 1

  # Serialize repair clicks from multiple panel instances.
  exec 9>"$LOCK" || {
    log "unable to open ath11k recovery lock"
    return 1
  }
  if ! flock -n 9; then
    log "another ath11k recovery is already running"
    exec 9>&-
    return 75
  fi

  _active_driver=$(readlink "$DEVICE/driver" 2>/dev/null || true)
  if [ -n "$_active_driver" ]; then
    log "unbinding wedged QCNFA765 from ath11k_pci"
    if ! write_control "ath11k driver unbind" "$UNBIND" "$BDF"; then
      # A timed-out sysfs write may still have completed before termination.
      if [ ! -L "$DEVICE/driver" ]; then
        log "unbind reported failure after detaching; restoring the driver"
        bind_device || log "failed to restore ath11k_pci after unbind failure"
      fi
      exec 9>&-
      return 1
    fi
    if ! wait_unbound; then
      log "ath11k_pci remained bound after unbind"
      exec 9>&-
      return 1
    fi
  else
    log "QCNFA765 is already unbound; continuing recovery"
  fi

  log "resetting isolated QCNFA765 PCI bus function"
  if ! write_control "QCNFA765 PCI reset" "$RESET" 1; then
    bind_device || log "failed to restore ath11k_pci after reset failure"
    exec 9>&-
    return 1
  fi

  sleep 1
  if ! bind_device; then
    log "QCNFA765 reset completed, but ath11k_pci recovery failed"
    exec 9>&-
    return 1
  fi

  log "ath11k recovery completed; driver and network interface restored"
  exec 9>&-
  return 0
}

MODE=${1:-}
case "$MODE" in
  post)
    [ "${2:-}" = suspend ] || exit 0
    # systemd-sleep runs post hooks while user.slice is still frozen. The
    # ath11k driver's remove path can take about 18 seconds after resume, so
    # running recovery here makes the lock screen appear hung. Automatic
    # recovery is intentionally disabled; the network panel's manual repair
    # action runs this helper after the desktop has resumed.
    exit 0
    ;;
  manual)
    ;;
  *)
    exit 0
    ;;
esac

recover_device
