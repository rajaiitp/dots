diff --git a/extensions/herdr-command-completion.ts b/extensions/herdr-command-completion.ts
new file mode 100644
index 0000000..86035ed
--- /dev/null
+++ b/extensions/herdr-command-completion.ts
@@ -0,0 +1,130 @@
+import { promises as fs, watch, type FSWatcher } from "node:fs";
+import * as path from "node:path";
+
+export type CommandCompletion = {
+	sequence: number;
+	exitCode: number;
+};
+
+export type CommandCompletionRequest = {
+	paneId: string;
+	paneLabel: string;
+	command: string;
+	initialSequence?: number;
+};
+
+const STATUS_DIR_NAME = "pi-herdr-status";
+
+function statusPath(paneId: string): string {
+	const safePaneId = paneId.replace(/\//g, "_");
+	return path.join(process.env.XDG_RUNTIME_DIR || "/tmp", STATUS_DIR_NAME, `${safePaneId}.status`);
+}
+
+async function readStatus(file: string): Promise<CommandCompletion | undefined> {
+	try {
+		const text = (await fs.readFile(file, "utf8")).trim();
+		const match = /^(\d+):(-?\d+)$/.exec(text);
+		if (!match) return undefined;
+		return { sequence: Number(match[1]), exitCode: Number(match[2]) };
+	} catch {
+		return undefined;
+	}
+}
+
+export type CommandCompletionObserver = {
+	stop: () => void;
+};
+
+/**
+ * Emulate an execution callback using the shell's private precmd status file.
+ * The shell writes one monotonically increasing sequence plus exit status after
+ * each command; fs.watch turns that write into an event without polling Herdr.
+ */
+export function observeCommandCompletion(
+	request: CommandCompletionRequest,
+	onComplete: (completion: CommandCompletion) => void,
+	onError?: (error: Error) => void,
+): CommandCompletionObserver {
+	const file = statusPath(request.paneId);
+	const directory = path.dirname(file);
+	const filename = path.basename(file);
+	let watcher: FSWatcher | undefined;
+	let stopped = false;
+	let completed = false;
+
+	const stop = () => {
+		if (stopped) return;
+		stopped = true;
+		watcher?.close();
+	};
+
+	const finish = (completion: CommandCompletion) => {
+		if (stopped || completed) return;
+		if (request.initialSequence !== undefined && completion.sequence <= request.initialSequence) return;
+		completed = true;
+		stop();
+		onComplete(completion);
+	};
+
+	const check = async () => {
+		const completion = await readStatus(file);
+		if (completion) finish(completion);
+	};
+
+	void (async () => {
+		try {
+			await fs.mkdir(directory, { recursive: true });
+			if (stopped) return;
+			watcher = watch(directory, (_eventType, changedName) => {
+				if (stopped || String(changedName) !== filename) return;
+				void check();
+			});
+			watcher.on("error", (error) => {
+				if (!stopped) onError?.(error instanceof Error ? error : new Error(String(error)));
+			});
+			// Close the race where the command completed before fs.watch started.
+			await check();
+		} catch (error) {
+			if (!stopped) onError?.(error instanceof Error ? error : new Error(String(error)));
+		}
+	})();
+
+	return { stop };
+}
+
+export class CommandCompletionRegistry {
+	private readonly observers = new Map<string, CommandCompletionObserver>();
+
+	isObserved(paneId: string): boolean {
+		return this.observers.has(paneId);
+	}
+
+	observe(
+		request: CommandCompletionRequest,
+		onComplete: (completion: CommandCompletion) => void,
+		onError?: (error: Error) => void,
+	): void {
+		const observer = observeCommandCompletion(request, (completion) => {
+			this.observers.delete(request.paneId);
+			onComplete(completion);
+		}, (error) => {
+			this.observers.delete(request.paneId);
+			onError?.(error);
+		});
+		this.observers.set(request.paneId, observer);
+	}
+
+	stop(paneId: string): void {
+		this.observers.get(paneId)?.stop();
+		this.observers.delete(paneId);
+	}
+
+	stopAll(): void {
+		for (const observer of this.observers.values()) observer.stop();
+		this.observers.clear();
+	}
+}
+
+export async function readCommandSequence(paneId: string): Promise<number | undefined> {
+	return (await readStatus(statusPath(paneId)))?.sequence;
+}
