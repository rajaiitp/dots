+export const buildTaskStateSnapshot = (
+  context: Context,
+  previousDecision?: RoutingDecision,
+  heuristicDecision?: RoutingDecision,
+): TaskStateSnapshot => {
+  const scanMessages = context.messages.slice(-TASK_STATE_SCAN_MESSAGES).map((message) => ({
+    text: extractTextFromContent(message.content),
+    isError:
+      message.role === 'toolResult' &&
+      Boolean((message as Message & { isError?: boolean }).isError),
+  }));
+  const recentMessages = context.messages.slice(-TASK_STATE_CONTEXT_MESSAGES);
+  const recentContext = recentMessages
+    .map((message) => {
+      const text = truncateRoutingText(
+        extractTextFromContent(message.content),
+        TASK_STATE_MESSAGE_CHARS,
+      );
+      return text ? `${message.role}: ${text}` : '';
+    })
+    .filter(Boolean)
+    .join('\n');
+  const latestRequest = getLastUserText(context);
+  const scanText = scanMessages.map((message) => message.text).join('\n');
+  const failureEvidence = collectKeywordEvidence(scanMessages, failureKeywords);
+  const highRiskEvidence = collectKeywordEvidence(
+    scanMessages,
+    highRiskKeywords,
+    false,
+  );
+  const testEvidence = collectKeywordEvidence(scanMessages, testKeywords);
+  const activeFiles = collectFilePaths(scanText);
+  const latestMessage = context.messages[context.messages.length - 1];
+  const hasFailure = failureEvidence.length > 0;
+  const hasHighRisk =
+    highRiskEvidence.length > 0 ||
+    (activeFiles.length >= 6 &&
+      /(?:all|across|multiple|entire|whole|codebase|every)/i.test(scanText));
+
+  return {
+    latestRequest,
+    recentContext,
+    phase:
+      previousDecision?.phase ?? heuristicDecision?.phase ?? 'implementation',
+    lastMessageRole: latestMessage?.role,
+    userTurnCount: context.messages.filter((message) => message.role === 'user')
+      .length,
+    toolResultCount: countToolResults(context),
+    activeFiles,
+    testEvidence,
+    failureEvidence,
+    highRiskEvidence,
+    hasFailure,
+    hasHighRisk,
+    isNewUserTurn: latestMessage?.role === 'user',
+  };
+};
+
+export const shouldRunContextClassifier = (
+  snapshot: TaskStateSnapshot,
+  previousDecision?: RoutingDecision,
+): boolean => {
+  if (!previousDecision) return true;
+  // A new user message defines a new routing boundary. Tool continuations keep
+  // the selected model unless they contain evidence that the task changed or
+  // the previous attempt failed.
+  return snapshot.isNewUserTurn || snapshot.hasFailure || snapshot.hasHighRisk;
+};
+
+export const applyTaskStateGuardrails = (
+  result: ClassifierResult,
+  snapshot: TaskStateSnapshot,
+  heuristicDecision?: RoutingDecision,
+): ClassifierResult => {
+  let tier = result.tier;
+  let reasoning = result.reasoning;
+
+  if (snapshot.hasHighRisk) {
+    tier = 'high';
+    if (result.tier !== 'high') {
+      reasoning = `Task-state guardrail escalated this request to high: ${reasoning}`;
+    }
+  } else if (snapshot.hasFailure && tier === 'low') {
+    tier = 'medium';
+    reasoning = `Task-state guardrail kept failed work above low: ${reasoning}`;
+  } else if (
+    result.confidence !== undefined &&
+    result.confidence < 0.55 &&
+    heuristicDecision
+  ) {
+    tier = heuristicDecision.tier;
+    reasoning = `Low classifier confidence; retained the local task-state route: ${reasoning}`;
+  }
+
+  return tier === result.tier
+    ? result
+    : { ...result, tier, phase: phaseForTier(tier), reasoning };
+};
