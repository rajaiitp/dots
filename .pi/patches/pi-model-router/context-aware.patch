+const parseClassifierResponse = (text: string): ClassifierResult | undefined => {
+  const trimmed = text.trim();
+  const jsonMatch = trimmed.match(/\{[\s\S]*\}/);
+  if (jsonMatch) {
+    try {
+      const parsed = JSON.parse(jsonMatch[0]) as Record<string, unknown>;
+      const tier = typeof parsed.tier === 'string'
+        ? parsed.tier.toLowerCase()
+        : undefined;
+      if (isRouterTier(tier)) {
+        const phase = typeof parsed.phase === 'string' &&
+          ['planning', 'implementation', 'lightweight'].includes(parsed.phase)
+          ? parsed.phase as RouterPhase
+          : undefined;
+        const confidence = typeof parsed.confidence === 'number' &&
+          Number.isFinite(parsed.confidence)
+          ? Math.max(0, Math.min(1, parsed.confidence))
+          : undefined;
+        return {
+          tier,
+          phase,
+          confidence,
+          escalate: parsed.escalate === true,
+          reasoning:
+            typeof parsed.reasoning === 'string' && parsed.reasoning.trim()
+              ? truncateRoutingText(parsed.reasoning, 320)
+              : 'Context-aware classifier decision.',
+        };
+      }
+    } catch {
+      // Fall through to the legacy line parser for recoverable model output.
+    }
+  }
+
+  const lines = trimmed.split('\n');
+  const tierLine = lines.find((line) =>
+    line.toLowerCase().startsWith('tier:'),
+  );
+  const reasoningLine = lines.find((line) =>
+    line.toLowerCase().startsWith('reasoning:'),
+  );
+  if (!tierLine) return undefined;
+
+  const tierValue = tierLine.slice(tierLine.indexOf(':') + 1).trim().toLowerCase();
+  if (!isRouterTier(tierValue)) return undefined;
+  return {
+    tier: tierValue,
+    reasoning: reasoningLine
+      ? reasoningLine.slice(reasoningLine.indexOf(':') + 1).trim()
+      : 'Classifier decision.',
+  };
+};
