+const truncateRoutingText = (text: string, maxChars: number): string => {
+  const normalized = text.replace(/\s+/g, ' ').trim();
+  return normalized.length > maxChars
+    ? `${normalized.slice(0, maxChars - 1)}…`
+    : normalized;
+};
+
+const uniqueLimited = (values: string[], limit = TASK_STATE_MAX_EVIDENCE): string[] =>
+  [...new Set(values.filter(Boolean))].slice(0, limit);
+
+const containsNonNegatedKeyword = (text: string, keyword: string): boolean => {
+  let offset = 0;
+  while (offset < text.length) {
+    const index = text.indexOf(keyword, offset);
+    if (index === -1) return false;
+    const prefix = text.slice(Math.max(0, index - 48), index);
+    const negated = /\b(?:no|not|without|avoid|excluding|unrelated\s+to|does(?:n't|\s+not)|is(?:n't|\s+not))\s+(?:\w+\s+){0,3}$/i.test(prefix);
+    if (!negated) return true;
+    offset = index + keyword.length;
+  }
+  return false;
+};
+
+const collectKeywordEvidence = (
+  messages: Array<{ text: string; isError?: boolean }>,
+  keywords: string[],
+  includeToolErrors = true,
+): string[] => {
+  const evidence: string[] = [];
+  for (const message of messages) {
+    const lower = message.text.toLowerCase();
+    if (
+      (includeToolErrors && message.isError) ||
+      keywords.some((keyword) => containsNonNegatedKeyword(lower, keyword))
+    ) {
+      evidence.push(truncateRoutingText(message.text, 260));
+    }
+  }
+  return uniqueLimited(evidence);
+};
+
+const collectFilePaths = (text: string): string[] => {
+  const paths = new Set<string>();
+  const pathPattern = /(?:^|[\s`"'(])((?:\.{0,2}\/)?[\w@.-]+(?:\/[\w@.-]+)+\.[A-Za-z0-9_-]+|[\w@.-]+\.(?:ts|tsx|js|jsx|rs|lua|py|go|md|json|toml|yaml|yml|sh|css|html))(?=$|[\s`"'),:;.!?])/g;
+  let match: RegExpExecArray | null;
+  while ((match = pathPattern.exec(text)) && paths.size < TASK_STATE_MAX_EVIDENCE) {
+    paths.add(match[1]);
+  }
+  return [...paths];
+};
